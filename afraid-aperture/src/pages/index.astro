	}

	.contact__decor {
		align-self: flex-end;
		width: 140px;
		height: auto;
		opacity: 0.85;
	}

	.contact__inner {
		width: min(1100px, 100%);
		display: flex;
		flex-direction: column;
		align-items: flex-start;
