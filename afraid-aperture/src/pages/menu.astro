<style>
	/* Menu Modal Styles */
	.menu-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
	}

	.menu-modal.is-open {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.85);
		cursor: pointer;
	}

	.menu-modal__container {
		position: relative;
		width: min(1400px, 95vw);
		max-height: 90vh;
		background: #111;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6);
		display: flex;
		flex-direction: column;
	}

	.menu-modal__close {
		position: absolute;
		top: 20px;
		right: 20px;
		width: 44px;
		height: 44px;
		border: none;
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border-radius: 50%;
		cursor: pointer;
		z-index: 10;
		transition: all 0.2s;
	}

	.menu-modal__close:hover {
		background: rgba(255, 255, 255, 0.2);
		transform: rotate(90deg);
	}

	.menu-modal__close svg {
		width: 24px;
		height: 24px;
	}

	.menu-modal__header {
		padding: 32px 24px 24px;
		background: linear-gradient(135deg, #e1454f, #b3202c);
		color: #fff;
		text-align: center;
	}

	.menu-modal__header h2 {
		margin: 0;
		font-size: 36px;
		font-weight: 700;
	}

	.menu-modal__body {
		flex: 1;
		overflow-y: auto;
		padding: 32px 24px;
		background: #111;
		color: #fff;
	}

	.menu-category {
		margin-bottom: 48px;
	}

	.menu-category__title {
		margin: 0 0 24px;
		font-size: 32px;
		font-weight: 800;
		color: #e1454f;
		text-transform: uppercase;
		letter-spacing: 2px;
	}

	.menu-items {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
	}

	.menu-item {
		display: flex;
		gap: 16px;
		padding: 16px;
		background: rgba(255, 255, 255, 0.05);
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.menu-item__content {
		flex: 1;
	}

	.menu-item__header {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 8px;
	}

	.menu-item__name {
		margin: 0;
		font-size: 16px;
		font-weight: 700;
		text-transform: uppercase;
	}

	.menu-item__price {
		font-size: 18px;
		font-weight: 700;
		color: #e1454f;
		white-space: nowrap;
	}

	.menu-item__description {
		margin: 0;
		font-size: 14px;
		color: #ccc;
		line-height: 1.5;
	}

	@media (max-width: 768px) {
		.menu-modal__container {
			width: 100vw;
			max-height: 100vh;
			border-radius: 0;
		}

		.menu-modal__header h2 {
			font-size: 28px;
		}
	}
</style>

<script>
	function initMenuModal() {
		const modal = document.getElementById('menu-modal-1');
		if (!modal) return;

		modal.querySelectorAll('[data-close-modal]').forEach((btn) => {
			btn.addEventListener('click', () => {
				modal.classList.remove('is-open');
				document.body.style.overflow = '';
			});
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && modal.classList.contains('is-open')) {
				modal.classList.remove('is-open');
				document.body.style.overflow = '';
			}
		});
	}

	(window as any).openMenuModal = function (menuId: number) {
		const modal = document.getElementById(`menu-modal-${menuId}`);
		if (!modal) return;

		modal.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMenuModal);
	} else {
		initMenuModal();
	}
</script>

