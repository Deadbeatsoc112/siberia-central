---
import fullMenuUrl from '../../assets/media/MENUSCOMPLETOS/VASCONCELOS.png?url';
import grupo139BgUrl from '../../assets/media/AMERICAS-menu/Grupo 139.svg?url';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menu | Vasconcelos | La Siberia Central</title>
  </head>

  <body>
    <main class="menu-page">
      <div class="menu-wrap">
        <a id="menu-top" class="menu-top-anchor" aria-hidden="true"></a>
        <a class="back-link" href="/menu-sucursales" aria-label="Volver a menus">
          <span aria-hidden="true">&larr;</span>
          Menus
        </a>

        <img src={fullMenuUrl} alt="Menu completo Vasconcelos" class="menu-image" loading="eager" />
      </div>

      <a class="menu-float-btn" href="#menu-top" aria-label="Volver al inicio del menu">
        <img src={grupo139BgUrl} alt="" aria-hidden="true" />
      </a>
    </main>
  </body>

  <style>
    :global(body) {
      margin: 0;
      background: #111111;
      color: #f5f5f5;
      font-family: 'Campton', 'Segoe UI', Arial, sans-serif;
    }

    .menu-page {
      min-height: 100vh;
      padding: 20px 12px 32px;
      box-sizing: border-box;
      display: flex;
      justify-content: center;
    }

    .menu-wrap {
      width: min(1080px, 100%);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .back-link {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #ffffff;
      font-size: 20px;
      font-weight: 700;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      transition: background-color 0.2s ease;
    }

    .back-link:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .menu-image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 14px;
      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.35);
    }

    .menu-top-anchor {
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .menu-float-btn {
      display: block;
      position: fixed;
      right: max(12px, calc((100vw - 1080px) / 2 + 10px));
      bottom: 18px;
      width: 60px;
      height: 60px;
      z-index: 220;
      cursor: pointer;
      border-radius: 50%;
      overflow: hidden;
      background: transparent;
      box-shadow: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.2s ease;
    }

    .menu-float-btn img {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 50%;
      filter: none;
      box-shadow: none;
    }

    .menu-float-btn:hover {
      transform: translateY(-1px);
    }

    .menu-float-btn:focus-visible {
      outline: 2px solid rgba(255, 255, 255, 0.85);
      outline-offset: 3px;
    }

    @media (max-width: 700px) {
      .menu-float-btn {
        right: 10px;
        bottom: 14px;
        width: 52px;
        height: 52px;
      }

      .menu-page {
        padding: 14px 8px 20px;
      }

      .back-link {
        font-size: 18px;
      }

      .menu-image {
        border-radius: 10px;
      }
    }
  </style>
</html>
