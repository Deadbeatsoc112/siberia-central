              <div class="extras-item">
                <div class="extras-item__name">CHILES</div>
                <div class="extras-item__price">$5.00</div>
                <div class="extras-item__desc">Jalapeño Peppers</div>
              </div>
              <div class="extras-item">
                <div class="extras-item__name">CREMA</div>
                <div class="extras-item__price">$17.00</div>
                <div class="extras-item__desc">Sour cream</div>
              </div>
              <div class="extras-item">
                <div class="extras-item__name">TORTILLA NATURAL</div>
                <div class="extras-item__price">$6.00</div>
