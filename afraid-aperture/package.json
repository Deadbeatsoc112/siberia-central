{
  "name": "afraid-aperture",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:migrate": "wrangler d1 execute siberia_prod --file=migrations/0001_add_menu_categories_and_items.sql",
    "db:rollback": "wrangler d1 execute siberia_prod --file=migrations/0001_add_menu_categories_and_items_rollback.sql",
    "db:backup": "wrangler d1 export siberia_prod --output=backup_$(date +%Y%m%d_%H%M%S).sql",
    "db:console": "wrangler d1 execute siberia_prod --command",
    "db:tables": "wrangler d1 execute siberia_prod --command=\"SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;\""
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@astrojs/node": "^9.5.2",
    "astro": "^5.16.15",
    "leaflet": "^1.9.4",
    "resend": "^6.9.2",
    "wrangler": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250110.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.1.0"
  }
}
