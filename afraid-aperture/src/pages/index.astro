	}

	.hero-followup {
		position: relative;
		top: 0px;
		left: 0px;
		width: 100%;
		height: 816px;
		background-color: transparent;
		background-position: 0% 0%;
		background-repeat: no-repeat;
		opacity: 1;
	}

	.story {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.story__image {
		position: absolute;
		top: 163px;
		right: clamp(24px, 6vw, 120px);
		left: auto;
		width: min(32vw, 498px);
		height: min(32vw, 498px);
		max-width: 498px;
		max-height: 498px;
		box-sizing: border-box;
		--story-image-base-transform: matrix(0.98, -0.17, 0.17, 0.98, 0, 0);
		transform: var(--story-image-base-transform);
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
		border: 10px solid #ffffff;
		box-shadow: 0px 12px 30px rgba(0, 0, 0, 0.35);
		opacity: 1;
		will-change: transform;
	}

	.story__image.is-spin-turn {
		animation: storyImageSpinTurn 1s cubic-bezier(0.22, 0.8, 0.2, 1) both;
	}

	@keyframes storyImageSpinTurn {
		0% {
			transform: var(--story-image-base-transform);
		}
		100% {
			transform: var(--story-image-base-transform) rotate(360deg);
		}
	}

	.story__content {
		position: absolute;
		top: 228px;
		left: 25%;
		right: auto;
		transform: translateX(-50%);
		width: min(520px, 42vw);
		max-width: 520px;
		height: auto;
		padding: 0 24px;
		box-sizing: border-box;
		opacity: 1;
		color: #ffffff;
		text-align: left;
	}

	.story__title {
		margin: 0 0 18px;
		width: 487px;
		text-align: left;
		font: normal normal bold 60px/1.1 Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 0px;
		color: #ffffff;
		opacity: 1;
		white-space: nowrap;
