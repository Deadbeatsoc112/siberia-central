---
interface Props {
	pdfUrl?: string;
	title?: string;
}

const { pdfUrl, title = 'Menú' } = Astro.props;
---

<div class="pdf-viewer">
	{
		pdfUrl ? (
			<iframe class="pdf-viewer__frame" src={pdfUrl} title={title} />
		) : (
			<div class="pdf-viewer__empty">
				<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor">
					<path
						d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
					<polyline points="14 2 14 8 20 8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
					<line x1="9" y1="15" x2="15" y2="15" stroke-width="2" stroke-linecap="round" />
				</svg>
				<p>No hay PDF disponible</p>
			</div>
		)
	}
</div>

<style>
	.pdf-viewer {
		width: 100%;
		height: 600px;
		border-radius: 12px;
		overflow: hidden;
		background: #f5f5f5;
		border: 2px solid #e8e8e8;
	}

	.pdf-viewer__frame {
		width: 100%;
		height: 100%;
		border: none;
	}

	.pdf-viewer__empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		height: 100%;
		color: #999;
		gap: 16px;
	}

	.pdf-viewer__empty svg {
		opacity: 0.5;
	}

	.pdf-viewer__empty p {
		margin: 0;
		font-size: 16px;
	}
</style>
