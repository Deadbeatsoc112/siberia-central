	.timeline {
		position: relative;
		width: 100%;
		min-height: 897px;
		height: auto;
		overflow: hidden;
		color: #ffffff;
		background: #e44654;
	}

	.timeline__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0.95;
		z-index: 0;
	}

	.timeline__decor {
		position: absolute;
		left: auto;
		right: 60px;
		top: auto;
		bottom: 180px;
		width: 560px;
		height: 390px;
		background: transparent 0% 0% no-repeat padding-box;
		background-size: contain;
		opacity: 0.2;
		z-index: 1;
		pointer-events: none;
	}

	.timeline__content {
		position: relative;
		z-index: 3;
		min-height: 897px;
		height: auto;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 24px;
		padding: 120px 0 80px;
		align-items: flex-start;
	}

	.timeline__title {
		margin: 0;
		font: normal normal bold 76px/0.95 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		padding-left: 120px;
		text-transform: none;
	}

	.timeline__title span {
		display: block;
	}

	.timeline__rule {
		display: block;
		width: 520px;
		height: 2px;
		background: rgba(255, 255, 255, 0.85);
		margin-left: 120px;
	}

	.timeline__scroller {
		overflow-x: auto;
		overflow-y: hidden;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		width: 100%;
		cursor: default;
	}

	.timeline__scroller::-webkit-scrollbar {
		display: none;
	}

	.timeline__track {
		position: relative;
		display: flex;
		gap: 90px;
		padding: 40px 120px 0;
		min-width: max-content;
		align-items: flex-start;
		--timeline-shift: 0px;
		--timeline-duration: 40s;
		--axis-y: 22px;
		--gap: 90px;
		--dot-size: 26px;
		--dot-radius: calc(var(--dot-size) / 2);
		--line-height: 6px;
		--line-color: #4d1419;
		transform: translate3d(0, 0, 0);
		will-change: transform;
		backface-visibility: hidden;
		contain: paint;
	}

	.timeline__track.is-auto-pan {
		animation: timeline-pan var(--timeline-duration) linear infinite alternate;
	}

	.timeline__track.is-auto-pan.is-auto-pan-paused {
		animation-play-state: paused;
	}

	@keyframes timeline-pan {
		from {
			transform: translate3d(0, 0, 0);
		}

		to {
			transform: translate3d(calc(-1 * var(--timeline-shift)), 0, 0);
		}
	}

	.timeline__item {
		position: relative;
		min-width: 300px;
		padding-left: 34px;
		padding-top: 10px;
		z-index: 1;
	}

	.timeline__item:not(:last-child)::after {
		content: '';
		position: absolute;
		top: var(--axis-y);
		left: var(--dot-radius);
		width: calc(100% + var(--gap));
		height: var(--line-height);
		background: var(--line-color);
		border-radius: 999px;
		transform: translateY(-50%);
		z-index: 0;
		pointer-events: none;
	}

	.timeline__dot {
		position: absolute;
		top: var(--axis-y);
		left: 0;
		width: var(--dot-size);
		height: var(--dot-size);
		border-radius: 999px;
		background: #c63644;
		transform: translateY(-50%);
		z-index: 2;
	}

	.timeline__dot::before {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 999px;
		border: 4px solid #4d1419;
	}

	.timeline__dot::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 10px;
		height: 10px;
		transform: translate(-50%, -50%);
		border-radius: 999px;
		background: #111;
	}

	.timeline__year {
		display: block;
		margin-top: 26px;
		font-size: 34px;
		opacity: 1;
	}

	.timeline__label {
		display: block;
		margin-top: 6px;
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.3px;
	}

	.timeline__text {
		margin: 8px 0 0;
		font-size: 15px;
		line-height: 24px;
		opacity: 0.95;
		max-width: 300px;
	}

	.timeline__nav {
		position: absolute;
		right: 212px;
		bottom: 98px;
		width: 72px;
		height: 72px;
		border: none;
		background: transparent 0% 0% no-repeat padding-box;
		background-size: contain;
		cursor: pointer;
		z-index: 10;
		opacity: 1;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.timeline__nav:hover,
	.timeline__nav:focus-visible {
		transform: translateX(4px);
	}

	@media (max-width: 1200px) {
		.timeline {
