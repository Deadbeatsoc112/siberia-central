{
	"main": "dist/_worker.js/index.js",
	"name": "afraid-aperture",
  "compatibility_date": "2026-01-28",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
	"r2_buckets": [
		{
			"binding": "UPLOADS_BUCKET",
			"bucket_name": "siberia-uploads"
		}
	]
}