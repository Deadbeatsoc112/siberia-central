---
import Footer from '../components/Footer.astro';

const { title = 'La Siberia Central' } = Astro.props;
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Menu', href: '/menu-sucursales' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Bolsa de trabajo', href: '/bolsa-de-trabajo' },
];
const currentPath = Astro.url?.pathname ?? '/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="site-nav" aria-label="Principal">
				<ul class="site-nav__list">
					{navItems.map((item) => {
						const isMenuRoute = item.href === '/menu-sucursales' && currentPath.startsWith('/carta');
						const isActive =
							item.href === '/'
								? currentPath === '/'
								: currentPath.startsWith(item.href) || isMenuRoute;
						return (
							<li class="site-nav__item">
								<a class={`site-nav__link ${isActive ? 'is-active' : ''}`} href={item.href}>
									{item.label}
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
		</header>
		<main class="page">
			<slot />
		</main>
		<Footer />
		<script is:inline>
			(() => {
				const normalizePath = (path) =>
					path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path;
				const enabledPaths = new Set([
					'/nosotros',
				]);
				const currentRoute = normalizePath(window.location.pathname || '/');

				if (!enabledPaths.has(currentRoute)) return;

				const desktopMedia = window.matchMedia('(min-width: 1024px)');
				const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');
				const wheelIntentThreshold = 95;
				const interactiveSelector = [
					'input',
					'textarea',
					'select',
					'button',
					'summary',
					'a',
					'[contenteditable="true"]',
					'[data-no-section-scroll]',
					'.leaflet-container',
					'.branches__scroll',
					'.timeline__scroller',
				].join(', ');

				let isNavigating = false;
				let releaseTimer;
				let wheelIntent = 0;
				let wheelIntentResetTimer;
				let animationFrameId = 0;

				const getSections = () =>
					Array.from(document.querySelectorAll('main.page > section')).filter((section) => {
						if (!(section instanceof HTMLElement)) return false;
						if (section.hidden) return false;
						return section.offsetHeight > 0;
					});

				const sectionsNow = getSections();
				if (sectionsNow.length < 2) return;

				const isInteractiveTarget = (target) => {
					if (!(target instanceof Element)) return false;
					return Boolean(target.closest(interactiveSelector));
				};

				const getCurrentSectionIndex = (sections) => {
					const viewportCenter = window.scrollY + window.innerHeight / 2;
					let closestIndex = 0;
					let closestDistance = Number.POSITIVE_INFINITY;

					sections.forEach((section, index) => {
						const sectionCenter = section.offsetTop + section.offsetHeight / 2;
						const distance = Math.abs(sectionCenter - viewportCenter);
						if (distance < closestDistance) {
							closestDistance = distance;
							closestIndex = index;
						}
					});

					return closestIndex;
				};

				const easeInOutCubic = (t) => {
					if (t < 0.5) return 4 * t * t * t;
					return 1 - Math.pow(-2 * t + 2, 3) / 2;
				};

				const clearNavigationTimers = () => {
					window.clearTimeout(releaseTimer);
					window.clearTimeout(wheelIntentResetTimer);
				};

				const smoothScrollTo = (targetY) => {
					if (reducedMotionMedia.matches) {
						window.scrollTo(0, targetY);
						return;
					}

					const startY = window.scrollY;
					const distance = targetY - startY;
					if (Math.abs(distance) < 1) return;

					const duration = Math.min(1050, Math.max(620, Math.abs(distance) * 0.42));
					let startTime = 0;

					if (animationFrameId) {
						cancelAnimationFrame(animationFrameId);
						animationFrameId = 0;
					}

					const step = (now) => {
						if (!startTime) startTime = now;
						const elapsed = now - startTime;
						const progress = Math.min(1, elapsed / duration);
						const eased = easeInOutCubic(progress);
						window.scrollTo(0, startY + distance * eased);

						if (progress < 1) {
							animationFrameId = requestAnimationFrame(step);
							return;
						}

						animationFrameId = 0;
						isNavigating = false;
					};

					isNavigating = true;
					animationFrameId = requestAnimationFrame(step);

					window.clearTimeout(releaseTimer);
					releaseTimer = window.setTimeout(() => {
						if (animationFrameId) {
							cancelAnimationFrame(animationFrameId);
							animationFrameId = 0;
						}
						isNavigating = false;
					}, duration + 220);
				};

				const moveToSection = (direction) => {
					const sections = getSections();
					if (sections.length < 2) return false;

					const currentIndex = getCurrentSectionIndex(sections);
					const nextIndex = currentIndex + direction;

					if (nextIndex < 0 || nextIndex >= sections.length) return false;

					const targetSection = sections[nextIndex];
					smoothScrollTo(targetSection.offsetTop);
					return true;
				};

				const onWheel = (event) => {
					if (!desktopMedia.matches) return;
					if (isInteractiveTarget(event.target)) return;
					event.preventDefault();

					if (isNavigating) return;

					const clampedDelta = Math.sign(event.deltaY) * Math.min(140, Math.abs(event.deltaY));
					wheelIntent += clampedDelta;
					window.clearTimeout(wheelIntentResetTimer);
					wheelIntentResetTimer = window.setTimeout(() => {
						wheelIntent = 0;
					}, 140);

					if (Math.abs(wheelIntent) < wheelIntentThreshold) return;

					const direction = wheelIntent > 0 ? 1 : -1;
					wheelIntent = 0;
					const moved = moveToSection(direction);
					if (!moved) {
						isNavigating = false;
					}
				};

				const onKeydown = (event) => {
					if (!desktopMedia.matches) return;
					if (event.defaultPrevented) return;
					if (isInteractiveTarget(event.target)) return;

					const downKeys = new Set(['ArrowDown', 'PageDown']);
					const upKeys = new Set(['ArrowUp', 'PageUp']);
					const isSpace = event.key === ' ';
					let direction = 0;

					if (downKeys.has(event.key)) direction = 1;
					if (upKeys.has(event.key)) direction = -1;
					if (isSpace) direction = event.shiftKey ? -1 : 1;
					if (!direction) return;
					if (isNavigating) {
						event.preventDefault();
						return;
					}

					const moved = moveToSection(direction);
					if (!moved) return;

					event.preventDefault();
				};

				window.addEventListener('wheel', onWheel, { passive: false });
				window.addEventListener('keydown', onKeydown);
				window.addEventListener('beforeunload', clearNavigationTimers);
			})();
		</script>
	</body>
</html>

<style>
	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonThin.otf") format("opentype");
