---
import AdminCard from './AdminCard.astro';
import AdminBadge from './AdminBadge.astro';
import AdminButton from './AdminButton.astro';
import AdminModal from './AdminModal.astro';

interface Props {
	messages: any[];
	branches: any[];
}

const { messages, branches } = Astro.props;

const branchesById = new Map<number, string>(
	(branches || [])
		.filter((branch) => branch?.id && branch?.contact_email)
		.map((branch) => [Number(branch.id), String(branch.contact_email)]),
);

// Sort messages by date (most recent first)
const sortedMessages = [...messages].sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime());
---

<div class="messages-tab">
	<AdminCard
		title="Mensajes de Contacto"
		subtitle={`${messages.length} mensaje${messages.length !== 1 ? 's' : ''} recibido${messages.length !== 1 ? 's' : ''}`}
		variant="glass"
		fullHeight
	>
		{
			sortedMessages.length === 0 ? (
				<div class="messages-empty">
					<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor">
						<path
							d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
					<p>No hay mensajes de contacto</p>
				</div>
			) : (
				<div class="messages-list">
					{sortedMessages.map((msg) => (
						<details class="message-item" data-message-id={msg.id}>
							<summary class="message-item__summary">
								<div class="message-item__header">
									<div class="message-item__info">
										<h4 class="message-item__name">{msg.full_name}</h4>
										<p class="message-item__email">{msg.email}</p>
										{msg.branch_name && (
											<span class="message-item__branch">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
													<path d="M3 10.5L12 3l9 7.5" stroke-linecap="round" stroke-linejoin="round" />
													<path d="M5 9.5V21h14V9.5" stroke-linecap="round" stroke-linejoin="round" />
												</svg>
												{msg.branch_name}
											</span>
										)}
									</div>
									<div class="message-item__meta">
										<AdminBadge
											variant={
												msg.status === 'unread' ? 'warning' :
												msg.status === 'read' ? 'info' :
												msg.status === 'responded' ? 'success' :
												'secondary'
											}
											size="small"
										>
											{msg.status}
										</AdminBadge>
										<span class="message-item__date">
											{new Date(msg.created_at).toLocaleDateString('es-MX')}
										</span>
									</div>
								</div>
								<svg class="message-item__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<polyline points="6 9 12 15 18 9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>

							<div class="message-item__body">
								<div class="message-item__content">
									<div class="message-item__section">
										<h5>Mensaje:</h5>
										<p class="message-item__text">{msg.message}</p>
									</div>

									{msg.phone && (
										<div class="message-item__section">
											<h5>Teléfono:</h5>
											<p>{msg.phone}</p>
										</div>
									)}

									{msg.image_path && (
										<div class="message-item__section">
											<h5>Imagen adjunta:</h5>
											<a href={`/api/media/${msg.image_path}`} target="_blank" rel="noopener noreferrer">
												<img
													src={`/api/media/${msg.image_path}`}
													alt="Imagen adjunta del mensaje"
													class="message-item__image"
												/>
											</a>
										</div>
									)}

									{msg.notes && (
										<div class="message-item__section">
											<h5>Notas internas:</h5>
											<p class="message-item__notes">{msg.notes}</p>
										</div>
									)}

									<div class="message-item__actions-grid">
										<!-- Update Status Form -->
										<form action="/api/admin/messages/update-status" method="post" class="message-item__form">
											<input type="hidden" name="id" value={msg.id} />
											<div class="form-group">
												<label>Cambiar estado:</label>
												<select name="status" class="form-select">
													<option value="unread" selected={msg.status === 'unread'}>Unread</option>
													<option value="read" selected={msg.status === 'read'}>Read</option>
													<option value="responded" selected={msg.status === 'responded'}>Responded</option>
													<option value="closed" selected={msg.status === 'closed'}>Closed</option>
												</select>
											</div>
											<AdminButton type="submit" variant="primary" size="small">
												Guardar Estado
											</AdminButton>
										</form>

										<!-- Add Note Form -->
										<form action="/api/admin/messages/add-note" method="post" class="message-item__form">
											<input type="hidden" name="id" value={msg.id} />
											<div class="form-group">
												<label>Añadir nota:</label>
												<textarea name="notes" class="form-textarea" rows={3} placeholder="Nota interna..."></textarea>
											</div>
											<AdminButton type="submit" variant="success" size="small">
												Añadir Nota
											</AdminButton>
										</form>
									</div>

									<!-- Delete Form -->
									<form action="/api/admin/messages/delete" method="post" class="message-item__delete-form">
										<input type="hidden" name="id" value={msg.id} />
										<AdminButton
											type="submit"
											variant="danger"
											size="small"
											fullWidth
										>
											Eliminar Mensaje
										</AdminButton>
									</form>

									<button type="button" class="forward-btn" onclick={`openModal('forward-${msg.id}')`}>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
											<path d="M4 5h16v14H4z" stroke-linecap="round" stroke-linejoin="round" />
											<path d="M4 7l8 6 8-6" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										Reenviar al correo
									</button>
								</div>
							</div>
						</details>
					))}
				</div>
			)
		}
	</AdminCard>

	{
		sortedMessages.map((msg) => {
			const fallbackEmail = msg.branch_id ? branchesById.get(Number(msg.branch_id)) : '';
			const defaultToEmail = msg.branch_contact_email || fallbackEmail || '';

			return (
				<AdminModal id={`forward-${msg.id}`} title="Reenviar Mensaje" size="medium">
					<div class="forward-modal">
						<div class="forward-modal__summary">
							<p><strong>De:</strong> {msg.full_name} ({msg.email})</p>
							{msg.branch_name && <p><strong>Sucursal:</strong> {msg.branch_name}</p>}
							<blockquote>
								{msg.message.length > 200 ? `${msg.message.substring(0, 200)}...` : msg.message}
							</blockquote>
						</div>

						<form class="forward-modal__form" data-forward-form data-msg-id={msg.id}>
							<input type="hidden" name="message_id" value={msg.id} />
							<div class="form-group">
								<label>Correo destino:</label>
								<input
									type="email"
									name="to_email"
									class="form-select"
									value={defaultToEmail}
									required
									placeholder="correo@ejemplo.com"
								/>
							</div>
							<div class="forward-modal__actions">
								<button type="button" class="forward-modal__cancel" onclick={`closeModal('forward-${msg.id}')`}>
									Cancelar
								</button>
								<button type="submit" class="forward-modal__submit">Enviar</button>
							</div>
						</form>

						<div data-forward-status={msg.id} style="display:none;"></div>
					</div>
				</AdminModal>
			);
		})
	}
</div>

<style>
	.messages-tab {
		animation: fadeIn 0.5s ease-out;
	}

	/* Messages Empty */
	.messages-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 60px 20px;
		color: #999;
		text-align: center;
	}

	.messages-empty svg {
		margin-bottom: 16px;
		opacity: 0.5;
	}

	.messages-empty p {
		margin: 0;
		font-size: 16px;
	}

	/* Messages List */
	.messages-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.message-item {
		background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
		border: 2px solid #f0f0f0;
		border-radius: 12px;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.message-item:hover {
		border-color: #d4534f;
		box-shadow: 0 8px 24px rgba(212, 83, 79, 0.15);
	}

	.message-item[open] {
		border-color: #d4534f;
	}

	.message-item__summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.message-item__summary::-webkit-details-marker {
		display: none;
	}

	.message-item__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		flex: 1;
	}

	.message-item__info {
		flex: 1;
		min-width: 0;
	}

	.message-item__name {
		margin: 0 0 4px;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 20px;
		font-weight: 700;
		color: #1a1a1a;
	}

	.message-item__email {
		margin: 0;
		font-size: 14px;
		color: #666;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.message-item__branch {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-top: 8px;
		padding: 4px 10px;
		border-radius: 999px;
		background: #f5ede5;
		color: #8b5a2b;
		font-size: 12px;
		font-weight: 700;
	}

	.message-item__branch svg {
		width: 14px;
		height: 14px;
	}

	.message-item__meta {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-shrink: 0;
	}

	.message-item__date {
		font-size: 13px;
		color: #999;
		font-weight: 600;
		white-space: nowrap;
	}

	.message-item__chevron {
		flex-shrink: 0;
		margin-left: 12px;
		color: #d4534f;
		transition: transform 0.3s ease;
	}

	.message-item[open] .message-item__chevron {
		transform: rotate(180deg);
	}

	.message-item__body {
		border-top: 1px solid #f0f0f0;
		padding: 20px;
		animation: expandDown 0.3s ease-out;
	}

	.message-item__content {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.message-item__section h5 {
		margin: 0 0 8px;
		font-size: 13px;
		font-weight: 700;
		color: #666;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.message-item__section p {
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: #2a2a2a;
	}

	.message-item__text {
		padding: 16px;
		background: #f8f8f8;
		border-left: 4px solid #d4534f;
		border-radius: 8px;
	}

	.message-item__notes {
		padding: 12px;
		background: #fff8e6;
		border-left: 4px solid #f59e0b;
		border-radius: 8px;
		font-style: italic;
	}

	.message-item__image {
		display: block;
		max-width: 100%;
		max-height: 320px;
		border-radius: 8px;
		border: 2px solid #f0f0f0;
		object-fit: contain;
		transition: border-color 0.2s ease;
	}

	.message-item__image:hover {
		border-color: #d4534f;
	}

	.message-item__actions-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		margin-top: 8px;
	}

	.message-item__form {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding: 16px;
		background: #f8f8f8;
		border-radius: 10px;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.form-group label {
		font-size: 13px;
		font-weight: 600;
		color: #555;
	}

	.form-select,
	.form-textarea {
		padding: 10px 12px;
		border: 2px solid #e8e8e8;
		border-radius: 8px;
		font-size: 14px;
		font-family: inherit;
		transition: all 0.2s ease;
	}

	.form-select:focus,
	.form-textarea:focus {
		outline: none;
		border-color: #d4534f;
		box-shadow: 0 0 0 3px rgba(212, 83, 79, 0.1);
	}

	.form-textarea {
		resize: vertical;
		min-height: 80px;
	}

	.message-item__delete-form {
		margin-top: 8px;
	}

	.forward-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		margin-top: 12px;
		padding: 10px 14px;
		border: 1px solid #8b5a2b;
		border-radius: 8px;
		background: #8b5a2b;
		color: #fff;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.forward-btn:hover {
		background: #74461e;
		border-color: #74461e;
	}

	.forward-btn svg {
		width: 16px;
		height: 16px;
	}

	.forward-modal {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.forward-modal__summary {
		padding: 14px;
		background: #f8f8f8;
		border-radius: 10px;
	}

	.forward-modal__summary p {
		margin: 0 0 8px;
		font-size: 14px;
		color: #333;
	}

	.forward-modal__summary p:last-child {
		margin-bottom: 0;
	}

	.forward-modal__summary blockquote {
		margin: 10px 0 0;
		padding: 10px 12px;
		background: #fff;
		border-left: 4px solid #d4534f;
		border-radius: 8px;
		color: #444;
		font-size: 14px;
	}

	.forward-modal__form {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.forward-modal__actions {
		display: flex;
		justify-content: flex-end;
		gap: 10px;
	}

	.forward-modal__cancel,
	.forward-modal__submit {
		border: none;
		border-radius: 8px;
		padding: 10px 14px;
		font-size: 14px;
		font-weight: 700;
		cursor: pointer;
	}

	.forward-modal__cancel {
		background: #efefef;
		color: #555;
	}

	.forward-modal__submit {
		background: #d4534f;
		color: #fff;
	}

	.forward-modal__status--success,
	.forward-modal__status--error {
		margin-top: 4px;
		padding: 10px 12px;
		border-radius: 8px;
		font-size: 13px;
		font-weight: 600;
	}

	.forward-modal__status--success {
		background: #dcfce7;
		color: #166534;
	}

	.forward-modal__status--error {
		background: #fee2e2;
		color: #991b1b;
	}

	@keyframes expandDown {
		from {
			opacity: 0;
			transform: translateY(-10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 768px) {
		.message-item__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}

		.message-item__meta {
			width: 100%;
			justify-content: space-between;
		}

		.message-item__actions-grid {
			grid-template-columns: 1fr;
		}

		.forward-modal__actions {
			flex-direction: column;
		}

		.forward-modal__cancel,
		.forward-modal__submit {
			width: 100%;
		}
	}
</style>

<script>
	document.querySelectorAll('[data-forward-form]').forEach((form) => {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const targetForm = e.target as HTMLFormElement;
			const formData = new FormData(targetForm);
			const messageId = Number(formData.get('message_id'));
			const statusEl = document.querySelector(`[data-forward-status="${messageId}"]`) as HTMLElement | null;
			const submitBtn = targetForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;

			if (submitBtn) {
				submitBtn.disabled = true;
				submitBtn.textContent = 'Enviando...';
			}

			if (statusEl) {
				statusEl.style.display = 'none';
				statusEl.className = '';
				statusEl.textContent = '';
			}

			try {
				const res = await fetch('/api/admin/messages/forward', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						message_id: messageId,
						to_email: String(formData.get('to_email') || ''),
					}),
				});

				const payload = await res.json().catch(() => ({}));
				if (!res.ok) {
					throw new Error(payload?.error || 'No se pudo reenviar el mensaje');
				}

				if (statusEl) {
					statusEl.style.display = 'block';
					statusEl.className = 'forward-modal__status--success';
					statusEl.textContent = 'Mensaje reenviado correctamente.';
				}
			} catch (err) {
				if (statusEl) {
					statusEl.style.display = 'block';
					statusEl.className = 'forward-modal__status--error';
					statusEl.textContent = err instanceof Error ? err.message : 'Error al reenviar el mensaje';
				}
			} finally {
				if (submitBtn) {
					submitBtn.disabled = false;
					submitBtn.textContent = 'Enviar';
				}
			}
		});
	});

	// Auto-mark as read when opened
	document.querySelectorAll('.message-item').forEach((details) => {
		details.addEventListener('toggle', async (e) => {
			const target = e.target as HTMLDetailsElement;
			if (target.open) {
				const messageId = target.getAttribute('data-message-id');
				const badge = target.querySelector('[data-badge]');

				// Optional: Auto-update status to 'read' when opened
				// Uncomment if you want this behavior
				/*
				if (badge?.textContent?.trim() === 'unread') {
					try {
						const formData = new FormData();
						formData.append('id', messageId || '');
						formData.append('status', 'read');
						await fetch('/api/admin/messages/update-status', {
							method: 'POST',
							body: formData
						});
					} catch (err) {
						console.error('Error updating status:', err);
					}
				}
				*/
			}
		});
	});
</script>
