---
import fullMenuUrl from '../../assets/media/MENUSCOMPLETOS/CONTRY.png?url';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menu | Contry | La Siberia Central</title>
  </head>

  <body>
    <main class="menu-page">
      <div class="menu-wrap">
        <a class="back-link" href="/menu-sucursales" aria-label="Volver a menus">
          <span aria-hidden="true">&larr;</span>
          Menus
        </a>

        <img src={fullMenuUrl} alt="Menu completo Contry" class="menu-image" loading="eager" />
      </div>
    </main>
  </body>

  <style>
    :global(body) {
      margin: 0;
      background: #111111;
      color: #f5f5f5;
      font-family: 'Campton', 'Segoe UI', Arial, sans-serif;
    }

    .menu-page {
      min-height: 100vh;
      padding: 20px 12px 32px;
      box-sizing: border-box;
      display: flex;
      justify-content: center;
    }

    .menu-wrap {
      width: min(1080px, 100%);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .back-link {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #ffffff;
      font-size: 20px;
      font-weight: 700;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      transition: background-color 0.2s ease;
    }

    .back-link:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .menu-image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 14px;
      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.35);
    }

    @media (max-width: 700px) {
      .menu-page {
        padding: 14px 8px 20px;
      }

      .back-link {
        font-size: 18px;
      }

      .menu-image {
        border-radius: 10px;
      }
    }
  </style>
</html>
