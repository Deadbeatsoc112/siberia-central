---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';
import expHeroUrl from '../../assets/fondos/Blog.png?url';
import { postsRepo } from '../../lib/content';

const db = getDB(Astro.locals);
const expHero2xUrl = expHeroUrl;

const posts = (await postsRepo.listAll(db)).filter((post) => post.published === 1);
---

<Layout title="Experiencias | La S central">
	<section class="exp-hero" aria-labelledby="exp-title">
		<div
			class="exp-hero__bg"
			style={`background-image: image-set(url("${expHeroUrl}") 1x, url("${expHero2xUrl}") 2x);`}
			aria-hidden="true"
		></div>
		<div class="exp-hero__overlay" aria-hidden="true"></div>
		<div class="exp-hero__content">
			<h1 id="exp-title" class="exp-hero__title">Experiencias</h1>
			<p class="exp-hero__subtitle">Historias, eventos y momentos de La S central</p>
		</div>
	</section>
	<section class="exp-list" aria-labelledby="exp-list-title">
		<div class="exp-list__inner">
			<h2 id="exp-list-title" class="sr-only">Experiencias</h2>
			{posts.length === 0 ? (
				<p class="exp-list__empty">Aún no hay experiencias publicadas. Vuelve pronto.</p>
			) : (
				<div class="mosaic">
					{posts.map((post, index) => {
						const pattern = index % 6;
						const sizeClass =
							pattern === 0 ? 'mosaic__tile--xl'
							: pattern === 1 ? 'mosaic__tile--md'
							: pattern === 2 ? 'mosaic__tile--tall'
							: pattern === 3 ? 'mosaic__tile--md'
							: pattern === 4 ? 'mosaic__tile--wide'
							: 'mosaic__tile--md';
						return (
							<a class={`mosaic__tile ${sizeClass}`} href={`/experiencias/${post.slug}`}>
								<img
									class="mosaic__image"
									src={post.image_url ?? expHeroUrl}
									alt={post.title}
									loading="lazy"
								/>
								<div class="mosaic__overlay" aria-hidden="true"></div>
								<div class="mosaic__body">
									<h3 class="mosaic__title">{post.title}</h3>
									{post.excerpt && <p class="mosaic__excerpt">{post.excerpt}</p>}
								</div>
							</a>
						);
					})}
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.exp-hero {
		position: relative;
		width: 100%;
		height: 640px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #ffffff;
	}

	.exp-hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		transform: scale(1.02);
		filter: brightness(1.7) saturate(1.3);
	}

	.exp-hero__overlay {
		position: absolute;
		inset: 0;
		background: none;
	}

	.exp-hero__content {
		position: relative;
		z-index: 2;
		max-width: 820px;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.exp-hero__title {
		margin: 0;
		font-size: clamp(42px, 6vw, 72px);
		font-weight: 900;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
	}

	.exp-hero__subtitle {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		text-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
	}

	.exp-list {
		background: #ffffff;
		padding: 80px 0 140px;
		display: flex;
		justify-content: center;
	}

	.exp-list__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		box-sizing: border-box;
	}

	.exp-list__empty {
		margin: 0;
		text-align: center;
		font-size: 18px;
		color: #6a6a6a;
	}

	.mosaic {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		grid-auto-rows: 220px;
		gap: 14px;
	}

	.mosaic__tile {
		position: relative;
		overflow: hidden;
		text-decoration: none;
		color: #ffffff;
		display: block;
	}

	.mosaic__tile--md { grid-column: span 1; grid-row: span 1; }
	.mosaic__tile--wide { grid-column: span 2; grid-row: span 1; }
	.mosaic__tile--tall { grid-column: span 1; grid-row: span 2; }
	.mosaic__tile--xl { grid-column: span 2; grid-row: span 2; }

	.mosaic__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.mosaic__tile:hover .mosaic__image {
		transform: scale(1.05);
	}

	.mosaic__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(to top, rgba(0,0,0,0.82) 0%, rgba(0,0,0,0.25) 55%, rgba(0,0,0,0) 100%);
		transition: background 0.3s ease;
	}

	.mosaic__tile:hover .mosaic__overlay {
		background: linear-gradient(to top, rgba(225,69,79,0.85) 0%, rgba(225,69,79,0.35) 55%, rgba(0,0,0,0) 100%);
	}

	.mosaic__body {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 20px 22px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.mosaic__title {
		margin: 0;
		font-size: 22px;
		font-weight: 900;
		line-height: 1.15;
	}

	.mosaic__tile--xl .mosaic__title {
		font-size: 30px;
	}

	.mosaic__excerpt {
		margin: 0;
		font-size: 14px;
		line-height: 1.35;
		opacity: 0.92;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 1100px) {
		.mosaic {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			grid-auto-rows: 200px;
		}
		.mosaic__tile--xl { grid-column: span 2; }
	}

	@media (max-width: 720px) {
		.mosaic {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: 180px;
		}
		.mosaic__tile--xl,
		.mosaic__tile--wide {
			grid-column: span 2;
		}
		.mosaic__tile--tall {
			grid-column: span 1;
			grid-row: span 2;
		}
	}
</style>
