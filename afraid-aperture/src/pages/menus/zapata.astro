      }

      .page {
        min-height: 100vh;
        padding: 24px var(--side-pad);
        display: flex;
        justify-content: center;
        overflow-x: hidden;
      }

      /* Frame aplica el escalado al canvas */
      .frame {
        transform: scale(var(--scale));
        transform-origin: top center;
        will-change: transform;
        height: calc(var(--canvas-h) * var(--scale));
      }

      /* Canvas fijo pixel-perfect */
      .canvas {
        position: relative;
        width: var(--canvas-w);
        height: var(--canvas-h);
        overflow: hidden;
        background-image: var(--menu-bg, none);
        background-repeat: no-repeat;
        background-position: top center;
        background-size: 100% 100%;
      }

      .canvas::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.08;
        background-image: url('/img/noise.png');
        background-repeat: repeat;
        mix-blend-mode: overlay;
      }

      /* Helper base para elementos absolutos */
      .abs {
        position: absolute;
        top: var(--y, auto);
        left: var(--x, auto);
        width: var(--w, auto);
        height: var(--h, auto);
      }

