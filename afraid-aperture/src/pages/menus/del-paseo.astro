                <div class="caldo-item__name">CONSOME DE PECHUGA</div>
                <div class="caldo-item__price">$ 93.00</div>
                <div class="caldo-item__sub">HEN BREAST BROTH</div>
                <p class="caldo-item__text">Consomé de gallina grande con pechuga y arroz.</p>
                <p class="caldo-item__text">Hen broth served with rice, hen breast and tortilla as side.</p>
              </div>
              <div class="caldo-item">
                <div class="caldo-item__name">CONSOME DE PIERNA</div>
                <div class="caldo-item__price">$ 93.00</div>
                <div class="caldo-item__sub">HEN LEG BROTH</div>
