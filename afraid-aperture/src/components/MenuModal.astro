---
import heroBgUrl from '../assets/media/Enmascarar grupo 20.png?url';
import heroBg2xUrl from '../assets/media/Enmascarar grupo 20@2x.png?url';
import heroPatternUrl from '../assets/media/Grupo 140.svg?url';
import logoUrl from '../assets/media/Enmascarar grupo 4.png?url';
import logo2xUrl from '../assets/media/Enmascarar grupo 4@2x.png?url';
import infoBgUrl from '../assets/media/Enmascarar grupo 6.png?url';
import infoBg2xUrl from '../assets/media/Enmascarar grupo 6@2x.png?url';
import zigzagUrl from '../assets/media/Grupo 36.svg?url';
import tostadaUrl from '../assets/media/Grupo 31.png?url';
import tostada2xUrl from '../assets/media/Grupo 31@2x.png?url';
import tacoUrl from '../assets/media/Grupo 34.png?url';
import taco2xUrl from '../assets/media/Grupo 34@2x.png?url';
import caldoUrl from '../assets/media/Grupo 33.png?url';
import caldo2xUrl from '../assets/media/Grupo 33@2x.png?url';
import comboUrl from '../assets/media/Grupo 27.png?url';
import combo2xUrl from '../assets/media/Grupo 27@2x.png?url';
import menuBg568Url from '../assets/media/Grupo 568.png?url';
import menuBg5682xUrl from '../assets/media/Grupo 568@2x.png?url';
import menuDecor472Url from '../assets/media/Grupo 472.png?url';
import menuDecor4722xUrl from '../assets/media/Grupo 472@2x.png?url';

interface MenuItemData {
	name: string;
	description?: string | null;
	price: number;
	image_url?: string | null;
}

interface MenuCategoryData {
	name: string;
	image_url?: string | null;
	items: MenuItemData[];
}

interface MenuData {
	name: string;
	categories: MenuCategoryData[];
}

interface BranchData {
	name: string;
	address: string;
	phones: string[];
}

interface Props {
	menuId: number;
	branchName: string;
	branchSlug: string;
	menu?: MenuData;
	branch?: BranchData;
}

const { menuId, branchName, branchSlug, menu, branch } = Astro.props as Props;

const heroLabels = [
	{ text: 'BEBIDAS', className: 'bebidas' },
	{ text: 'TACOS', className: 'tacos' },
	{ text: 'COMBOS', className: 'combos' },
	{ text: 'CALDOS', className: 'caldos' },
	{ text: 'TOSTADAS', className: 'tostadas' },
];

const branchInfo = {
	title: branch?.name ?? 'LA SIBERIA CENTRAL',
	location: branchName || branch?.name || 'CENTRAL',
	addressLines: branch?.address ? [branch.address] : ['Av. Rodrigo Gomez 623, Col. Central, Monterrey', 'Nuevo Leon CP 64190'],
	phones: branch?.phones ?? ['8112573064'],
};

const menuCategories = menu?.categories ?? [];

const fallbackImages = [
	{ src: tostadaUrl, src2x: tostada2xUrl, alt: 'Tostadas' },
	{ src: tacoUrl, src2x: taco2xUrl, alt: 'Tacos' },
	{ src: caldoUrl, src2x: caldo2xUrl, alt: 'Caldos' },
	{ src: comboUrl, src2x: combo2xUrl, alt: 'Combos' },
];

const resolveCategoryImage = (index: number, category: MenuCategoryData) => {
	if (category.image_url) {
		return { src: category.image_url, src2x: null, alt: category.name };
	}
	const fallback = fallbackImages[index % fallbackImages.length];
	return { src: fallback.src, src2x: fallback.src2x, alt: fallback.alt };
};
---

<div class="menu-modal" id={`menu-modal-${menuId}`} data-menu-id={menuId} data-branch-slug={branchSlug}>
	<div class="menu-modal__overlay" data-close-modal></div>
	<div class="menu-modal__container">
		<button class="menu-modal__close" data-close-modal aria-label="Cerrar">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6L6 18M6 6l12 12"/>
			</svg>
		</button>

		<div class="menu-modal__body" aria-label={`Menú ${branchName}`}>
			<section id={`menu-top-${menuId}`} class="central-hero">
				<div
					class="central-hero__bg"
					style={`background-image: image-set(url(${heroBgUrl}) 1x, url(${heroBg2xUrl}) 2x);`}
					aria-hidden="true"
				></div>
				<div class="central-hero__overlay" aria-hidden="true"></div>
				<div
					class="central-hero__pattern"
					style={`background-image: url(${heroPatternUrl});`}
					aria-hidden="true"
				></div>

				<div class="central-hero__content">
					<div class="central-hero__logo">
						<span class="central-hero__since">DESDE 1978</span>
						<img
							src={logoUrl}
							srcset={`${logoUrl} 1x, ${logo2xUrl} 2x`}
							alt="La Siberia Central"
						/>
						<span class="central-hero__brand">LA SIBERIA CENTRAL</span>
					</div>

					<div class="central-hero__labels" aria-hidden="true">
						{heroLabels.map((label) => (
							<span class={`central-hero__label central-hero__label--${label.className}`}>
								{label.text}
							</span>
						))}
					</div>
				</div>
			</section>

			<section class="central-info" aria-labelledby={`menu-title-${menuId}`}>
				<div
					class="central-info__bg"
					style={`background-image: image-set(url(${infoBgUrl}) 1x, url(${infoBg2xUrl}) 2x);`}
					aria-hidden="true"
				></div>
				<img class="central-info__zigzag" src={zigzagUrl} alt="" aria-hidden="true" />

				<div class="central-info__content">
					<span id={`menu-title-${menuId}`} class="central-info__eyebrow">Menu</span>
					<h1 class="central-info__title">{branchInfo.title}</h1>
					<h2 class="central-info__location">{branchInfo.location}</h2>
					<div class="central-info__address">
						{branchInfo.addressLines.map((line) => (
							<p>{line}</p>
						))}
					</div>
					<div class="central-info__phones">
						{branchInfo.phones.map((phone) => (
							<span class="central-info__phone">
								<svg viewBox="0 0 24 24" aria-hidden="true">
									<path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
								</svg>
								{phone}
							</span>
						))}
					</div>
				</div>

				<a class="central-info__scroll" href={`#menu-top-${menuId}`} aria-label="Volver arriba">
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d="M12 6l-7 7h4v5h6v-5h4z" />
					</svg>
				</a>
			</section>

			<section class="central-category" aria-labelledby={`menu-title-${menuId}`}>
				<div
					class="central-menu__decor central-menu__decor--568"
					style={`background-image: image-set(url(${menuBg568Url}) 1x, url(${menuBg5682xUrl}) 2x);`}
					aria-hidden="true"
				></div>
				<div
					class="central-menu__decor central-menu__decor--472"
					style={`background-image: image-set(url(${menuDecor472Url}) 1x, url(${menuDecor4722xUrl}) 2x);`}
					aria-hidden="true"
				></div>
				<div class="central-category__wrap">
					{menuCategories.length === 0 ? (
						<p class="central-menu__empty">Aún no hay categorías para este menú.</p>
					) : (
						menuCategories.map((category, index) => {
							const image = resolveCategoryImage(index, category);
							return (
								<div class="central-category__block">
									<div class="central-category__inner">
										<figure class="central-category__image">
											<img
												src={image.src}
												srcset={image.src2x ? `${image.src} 1x, ${image.src2x} 2x` : undefined}
												alt={image.alt}
												loading="lazy"
											/>
										</figure>
										<div class="central-category__content">
											<span class="central-category__script">{menu?.name ?? 'Menú'}</span>
											<span class="central-menu__line" aria-hidden="true"></span>
											<h2 id={`tostadas-title-${menuId}-${index}`} class="central-category__title">
												{category.name}
											</h2>
										</div>
									</div>

									<div class="central-menu">
										<div class="central-menu__grid central-menu__grid--single">
											{category.items?.length ? (
												<ul class="central-menu__list">
													{category.items.map((item) => (
														<li class="central-menu__item">
															<div class="central-menu__item-text">
																<span class="central-menu__item-name">{item.name}</span>
																{item.description && (
																	<span class="central-menu__item-note">{item.description}</span>
																)}
															</div>
															<span class="central-menu__item-price">${item.price.toFixed(2)}</span>
														</li>
													))}
												</ul>
											) : (
												<p class="central-menu__empty">No hay productos en esta categoría.</p>
											)}
										</div>
									</div>
								</div>
							);
						})
					)}
				</div>
			</section>
		</div>
		</div>
	</div>
</div>

<style>
	.menu-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
	}

	.menu-modal.is-open {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.92);
		cursor: pointer;
		backdrop-filter: blur(4px);
	}

	.menu-modal__container {
		position: relative;
		width: min(1489px, 98vw);
		max-height: 95vh;
		background: #111111;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
		display: flex;
		flex-direction: column;
	}

	.menu-modal__close {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 52px;
		height: 52px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		background: rgba(0, 0, 0, 0.6);
		color: #fff;
		border-radius: 50%;
		cursor: pointer;
		z-index: 10;
		transition: all 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__close:hover {
		background: #e1454f;
		border-color: #e1454f;
		transform: rotate(90deg) scale(1.1);
	}

	.menu-modal__close svg {
		width: 28px;
		height: 28px;
	}

	.menu-modal__body {
		width: 100%;
		height: 100%;
		overflow-y: auto;
		background: #111111;
		scroll-behavior: smooth;
	}

	.menu-modal__body::-webkit-scrollbar {
		width: 10px;
	}

	.menu-modal__body::-webkit-scrollbar-track {
		background: rgba(0, 0, 0, 0.35);
	}

	.menu-modal__body::-webkit-scrollbar-thumb {
		background: rgba(225, 69, 79, 0.6);
		border-radius: 10px;
	}

	@media (max-width: 900px) {
		.menu-modal__container {
			width: 100vw;
			max-height: 100vh;
			border-radius: 0;
		}
	}

	@media (max-width: 600px) {
		.menu-modal__close {
			width: 44px;
			height: 44px;
			top: 12px;
			right: 12px;
		}

		.menu-modal__close svg {
			width: 24px;
			height: 24px;
		}
	}

	.central-hero {
		position: relative;
		height: 760px;
		display: grid;
		place-items: center;
		overflow: hidden;
		color: #ffffff;
		background: #101010;
	}

	.central-hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		filter: grayscale(1) contrast(1.1) brightness(0.72);
		transform: scale(1.03);
	}

	.central-hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.65));
	}

	.central-hero__pattern {
		position: absolute;
		inset: 0;
		background-repeat: no-repeat;
		background-position: center;
		background-size: 520px auto;
		opacity: 0.12;
	}

	.central-hero__content {
		position: relative;
		z-index: 2;
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
	}

	.central-hero__logo {
		position: relative;
		width: 210px;
		height: 210px;
		border-radius: 999px;
		border: 4px solid #e1454f;
		display: grid;
		place-items: center;
		text-align: center;
		background: rgba(0, 0, 0, 0.72);
		box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45);
	}

	.central-hero__logo::before {
		content: '';
		position: absolute;
		inset: 12px;
		border-radius: 999px;
		border: 2px solid rgba(225, 69, 79, 0.65);
	}

	.central-hero__logo img {
		width: 110px;
		height: 110px;
		object-fit: contain;
	}

	.central-hero__since {
		position: absolute;
		top: 14px;
		left: 50%;
		transform: translateX(-50%);
		font-size: 12px;
		letter-spacing: 2px;
		text-transform: uppercase;
	}

	.central-hero__brand {
		position: absolute;
		bottom: 18px;
		left: 50%;
		transform: translateX(-50%);
		font-size: 11px;
		letter-spacing: 2px;
	}

	.central-hero__labels {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.central-hero__label {
		position: absolute;
		font-family: 'River Young', 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-size: 34px;
		letter-spacing: 1px;
		text-transform: uppercase;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
	}

	.central-hero__label--bebidas {
		left: 12%;
		top: 30%;
		transform: rotate(-55deg);
	}

	.central-hero__label--tacos {
		left: 18%;
		bottom: 24%;
		transform: rotate(-25deg);
	}

	.central-hero__label--combos {
		left: 45%;
		bottom: 16%;
		transform: rotate(-5deg);
	}

	.central-hero__label--caldos {
		right: 12%;
		top: 30%;
		transform: rotate(55deg);
	}

	.central-hero__label--tostadas {
		right: 16%;
		bottom: 24%;
		transform: rotate(25deg);
	}

	.central-info {
		position: relative;
		background: #e1454f;
		padding: 86px 24px 120px;
		text-align: center;
		overflow: hidden;
	}

	.central-info__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		opacity: 0.25;
	}

	.central-info__zigzag {
		position: absolute;
		top: -12px;
		left: 50%;
		transform: translateX(-50%);
		width: 520px;
		height: auto;
		opacity: 0.6;
		z-index: 1;
	}

	.central-info__content {
		position: relative;
		z-index: 2;
		width: min(720px, 100%);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		color: #ffffff;
	}

	.central-info__eyebrow {
		font-size: 16px;
		letter-spacing: 3px;
		text-transform: uppercase;
	}

	.central-info__title {
		margin: 0;
		font: normal normal 700 38px/1.1 Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 1px;
	}

	.central-info__location {
		margin: 6px 0 0;
		font: normal normal 800 26px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		color: #0f0f0f;
	}

	.central-info__address {
		margin-top: 6px;
		display: grid;
		gap: 4px;
		font-size: 14px;
	}

	.central-info__address p {
		margin: 0;
	}

	.central-info__phones {
		margin-top: 8px;
		display: grid;
		gap: 6px;
		font-size: 15px;
	}

	.central-info__phone {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-weight: 700;
	}

	.central-info__phone svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}

	.central-info__scroll {
		position: absolute;
		right: 32px;
		bottom: 26px;
		width: 48px;
		height: 48px;
		border-radius: 999px;
		background: #ffffff;
		color: #e1454f;
		display: grid;
		place-items: center;
		text-decoration: none;
		box-shadow: 0 12px 26px rgba(0, 0, 0, 0.25);
		z-index: 3;
	}

	.central-info__scroll svg {
		width: 20px;
		height: 20px;
		fill: currentColor;
	}

	.central-category {
		background: #111111;
		padding: 90px 24px 160px;
		color: #ffffff;
		position: relative;
		overflow: hidden;
		background-image:
			radial-gradient(circle at top, rgba(255, 255, 255, 0.06), transparent 55%),
			repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.04) 0 1px, transparent 1px 6px);
	}

	.central-category__wrap {
		width: min(1489px, 100%);
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 70px;
		position: relative;
		z-index: 2;
	}

	.central-category__block {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.central-menu__decor {
		position: absolute;
		background-repeat: no-repeat;
		background-size: contain;
		background-position: center;
		pointer-events: none;
		z-index: 1;
	}

	.central-menu__decor--568 {
		top: -94px;
		left: -159px;
		width: 1356px;
		height: 2061px;
		opacity: 1;
	}

	.central-menu__decor--472 {
		top: 11757px;
		left: 112px;
		width: 179px;
		height: 278px;
		opacity: 1;
	}

	.central-category__inner {
		display: grid;
		grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
		gap: 70px;
		align-items: center;
	}

	.central-category__image {
		margin: 0;
		position: relative;
	}

	.central-category__image img {
		width: 100%;
		display: block;
		border-radius: 14px;
		box-shadow: 0 18px 38px rgba(0, 0, 0, 0.4);
	}

	.central-category__image::after {
		content: '';
		position: absolute;
		inset: -12px 14px auto auto;
		width: 80px;
		height: 80px;
		border: 3px solid #e1454f;
		border-radius: 999px;
		opacity: 0.7;
	}

	.central-category__content {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.central-category__script {
		font-family: 'River Young', 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-size: 36px;
		color: #e5c790;
	}

	.central-menu__line {
		position: relative;
		width: 240px;
		height: 1px;
		background: rgba(255, 255, 255, 0.45);
	}

	.central-menu__line::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 12px;
		height: 12px;
		transform: translate(-50%, -50%);
		background: #d6b26e;
		clip-path: polygon(
			50% 0%,
			61% 35%,
			98% 35%,
			68% 57%,
			79% 91%,
			50% 70%,
			21% 91%,
			32% 57%,
			2% 35%,
			39% 35%
		);
	}

	.central-menu__line--short {
		width: 200px;
	}

	.central-category__title {
		margin: 0;
		font: normal normal 800 56px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 4px;
	}

	.central-menu {
		display: flex;
		flex-direction: column;
		gap: 60px;
	}

	.central-menu__grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
		gap: 40px;
		align-items: start;
	}

	.central-menu__grid--single {
		grid-template-columns: minmax(0, 1fr);
	}

	.central-menu__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 16px;
	}

	.central-menu__item {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 16px;
		padding-bottom: 10px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.central-menu__item-text {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.central-menu__item-name {
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 1px;
	}

	.central-menu__item-note {
		font-size: 10px;
		color: #e1454f;
		text-transform: uppercase;
		letter-spacing: 1.2px;
	}

	.central-menu__item-price {
		font-size: 14px;
		font-weight: 700;
		white-space: nowrap;
	}

	.central-menu__empty {
		margin: 0;
		font-size: 14px;
		color: #cfcfcf;
	}

	.central-menu__extras {
		background: rgba(0, 0, 0, 0.45);
		border: 1px solid rgba(255, 255, 255, 0.08);
		padding: 22px;
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.central-menu__extras-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
	}

