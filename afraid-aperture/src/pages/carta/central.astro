---
import Layout from '../../layouts/Layout.astro';
import heroBgUrl from '../../assets/media/Enmascarar grupo 20.png?url';
import heroBg2xUrl from '../../assets/media/Enmascarar grupo 20@2x.png?url';
import heroPatternUrl from '../../assets/media/Grupo 140.svg?url';
import logoUrl from '../../assets/media/Enmascarar grupo 4.png?url';
import logo2xUrl from '../../assets/media/Enmascarar grupo 4@2x.png?url';
import infoBgUrl from '../../assets/media/Enmascarar grupo 6.png?url';
import infoBg2xUrl from '../../assets/media/Enmascarar grupo 6@2x.png?url';
import zigzagUrl from '../../assets/media/Grupo 36.svg?url';
import tostadaUrl from '../../assets/media/Grupo 31.png?url';
import tostada2xUrl from '../../assets/media/Grupo 31@2x.png?url';
import tacoUrl from '../../assets/media/Grupo 34.png?url';
import taco2xUrl from '../../assets/media/Grupo 34@2x.png?url';
import caldoUrl from '../../assets/media/Grupo 33.png?url';
import caldo2xUrl from '../../assets/media/Grupo 33@2x.png?url';
import comboUrl from '../../assets/media/Grupo 27.png?url';
import combo2xUrl from '../../assets/media/Grupo 27@2x.png?url';
import menuBg568Url from '../../assets/media/Grupo 568.png?url';
import menuBg5682xUrl from '../../assets/media/Grupo 568@2x.png?url';
import menuDecor472Url from '../../assets/media/Grupo 472.png?url';
import menuDecor4722xUrl from '../../assets/media/Grupo 472@2x.png?url';

const heroLabels = [
  { text: 'BEBIDAS', className: 'bebidas' },
  { text: 'TACOS', className: 'tacos' },
  { text: 'COMBOS', className: 'combos' },
  { text: 'CALDOS', className: 'caldos' },
  { text: 'TOSTADAS', className: 'tostadas' },
];

const branchInfo = {
  title: 'LA SIBERIA CENTRAL',
  location: 'CENTRAL',
  addressLines: [
    'Av. Rodrigo Gómez 623, Col. Central, Monterrey',
    'Nuevo León CP 64190',
  ],
  phones: ['8112573064'],
};

const tostadasItems = [
  { name: 'TOSTADA DE PECHUGA', note: 'HEN BREAST TOSTADA', price: '93.00' },
  { name: 'TOSTADA DE PECHUGA JUNIOR', note: 'LOREM IPSUM', price: '64.00' },
  { name: 'TOSTADA DE PIERNA', note: 'HEN LEG TOSTADA', price: '76.00' },
  { name: 'TOSTADA DE PIERNA JUNIOR', note: 'JUNIOR HEN LEG TOSTADA', price: '51.00' },
  { name: 'TOSTADA DEL ABUELO', note: "GRANDPA'S TOSTADA", price: '84.00' },
];

const extrasItems = [
  { name: 'CHILES', note: 'Jalapeño Peppers', price: '5.00' },
  { name: 'CREMA', note: 'Sour cream', price: '17.00' },
  { name: 'TAPA GRANDE', note: 'Large tortilla tostado', price: '15.00' },
  { name: 'TAPA CHICA', note: 'Small tortilla tostado', price: '8.00' },
  { name: 'GUACAMOLE', note: 'Guacamole', price: '44.00' },
  { name: 'ORDEN PECHUGA', note: 'Jalapeño Peppers', price: '54.00' },
];

const tacosItems = [
  { name: 'TACOS DE PECHUGA', note: 'HEN BREAST TOSTADA', price: '93.00' },
  { name: 'TACO DE PECHUGA JUNIOR', note: 'JUNIOR HEN BREAST TOSTADA', price: '64.00' },
  { name: 'TACO DE PIERNA', note: 'HEN LEG TOSTADA', price: '76.00' },
  { name: 'TACO DE PIERNA JUNIOR', note: 'JUNIOR HEN LEG TOSTADA', price: '51.00' },
];

const caldosFeature = {
  name: 'TLALPEÑO',
  subtitle: 'CALDO',
  description:
    'Arroz servido en consomé de gallina, con pechuga deshebrada, queso asadero en cubos, tiritas fritas en manteca, un toque de chipotle y aguacate fresco.',
  note:
    'Rice served in hen broth, with shredded hen breast, asadero cheese cubes, fried strips of tortilla, a touch of chipotle, and fresh avocado.',
  sizes: [
    { label: 'CHICO/SMALL', price: '104.00' },
    { label: 'GRANDE/LARGE', price: '84.00' },
  ],
};

const caldosCards = [
  {
    name: 'CALDO DE PECHUGA',
    subtitle: 'HEN BREAST BROTH',
    description:
      'Consomé de gallina con arroz, pechuga y una tortilla para acompañar.',
    note: 'Hen broth served with rice, hen breast, and a tortilla as side.',
    price: '93.00',
  },
  {
    name: 'CALDO DE PIERNA',
    subtitle: 'HEN LEG BROTH',
    description:
      'Consomé de gallina con arroz, una pieza de pierna y una tortilla para acompañar.',
    note: 'Hen broth served with rice, a piece of hen leg, and a tortilla as side.',
    price: '76.00',
  },
];

const consomeItems = [
  {
    name: 'CONSOME',
    note: 'BROTH',
    description: 'Consomé de gallina con arroz.',
    noteEn: 'Hen broth served with rice.',
    price: '39.00',
  },
  {
    name: 'CONSOME DE PECHUGA',
    note: 'HEN BREAST BROTH',
    description: 'Consomé de gallina grande con pechuga y arroz.',
    noteEn: 'Hen leg served with rice, hen breast and tortilla as side.',
    price: '93.00',
  },
  {
    name: 'CONSOME DE PIERNA',
    note: 'HEN LEG BROTH',
    description: 'Consomé de gallina con pierna, arroz, y una tortilla para acompañar.',
    noteEn: 'Hen leg served with rice, and a tortilla as side.',
    price: '93.00',
  },
];

const consomeExtras = [
  { name: 'TORTILLA', note: 'Tortilla', price: '6.00' },
  { name: 'TORTILLA JR', note: 'Tortilla', price: '4.00' },
  { name: 'ORDEN PIERNA', note: 'Portion of Hen leg', price: '44.00' },
  { name: 'ORDEN PECHUGA', note: 'Portion of Hen breast', price: '54.00' },
  { name: 'ORDEN DE QUESO', note: 'Tortilla', price: '24.00' },
  { name: 'ORDEN ARROZ', note: 'Order of rice', price: '33.00' },
  { name: 'LITRO DE ARROZ', note: 'Liter of rice', price: '69.00' },
  { name: '1/2 DE ARROZ', note: 'Half liter of rice', price: '43.00' },
];

const combosItems = [
  {
    name: 'COMBO 1',
    note: 'COMBO 1',
    description: 'Tostada grande de pechuga/pierna + consomé + refresco.',
  },
];

const bebidasItems = [
  {
    name: 'COCA-COLA',
    note: 'COKE',
    options: ['Regular / Light / Sin azúcar', 'Regular / Light / Zero'],
    price: '34.00',
    kind: 'cola',
    mockCount: 3,
  },
  {
    name: 'FUZE TEA',
    note: 'FUZE TEA',
    options: ['Regular / Light / Sin azúcar', 'Regular / Light / Zero'],
    price: '37.00',
    kind: 'tea',
    mockCount: 2,
  },
  {
    name: 'AGUA',
    note: 'WATER',
    options: ['Natural / Still', 'Mineral / Sparkling'],
    price: '29.00',
    priceSecondary: '34.00',
    kind: 'water',
    mockCount: 2,
  },
];
---

<Layout title="Menú Central | La Siberia Central">
  <section id="menu-top" class="central-hero">
    <div
      class="central-hero__bg"
      style={`background-image: image-set(url(${heroBgUrl}) 1x, url(${heroBg2xUrl}) 2x);`}
      aria-hidden="true"
    ></div>
    <div class="central-hero__overlay" aria-hidden="true"></div>
    <div
      class="central-hero__pattern"
      style={`background-image: url(${heroPatternUrl});`}
      aria-hidden="true"
    ></div>

    <div class="central-hero__content">
      <div class="central-hero__logo">
        <span class="central-hero__since">DESDE 1978</span>
        <img
          src={logoUrl}
          srcset={`${logoUrl} 1x, ${logo2xUrl} 2x`}
          alt="La Siberia Central"
        />
        <span class="central-hero__brand">LA SIBERIA CENTRAL</span>
      </div>

      <div class="central-hero__labels" aria-hidden="true">
        {heroLabels.map((label) => (
          <span class={`central-hero__label central-hero__label--${label.className}`}>
            {label.text}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="central-info" aria-labelledby="menu-title">
    <div
      class="central-info__bg"
      style={`background-image: image-set(url(${infoBgUrl}) 1x, url(${infoBg2xUrl}) 2x);`}
      aria-hidden="true"
    ></div>
    <img class="central-info__zigzag" src={zigzagUrl} alt="" aria-hidden="true" />

    <div class="central-info__content">
      <span id="menu-title" class="central-info__eyebrow">Menú</span>
      <h1 class="central-info__title">{branchInfo.title}</h1>
      <h2 class="central-info__location">{branchInfo.location}</h2>
      <div class="central-info__address">
        {branchInfo.addressLines.map((line) => (
          <p>{line}</p>
        ))}
      </div>
      <div class="central-info__phones">
        {branchInfo.phones.map((phone) => (
          <span class="central-info__phone">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
            </svg>
            {phone}
          </span>
        ))}
      </div>
    </div>

    <a class="central-info__scroll" href="#menu-top" aria-label="Volver arriba">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 6l-7 7h4v5h6v-5h4z" />
      </svg>
    </a>
  </section>

  <section class="central-category" aria-labelledby="tostadas-title">
    <div
      class="central-menu__decor central-menu__decor--568"
      style={`background-image: image-set(url(${menuBg568Url}) 1x, url(${menuBg5682xUrl}) 2x);`}
      aria-hidden="true"
    ></div>
    <div
      class="central-menu__decor central-menu__decor--472"
      style={`background-image: image-set(url(${menuDecor472Url}) 1x, url(${menuDecor4722xUrl}) 2x);`}
      aria-hidden="true"
    ></div>
    <div class="central-category__wrap">
      <div class="central-category__inner">
        <figure class="central-category__image">
          <img
            src={tostadaUrl}
            srcset={`${tostadaUrl} 1x, ${tostada2xUrl} 2x`}
            alt="Tostadas"
            loading="lazy"
          />
        </figure>
        <div class="central-category__content">
          <span class="central-category__script">Más Bien Servidas!</span>
          <span class="central-menu__line" aria-hidden="true"></span>
          <h2 id="tostadas-title" class="central-category__title">TOSTADAS</h2>
        </div>
      </div>

      <div class="central-menu">
        <div class="central-menu__grid">
          <ul class="central-menu__list">
            {tostadasItems.map((item) => (
              <li class="central-menu__item">
                <div class="central-menu__item-text">
                  <span class="central-menu__item-name">{item.name}</span>
                  <span class="central-menu__item-note">{item.note}</span>
                </div>
                <span class="central-menu__item-price">${item.price}</span>
              </li>
            ))}
          </ul>

          <aside class="central-menu__extras">
            <div class="central-menu__extras-header">
              <span class="central-menu__extras-tag">EXTRAS</span>
              <div class="central-menu__extras-script">
                <span>El antojo manda</span>
                <div class="central-menu__extras-stars" aria-hidden="true">
                  <span class="central-menu__star central-menu__star--red"></span>
                  <span class="central-menu__star central-menu__star--red"></span>
                  <span class="central-menu__star central-menu__star--red"></span>
                </div>
              </div>
            </div>
            <ul class="central-menu__extras-list">
              {extrasItems.map((item) => (
                <li class="central-menu__extras-item">
                  <div class="central-menu__extras-text">
                    <span class="central-menu__extras-name">{item.name}</span>
                    <span class="central-menu__extras-note">{item.note}</span>
                  </div>
                  <span class="central-menu__extras-price">${item.price}</span>
                </li>
              ))}
            </ul>
          </aside>
        </div>

        <div class="central-menu__section">
          <div class="central-menu__section-header">
            <h3 class="central-menu__section-title">TACOS</h3>
            <span class="central-menu__line central-menu__line--short" aria-hidden="true"></span>
          </div>
          <div class="central-menu__tacos-grid">
            <ul class="central-menu__list central-menu__list--tacos">
              {tacosItems.map((item) => (
                <li class="central-menu__item">
                  <div class="central-menu__item-text">
                    <span class="central-menu__item-name">{item.name}</span>
                    <span class="central-menu__item-note">{item.note}</span>
                  </div>
                  <span class="central-menu__item-price">${item.price}</span>
                </li>
              ))}
            </ul>
            <figure class="central-menu__taco-image">
              <img
                src={tacoUrl}
                srcset={`${tacoUrl} 1x, ${taco2xUrl} 2x`}
                alt="Tacos"
                loading="lazy"
              />
            </figure>
          </div>
        </div>

        <div class="central-menu__section central-menu__section--caldos">
          <div class="central-menu__caldos-top">
            <aside class="central-menu__extras central-menu__extras--caldos">
              <div class="central-menu__extras-header">
                <span class="central-menu__extras-tag">EXTRAS</span>
                <div class="central-menu__extras-script central-menu__extras-script--vertical">
                  <span>Sorpresa con nuez?</span>
                  <span>Luego vengo</span>
                </div>
              </div>
              <ul class="central-menu__extras-list">
                {extrasItems.map((item) => (
                  <li class="central-menu__extras-item">
                    <div class="central-menu__extras-text">
                      <span class="central-menu__extras-name">{item.name}</span>
                      <span class="central-menu__extras-note">{item.note}</span>
                    </div>
                    <span class="central-menu__extras-price">${item.price}</span>
                  </li>
                ))}
              </ul>
            </aside>

            <div class="central-menu__caldos-title">
              <figure class="central-menu__caldo-image">
                <img
                  src={caldoUrl}
                  srcset={`${caldoUrl} 1x, ${caldo2xUrl} 2x`}
                  alt="Caldos"
                  loading="lazy"
                />
              </figure>
              <div class="central-menu__caldos-heading">
                <h3 class="central-menu__section-title">CALDOS</h3>
                <span class="central-menu__line central-menu__line--short" aria-hidden="true"></span>
              </div>
            </div>
          </div>

          <article class="central-menu__caldo-feature">
            <div class="central-menu__caldo-stars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <h4 class="central-menu__caldo-name">{caldosFeature.name}</h4>
            <p class="central-menu__caldo-desc">{caldosFeature.description}</p>
            <p class="central-menu__caldo-note">{caldosFeature.note}</p>
            <div class="central-menu__caldo-sizes">
              {caldosFeature.sizes.map((size) => (
                <div class="central-menu__caldo-size">
                  <span>{size.label}</span>
                  <strong>${size.price}</strong>
                </div>
              ))}
            </div>
          </article>

          <div class="central-menu__caldo-cards">
            {caldosCards.map((card) => (
              <article class="central-menu__caldo-card">
                <div class="central-menu__caldo-card-header">
                  <div>
                    <h4>{card.name}</h4>
                    <span>{card.subtitle}</span>
                  </div>
                  <strong>${card.price}</strong>
                </div>
                <p>{card.description}</p>
                <p class="central-menu__caldo-card-note">{card.note}</p>
              </article>
            ))}
          </div>
        </div>

        <div class="central-menu__section central-menu__section--consome">
          <div class="central-menu__consome-top">
            <div class="central-menu__consome-list">
              {consomeItems.map((item) => (
                <article class="central-menu__consome-item">
                  <div>
                    <h4>{item.name}</h4>
                    <span>{item.note}</span>
                    <p>{item.description}</p>
                    <p class="central-menu__consome-note">{item.noteEn}</p>
                  </div>
                  <strong>${item.price}</strong>
                </article>
              ))}
            </div>
            <div class="central-menu__consome-art">
              <div class="central-menu__consome-stars" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <div class="central-menu__consome-bowl" aria-hidden="true"></div>
            </div>
          </div>

          <div class="central-menu__consome-extras">
            <span class="central-menu__extras-tag">EXTRAS</span>
            <div class="central-menu__consome-extras-grid">
              {consomeExtras.map((item) => (
                <div class="central-menu__extras-item">
                  <div class="central-menu__extras-text">
                    <span class="central-menu__extras-name">{item.name}</span>
                    <span class="central-menu__extras-note">{item.note}</span>
                  </div>
                  <span class="central-menu__extras-price">${item.price}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="central-menu__combos">
            <div class="central-menu__combos-header">
              <h3>COMBOS</h3>
              <span class="central-menu__line central-menu__line--short" aria-hidden="true"></span>
            </div>
            <div class="central-menu__combos-body">
              <div class="central-menu__combo-list">
                {combosItems.map((combo) => (
                  <article class="central-menu__combo-card">
                    <h4>{combo.name}</h4>
                    <span>{combo.note}</span>
                    <p>{combo.description}</p>
                  </article>
                ))}
              </div>
              <figure class="central-menu__combo-image">
                <img
                  src={comboUrl}
                  srcset={`${comboUrl} 1x, ${combo2xUrl} 2x`}
                  alt="Combos"
                  loading="lazy"
                />
              </figure>
            </div>
          </div>
        </div>

        <div class="central-menu__section central-menu__section--bebidas">
          <div class="central-menu__bebidas-header">
            <h3>BEBIDAS</h3>
            <span class="central-menu__line central-menu__line--short" aria-hidden="true"></span>
            <span class="central-menu__bebidas-script">Para bajar el taco</span>
            <div class="central-menu__bebidas-stars" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </div>
          </div>

          <div class="central-menu__bebidas-list">
            {bebidasItems.map((item) => (
              <article class="central-menu__bebida">
                <div class={`central-menu__bebida-mock central-menu__bebida-mock--${item.kind}`}>
                  {Array.from({ length: item.mockCount }).map(() => (
                    <span class="central-menu__bebida-bottle" aria-hidden="true"></span>
                  ))}
                </div>
                <div class="central-menu__bebida-info">
                  <div class="central-menu__bebida-text">
                    <h4>{item.name}</h4>
                    <span>{item.note}</span>
                    <ul>
                      {item.options.map((option) => (
                        <li>{option}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="central-menu__bebida-price">
                    <strong>${item.price}</strong>
                    {item.priceSecondary && <strong>${item.priceSecondary}</strong>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .central-hero {
    position: relative;
    height: 760px;
    display: grid;
    place-items: center;
    overflow: hidden;
    color: #ffffff;
    background: #101010;
  }

  .central-hero__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.1) brightness(0.72);
    transform: scale(1.03);
  }

  .central-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.65));
  }

  .central-hero__pattern {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    background-position: center;
    background-size: 520px auto;
    opacity: 0.12;
  }

  .central-hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
  }

  .central-hero__logo {
    position: relative;
    width: 210px;
    height: 210px;
    border-radius: 999px;
    border: 4px solid #e1454f;
    display: grid;
    place-items: center;
    text-align: center;
    background: rgba(0, 0, 0, 0.72);
    box-shadow: 0 18px 36px rgba(0, 0, 0, 0.45);
  }

  .central-hero__logo::before {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: 999px;
    border: 2px solid rgba(225, 69, 79, 0.65);
  }

  .central-hero__logo img {
    width: 110px;
    height: 110px;
    object-fit: contain;
  }

  .central-hero__since {
    position: absolute;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .central-hero__brand {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 2px;
  }

  .central-hero__labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .central-hero__label {
    position: absolute;
    font-family: 'River Young', 'Campton', 'Montserrat', 'Arial', sans-serif;
    font-size: 34px;
    letter-spacing: 1px;
    text-transform: uppercase;
    text-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
  }

  .central-hero__label--bebidas {
    left: 12%;
    top: 30%;
    transform: rotate(-55deg);
  }

  .central-hero__label--tacos {
    left: 18%;
    bottom: 24%;
    transform: rotate(-25deg);
  }

  .central-hero__label--combos {
    left: 45%;
    bottom: 16%;
    transform: rotate(-5deg);
  }

  .central-hero__label--caldos {
    right: 12%;
    top: 30%;
    transform: rotate(55deg);
  }

  .central-hero__label--tostadas {
    right: 16%;
    bottom: 24%;
    transform: rotate(25deg);
  }

  .central-info {
    position: relative;
    background: #e1454f;
    padding: 86px 24px 120px;
    text-align: center;
    overflow: hidden;
  }

  .central-info__bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
