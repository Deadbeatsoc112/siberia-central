---
import Footer from '../components/Footer.astro';

const { title = 'La Siberia Central' } = Astro.props;
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Menú', href: '/menu-sucursales' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Bolsa de trabajo', href: '/bolsa-de-trabajo' },
];
const currentPath = Astro.url?.pathname ?? '/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav class="site-nav" aria-label="Principal">
				<ul class="site-nav__list">
					{navItems.map((item) => {
						const isMenuRoute = item.href === '/menu-sucursales' && currentPath.startsWith('/carta');
						const isActive =
							item.href === '/'
								? currentPath === '/'
								: currentPath.startsWith(item.href) || isMenuRoute;
						return (
							<li class="site-nav__item">
								<a class={`site-nav__link ${isActive ? 'is-active' : ''}`} href={item.href}>
									{item.label}
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
		</header>
		<main class="page">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonThin.otf") format("opentype");
		font-weight: 100;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonThinItalic.otf") format("opentype");
		font-weight: 100;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonExtraLight.otf") format("opentype");
		font-weight: 200;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonExtraLightItalic.otf")
			format("opentype");
		font-weight: 200;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonLight.otf") format("opentype");
		font-weight: 300;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonLightItalic.otf")
			format("opentype");
		font-weight: 300;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBook.otf") format("opentype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBookItalic.otf")
			format("opentype");
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonMedium.otf") format("opentype");
		font-weight: 500;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonMediumItalic.otf")
			format("opentype");
		font-weight: 500;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonSemiBold.otf") format("opentype");
		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonSemiBoldItalic.otf")
			format("opentype");
		font-weight: 600;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBold.otf") format("opentype");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBoldItalic.otf")
			format("opentype");
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonExtraBold.otf") format("opentype");
		font-weight: 800;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonExtraBoldItalic.otf")
			format("opentype");
		font-weight: 800;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBlack.otf") format("opentype");
		font-weight: 900;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBlackItalic.otf")
			format("opentype");
		font-weight: 900;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "River Young";
		src:
			url("../assets/fonts/river-young/RiverYoung-Regular.otf")
				format("opentype"),
			url("../assets/fonts/river-young/RiverYoung-Regular.ttf")
				format("truetype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	:global(:root) {
		--nav-height: 38px;
		--nav-width: 1106px;
		--nav-top: 55px;
		--nav-text: #c8b07a;
		--page-bg: #050505;
		--page-text: #ffffff;
	}

	:global(html, body) {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background: var(--page-bg);
		color: var(--page-text);
		overflow-x: hidden;
		box-sizing: border-box;
		font-family: 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-weight: 700;
	}

	:global(*, *::before, *::after) {
		font-family: 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-weight: 700;
		box-sizing: inherit;
	}

	.site-header {
		position: absolute;
		top: var(--nav-top);
		left: 0;
		width: 100%;
		height: var(--nav-height);
		opacity: 1;
		z-index: 10;
		display: flex;
		justify-content: center;
	}

	.site-nav {
		height: 100%;
		width: min(90%, var(--nav-width));
	}

	.site-nav__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		gap: 62px;
	}

	.site-nav__link {
		color: var(--nav-text);
		text-decoration: none;
		font-size: 18px;
		font-weight: 500;
		line-height: var(--nav-height);
		letter-spacing: 0.4px;
		text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.55);
		transition: opacity 0.2s ease;
	}

	.site-nav__link:hover,
	.site-nav__link:focus-visible {
		opacity: 0.8;
	}

	.site-nav__link.is-active {
		opacity: 1;
		border-bottom: 2px solid rgba(200, 176, 122, 0.7);
		padding-bottom: 6px;
	}

	.page {
		min-height: 100vh;
	}

	.page-hero {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		text-align: center;
		padding: 140px 24px 80px;
	}

	.page-hero h1 {
		margin: 0;
		font-size: 48px;
		letter-spacing: 0px;
		font-weight: 700;
	}

	.page-hero p {
		margin: 0;
		max-width: 640px;
		opacity: 0.75;
	}

	@media (max-width: 1200px) {
		.site-nav__list {
			justify-content: center;
			gap: 28px;
			flex-wrap: wrap;
		}
	}

	@media (max-width: 768px) {
		:global(:root) {
			--nav-top: 20px;
		}

		.site-header {
			padding: 0 16px;
		}

		.site-nav__list {
			gap: 12px 20px;
		}

		.site-nav__link {
			font-size: 14px;
		}
	}

	@media (max-width: 480px) {
		:global(:root) {
			--nav-top: 16px;
		}

		.site-header {
			padding: 0 12px;
		}

		.site-nav__list {
			gap: 8px 14px;
		}

		.site-nav__link {
			font-size: 12px;
			letter-spacing: 0.2px;
		}
	}

	@media (max-width: 375px) {
		:global(:root) {
			--nav-top: 12px;
		}

		.site-header {
			padding: 0 8px;
		}

		.site-nav__list {
			gap: 6px 10px;
		}

		.site-nav__link {
			font-size: 11px;
			letter-spacing: 0.1px;
		}
	}
</style>
