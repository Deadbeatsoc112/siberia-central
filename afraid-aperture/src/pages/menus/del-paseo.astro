<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menú | Del Paseo | La Siberia Central</title>
  </head>

  <body>
    <main class="page">
      <div class="frame" id="frame">
        <div class="canvas" style={`--menu-bg: url(${menuBgUrl});`}>
          <a id="menu-top" class="menu-top-anchor" aria-hidden="true"></a>
          <a class="abs back-link" href="/menu-sucursales" aria-label="Volver a Menús">← Menús</a>

          <!-- =========================
               1) HEADER (0 - 1390)
               ========================= -->
          <section class="header">
            <!-- Fondo de imagen del header -->
            <div class="header-bg-image" style={`background-image: url(${headerBgUrl});`}></div>
            <!-- Logo arriba en el header -->
            <div class="logo-combos" style={`background-image: url(${logoUrl});`}></div>
            <div class="tostadas-header" style={`background-image: url(${grupo675BgUrl});`} aria-hidden="true"></div>
            <!-- Imagen adicional sobre el taco -->
            <img src={grupo605Url} alt="" class="header-decoration" />
            <!-- Imagen superpuesta sobre el taco -->
            <img src={grupo607Url} alt="" class="header-script" />
          </section>

          <!-- =========================
               ELEMENTOS POSICIONADOS EN EL CANVAS
               ========================= -->
          <div class="abs img g608" style="z-index:3;" aria-hidden="true"></div>
          <div class="abs img g605" aria-hidden="true"></div>
          <div class="abs img g572" style="z-index:3;" aria-hidden="true"></div>
          <div class="abs img g284" style={`background-image: url(${grupo284BgUrl});`} aria-hidden="true"></div>
          <div class="abs img g321" aria-hidden="true"></div>
          <div class="abs img g323" aria-hidden="true"></div>
          <div class="abs img g323b" aria-hidden="true"></div>
          <div class="abs img g-coke" aria-hidden="true"></div>
          <div class="abs img g569" style={`background-image: url(${grupo743Url});`} aria-hidden="true"></div>
          <div class="abs img g477" aria-hidden="true"></div>
          <div class="abs img g500" aria-hidden="true"></div>
          <div class="abs img g522" aria-hidden="true"></div>
          <div class="abs img g556" aria-hidden="true"></div>
          <div class="abs img g738" aria-hidden="true"></div>
          <img src={grupo680BgUrl} alt="" class="abs" style="right: -200px; bottom:100px; width: 800px; height: auto; z-index: 2;" aria-hidden="true" />
          <div class="abs img g678" aria-hidden="true"></div>
          <div class="abs img g677" aria-hidden="true"></div>
          <div class="abs img g677b" aria-hidden="true"></div>
          
          <div class="abs img g246" aria-hidden="true"></div>
          <img src={grupo654Url} alt="" class="abs" style="left: -80px; top: 14000px; width: 300px; height: auto; z-index: 3;" aria-hidden="true" />
          <div class="abs tradition-final">!Somos una tradición muy regia!</div>

          <!-- =========================
               TEXTOS
               ========================= -->
          <a
            class="txt nav nav-link"
            href="#bebidas"
            style="--x: 130px; --y: 260px; --w: 172px; --h: 163px; --delay: 0s; z-index: 3;"
          >
            <img src={bebidasSvgUrl} alt="BEBIDAS" style="width: 100%; height: 100%;" />
          </a>
          <a
            class="txt nav nav-link"
            href="#tacos"
            style="--x: 215px; --y: 430px; --w: 240px; --h: 141px; --delay: 0.2s; z-index: 3;"
          >
            <img src={tacosSvgUrl} alt="TACOS" style="width: 100%; height: 100%;" />
