---
import Layout from '../layouts/Layout.astro';
import jobsHeroUrl from '../assets/media/Enmascarar grupo 17.png?url';
import jobsHero2xUrl from '../assets/media/Enmascarar grupo 17@2x.png?url';
import { jobsRepo } from '../lib/content';

const jobs = jobsRepo.listAll().filter((job) => job.is_active === 1);
---

<Layout title="Bolsa de trabajo | La Siberia Central">
	<section class="jobs-hero" aria-labelledby="jobs-title">
		<div
			class="jobs-hero__bg"
			style={`background-image: image-set(url(${jobsHeroUrl}) 1x, url(${jobsHero2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
		<div class="jobs-hero__overlay" aria-hidden="true"></div>
		<div class="jobs-hero__content">
			<h1 id="jobs-title" class="jobs-hero__title">Bolsa de trabajo</h1>
			<p class="jobs-hero__subtitle">Forma parte del equipo y crece con nosotros</p>
		</div>
	</section>
	<section class="jobs-list" aria-labelledby="jobs-list-title">
		<div class="jobs-list__inner">
			<h2 id="jobs-list-title" class="sr-only">Vacantes disponibles</h2>
			{jobs.length === 0 ? (
				<p class="jobs-list__empty">En este momento no hay vacantes activas.</p>
			) : (
				<div class="jobs-list__grid">
					{jobs.map((job) => (
						<article class="job-card">
							<h3 class="job-card__title">{job.title}</h3>
							<p class="job-card__meta">
								<span>{job.location}</span>
								<span>•</span>
								<span>{job.type}</span>
							</p>
							<p class="job-card__description">{job.description}</p>
							<a
								class="job-card__button"
								href={`mailto:talento@lasiberiacentral.com?subject=Vacante%20${encodeURIComponent(job.title)}`}
							>
								Postularme
							</a>
						</article>
					))}
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.jobs-hero {
		position: relative;
		width: 100%;
		height: 752px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #ffffff;
	}

	.jobs-hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		filter: grayscale(1) contrast(1.05) brightness(0.72);
		transform: scale(1.02);
	}

	.jobs-hero__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.45);
	}

	.jobs-hero__content {
		position: relative;
		z-index: 2;
		max-width: 820px;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.jobs-hero__title {
		margin: 0;
		font: normal normal bold 64px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
	}

	.jobs-hero__subtitle {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 0.2px;
		text-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
		opacity: 0.98;
	}

	.jobs-list {
		background: #ffffff;
		padding: 120px 0 150px;
		display: flex;
		justify-content: center;
	}

	.jobs-list__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.jobs-list__empty {
		margin: 0;
		font-size: 18px;
		color: #6a6a6a;
	}

	.jobs-list__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 34px;
	}

	.job-card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
		padding: 26px 28px 30px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.job-card__title {
		margin: 0;
		font: normal normal bold 26px/1.2 Campton, 'Montserrat', 'Arial', sans-serif;
		color: #e1454f;
	}

	.job-card__meta {
		margin: 0;
		display: flex;
		gap: 8px;
		color: #5a5a5a;
		font-weight: 600;
	}

	.job-card__description {
		margin: 0;
		font-size: 17px;
		line-height: 26px;
		color: #2b2b2b;
	}

	.job-card__button {
		margin-top: 6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		min-width: 190px;
		height: 46px;
		border: 2px solid #8b5a2b;
		color: #8b5a2b;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.2px;
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.job-card__button:hover,
	.job-card__button:focus-visible {
		transform: translateY(-2px);
		background: rgba(139, 90, 43, 0.08);
	}

	@media (max-width: 1200px) {
		.jobs-hero {
			height: 680px;
		}

		.jobs-hero__title {
			font-size: 56px;
		}

		.jobs-hero__subtitle {
			font-size: 18px;
		}

		.jobs-list {
			padding: 104px 0 130px;
		}

		.jobs-list__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 768px) {
		.jobs-hero {
			height: 560px;
		}

		.jobs-hero__title {
			font-size: 44px;
		}

		.jobs-hero__subtitle {
			font-size: 16px;
		}

		.jobs-list {
			padding: 90px 0 110px;
		}

		.jobs-list__grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
</style>
