---
interface Props {
	name: string;
	address: string;
	href: string;
	index?: number;
	variant?: 'dark' | 'accent';
	menuId?: number;
}

const { name, address, href, index, variant, menuId } = Astro.props as Props;
const resolvedVariant = variant ?? (typeof index === 'number' && index % 2 === 1 ? 'accent' : 'dark');
const variantClass = resolvedVariant === 'accent' ? 'is-accent' : 'is-dark';
---

<article class={`menu-card ${variantClass}`}>
	<div class="menu-card__content">
		<h3 class="menu-card__title">{name}</h3>
		<p class="menu-card__address">
			<span class="menu-card__pin" aria-hidden="true">
				<svg viewBox="0 0 24 24" focusable="false" aria-hidden="true">
					<path d="M12 2C8.134 2 5 5.134 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.866-3.134-7-7-7Zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" />
				</svg>
			</span>
			<span class="menu-card__address-text">{address}</span>
		</p>
	</div>
	{menuId ? (
		<button
			class="menu-card__button"
			onclick={`openMenuModal(${menuId})`}
			type="button"
		>
			Ver Menu
		</button>
	) : (
		<a class="menu-card__button" href={href}>Ver Menu</a>
	)}
</article>

<style>
	.menu-card {
		--card-bg: #161615;
		--card-fg: #ffffff;
		--pin-color: #e1454f;
		--button-border: rgba(255, 255, 255, 0.95);

		position: relative;
		width: min(1120px, 100%);
		min-height: 214px;
		padding: 42px 54px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		background: var(--card-bg);
		color: var(--card-fg);
		box-sizing: border-box;
		overflow: hidden;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 16px 30px rgba(0, 0, 0, 0.16);
	}

	.menu-card.is-accent {
		--card-bg: #e1454f;
		--pin-color: #111111;
	}

	.menu-card__content {
		max-width: 760px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.menu-card__title {
		margin: 0;
		font: normal normal bold 46px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
	}

	.menu-card__address {
		margin: 0;
		display: flex;
		align-items: flex-start;
		gap: 12px;
		font-size: 18px;
		line-height: 27px;
		font-weight: 500;
	}

	.menu-card__pin {
		width: 24px;
		height: 24px;
		flex: 0 0 auto;
		color: var(--pin-color);
		margin-top: 2px;
	}

	.menu-card__pin svg {
		width: 100%;
		height: 100%;
		display: block;
		fill: currentColor;
	}

	.menu-card__address-text {
		display: block;
	}

	.menu-card__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 212px;
		height: 56px;
		border: 2px solid var(--button-border);
		color: #ffffff;
		text-decoration: none;
		font-weight: 700;
		font-size: 17px;
		letter-spacing: 0.2px;
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.menu-card__button[type='button'] {
		background: transparent;
		font-family: inherit;
		cursor: pointer;
	}

	.menu-card__button:hover,
	.menu-card__button:focus-visible {
		transform: translateY(-2px);
		background-color: rgba(255, 255, 255, 0.08);
	}

	@media (max-width: 1200px) {
		.menu-card {
			padding: 38px 46px;
			min-height: 206px;
		}

		.menu-card__title {
			font-size: 42px;
		}

		.menu-card__address {
			font-size: 17px;
			line-height: 26px;
		}

		.menu-card__button {
			width: 204px;
			height: 54px;
			font-size: 16px;
		}
	}

	@media (max-width: 900px) {
		.menu-card {
			flex-direction: column;
			align-items: flex-start;
			gap: 22px;
			padding: 36px 32px;
		}

		.menu-card__button {
			width: 100%;
			max-width: 300px;
		}
	}

	@media (max-width: 600px) {
		.menu-card {
			padding: 32px 22px;
			min-height: 198px;
		}

		.menu-card__title {
			font-size: 34px;
		}

		.menu-card__address {
			font-size: 16px;
			line-height: 24px;
		}
	}
</style>
