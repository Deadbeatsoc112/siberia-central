---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import jobsHeroUrl from '../assets/fondos/BolsaDetrabajo.png?url';
import jobsHero2xUrl from '../assets/media/Enmascarar grupo 2@2x.png?url';
import { jobsRepo } from '../lib/content';

const db = getDB(Astro.locals);

const jobs = (await jobsRepo.listAll(db)).filter((job) => job.is_active === 1);

const success = Astro.url.searchParams.get('success') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout title="Bolsa de trabajo | La Siberia Central">
	<section class="jobs-hero" aria-labelledby="jobs-title">
		<div
			class="jobs-hero__bg"
			style={`background-image: image-set(url(${jobsHeroUrl}) 1x, url(${jobsHero2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
		<div class="jobs-hero__overlay" aria-hidden="true"></div>
		<div class="jobs-hero__content">
			<h1 id="jobs-title" class="jobs-hero__title">Bolsa de trabajo</h1>
			<p class="jobs-hero__subtitle">Forma parte del equipo y crece con nosotros</p>
		</div>
	</section>
	<!-- Jobs List Section -->
	<section class="jobs-list" id="jobs-section" aria-labelledby="jobs-list-title">
		<div class="jobs-list__inner">
			<h2 id="jobs-list-title" class="sr-only">Vacantes disponibles</h2>
			{jobs.length === 0 ? (
				<p class="jobs-list__empty">En este momento no hay vacantes activas.</p>
			) : (
				<div class="jobs-list__container">
					{jobs.map((job, index) => {
						const bgColor = index % 2 === 0 ? '#1a1a1a' : '#e1454f';
						return (
							<article class="job-card" style={`background-color: ${bgColor};`}>
								<div class="job-card__content">
									<h3 class="job-card__title">{job.title}</h3>
									<div class="job-card__location">
										<svg class="location-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
											<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
											<circle cx="12" cy="10" r="3" stroke-width="2"/>
										</svg>
										<span>{job.location}</span>
									</div>
									<p class="job-card__positions">Puestos disponibles: {job.available_positions || 1}</p>
								</div>
								<div class="job-card__action">
									<button
										class="job-card__button"
										type="button"
										data-job-id={job.id}
										data-job-title={job.title}
										onclick="showApplicationForm(this)"
									>
										Postúlate
									</button>
								</div>
							</article>
						);
					})}
				</div>
			)}
		</div>
	</section>

	<!-- Application Form Section -->
	<section class="jobs-apply hidden" id="form-section" aria-labelledby="apply-title">
		<div class="jobs-apply__inner">
			<!-- Breadcrumb -->
			<nav class="breadcrumb">
				<a href="#" onclick="showJobsList(); return false;">Bolsa de trabajo</a>
				<span class="breadcrumb__separator">/</span>
				<span>Formulario de envío</span>
			</nav>

			<h2 id="apply-title" class="jobs-apply__title">Postúlate Aquí</h2>

			{success && (
				<div class="jobs-apply__success">
					¡Aplicación enviada con éxito! Revisaremos tu perfil y nos pondremos en contacto contigo.
				</div>
			)}
			{error && (
				<div class="jobs-apply__error">
					{error === 'campos-requeridos' && 'Por favor completa todos los campos requeridos.'}
					{error === 'formato-invalido' && 'El archivo debe ser PDF o Word (.doc, .docx).'}
					{error === 'archivo-grande' && 'El archivo es demasiado grande. Máximo 5MB.'}
					{error === 'servidor' && 'Error del servidor. Intenta más tarde.'}
				</div>
			)}

			<form class="jobs-apply__form" action="/api/careers/apply" method="post" enctype="multipart/form-data">
				<input type="hidden" name="job_id" id="selected-job-id" value="0" />

				<div class="jobs-apply__grid">
					<div class="form-field">
						<label for="apply-name" class="form-label">Nombre Completo*</label>
						<input type="text" id="apply-name" name="full_name" class="form-input" required />
					</div>

					<div class="form-field">
						<label for="apply-email" class="form-label">Correo Electrónico*</label>
						<input type="email" id="apply-email" name="email" class="form-input" required />
					</div>

					<div class="form-field">
						<label for="apply-phone" class="form-label">Teléfono*</label>
						<input type="tel" id="apply-phone" name="phone" class="form-input" required />
					</div>

					<div class="form-field">
						<label for="apply-position" class="form-label">Vacante a la que deseas aplicar*</label>
						<input type="text" id="apply-position" name="position" class="form-input" required readonly />
					</div>

					<div class="form-field form-field--full">
						<label for="apply-comments" class="form-label">Comentarios</label>
						<textarea id="apply-comments" name="comments" class="form-input form-textarea" rows="4" placeholder="Escribe cualquier comentario adicional..."></textarea>
					</div>

					<div class="form-field form-field--full">
						<label for="apply-cv" class="form-label">Adjuntar CV*</label>
						<div class="file-input-wrapper">
							<input
								type="file"
								id="apply-cv"
								name="cv_file"
								class="form-input file-input"
								accept=".pdf,.doc,.docx"
								required
							/>
							<div class="file-input-display" id="file-display">
								<span class="file-input-placeholder">No se ha seleccionado ningún archivo</span>
							</div>
						</div>
					</div>
				</div>

				<div class="jobs-apply__actions">
					<button type="submit" class="form-button">Enviar</button>
				</div>
			</form>
		</div>
	</section>

	<script>
		// Helper function to scroll to element properly
		function scrollToElement(element: HTMLElement) {
			// Force browser to recalculate layout
			element.offsetHeight;

			// Use requestAnimationFrame to ensure DOM is ready
			requestAnimationFrame(() => {
				requestAnimationFrame(() => {
					// Get the exact position of the element
					const rect = element.getBoundingClientRect();
					const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
					const targetPosition = rect.top + scrollTop;

					// Scroll to the exact position
					window.scrollTo({
						top: targetPosition,
						behavior: 'smooth'
					});
				});
			});
		}

		// Show application form when clicking "Postúlate"
		(window as any).showApplicationForm = (button: HTMLButtonElement) => {
			const jobId = button.getAttribute('data-job-id');
			const jobTitle = button.getAttribute('data-job-title');

			// Update form fields
			const jobIdInput = document.getElementById('selected-job-id') as HTMLInputElement;
			const positionInput = document.getElementById('apply-position') as HTMLInputElement;

			if (jobIdInput && jobId) jobIdInput.value = jobId;
			if (positionInput && jobTitle) positionInput.value = jobTitle;

			// Hide jobs list, show form
			const jobsSection = document.getElementById('jobs-section');
			const formSection = document.getElementById('form-section');

			if (jobsSection) jobsSection.classList.add('hidden');
			if (formSection) {
				formSection.classList.remove('hidden');
				scrollToElement(formSection);
			}
		};

		// Show jobs list (back from form)
		(window as any).showJobsList = () => {
			const jobsSection = document.getElementById('jobs-section');
			const formSection = document.getElementById('form-section');

			if (formSection) formSection.classList.add('hidden');
			if (jobsSection) {
				jobsSection.classList.remove('hidden');
				scrollToElement(jobsSection);
			}
		};

		// Show selected file name
		const fileInput = document.getElementById('apply-cv') as HTMLInputElement;
		const fileDisplay = document.getElementById('file-display');

		if (fileInput && fileDisplay) {
			fileInput.addEventListener('change', (e) => {
				const input = e.target as HTMLInputElement;
				if (input.files && input.files.length > 0) {
					const fileName = input.files[0].name;
					const fileSize = (input.files[0].size / (1024 * 1024)).toFixed(2);
					fileDisplay.innerHTML = `
						<span class="file-input-name" style="color: #000000 !important;">${fileName}</span>
						<span class="file-input-size" style="color: #333333 !important;">(${fileSize} MB)</span>
					`;
					fileDisplay.classList.add('file-selected');
				} else {
					fileDisplay.innerHTML = '<span class="file-input-placeholder">No se ha seleccionado ningún archivo</span>';
					fileDisplay.classList.remove('file-selected');
				}
			});
		}
	</script>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.hidden {
		display: none !important;
	}

	.jobs-hero {
		position: relative;
		width: 100%;
		height: 752px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #ffffff;
	}

	.jobs-hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		transform: scale(1.02);
	}

	.jobs-hero__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.15);
	}

	.jobs-hero__content {
		position: relative;
		z-index: 2;
		max-width: 820px;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.jobs-hero__title {
		margin: 0;
		font: normal normal bold 64px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
	}

	.jobs-hero__subtitle {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 0.2px;
		text-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
		opacity: 0.98;
	}

	.jobs-list {
		background: #ffffff;
		padding: 120px 0 150px;
		display: flex;
		justify-content: center;
	}

	.jobs-list__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.jobs-list__empty {
		margin: 0;
		font-size: 18px;
		color: #6a6a6a;
	}

	.jobs-list__container {
		display: flex;
		flex-direction: column;
		gap: 24px;
		width: 100%;
	}

	.job-card {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 32px 40px;
		border-radius: 0;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.job-card:hover {
		transform: translateX(4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
	}

	.job-card__content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.job-card__title {
		margin: 0;
		font: normal normal bold 32px/1.2 Campton, 'Montserrat', 'Arial', sans-serif;
		color: #ffffff;
	}

	.job-card__location {
		display: flex;
		align-items: center;
		gap: 8px;
		color: #ffffff;
		font-size: 16px;
		font-weight: 600;
	}

	.job-card__location .location-icon {
		color: #e1454f;
		flex-shrink: 0;
	}

	.job-card__positions {
		margin: 0;
		color: #ffffff;
		font-size: 15px;
		font-weight: 500;
		opacity: 0.95;
	}

	.job-card__action {
		flex-shrink: 0;
	}

	.job-card__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 160px;
		height: 50px;
		padding: 0 32px;
		border: 2px solid #ffffff;
		background: transparent;
		color: #ffffff;
		text-decoration: none;
		font-weight: 700;
		font-size: 16px;
		letter-spacing: 0.3px;
		transition: all 0.25s ease;
		cursor: pointer;
		font-family: inherit;
	}

	.job-card__button:hover,
	.job-card__button:focus-visible {
		background: #ffffff;
		color: #1a1a1a;
	}

	.jobs-apply {
		background: #f6f4ef;
		padding: 80px 24px 120px;
	}

	.jobs-apply__inner {
		max-width: 900px;
		margin: 0 auto;
		background: #ffffff;
		border-radius: 8px;
		padding: 48px;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
	}

	/* Breadcrumb */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 32px;
		font-size: 14px;
		color: #666;
	}

	.breadcrumb a {
		color: #666;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.breadcrumb a:hover {
		color: #8b5a2b;
	}

	.breadcrumb__separator {
		color: #999;
	}

	.jobs-apply__title {
		margin: 0 0 32px;
		font: normal normal bold 42px/1.1 Campton, 'Montserrat', 'Arial', sans-serif;
		color: #8b5a2b;
		text-align: center;
	}

	.jobs-apply__subtitle {
		margin: 0 0 32px;
		font-size: 18px;
		color: #5c5c5c;
		text-align: center;
	}

	.jobs-apply__success {
		padding: 16px 20px;
		background: #d4edda;
		border: 1px solid #c3e6cb;
		color: #155724;
		border-radius: 6px;
		margin-bottom: 24px;
		font-weight: 600;
	}

	.jobs-apply__error {
		padding: 16px 20px;
		background: #f8d7da;
		border: 1px solid #f5c6cb;
		color: #721c24;
		border-radius: 6px;
		margin-bottom: 24px;
		font-weight: 600;
	}

	.jobs-apply__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		margin-bottom: 32px;
	}

	.form-field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.form-field--full {
		grid-column: 1 / -1;
	}

	.form-label {
		font-weight: 600;
		color: #222222;
	}

	.form-input {
		padding: 12px 14px;
		border: 1px solid rgba(0, 0, 0, 0.2);
		font-size: 16px;
		border-radius: 4px;
		font-family: inherit;
	}

	.form-textarea {
		resize: vertical;
		min-height: 100px;
	}

	.file-input-wrapper {
		position: relative;
	}

	.file-input {
		opacity: 0;
		position: absolute;
		width: 100%;
		height: 100%;
		cursor: pointer;
		z-index: 2;
	}

	.file-input-display {
		padding: 12px 14px;
		border: 2px dashed rgba(0, 0, 0, 0.3);
		border-radius: 4px;
		background: #ffffff;
		min-height: 48px;
		display: flex;
		align-items: center;
		gap: 8px;
		transition: all 0.3s ease;
		pointer-events: none;
	}

	.file-input-display:hover {
		border-color: #e1454f;
		background: #fff5f5;
	}

	.file-input-display.file-selected {
		border-color: #4caf50;
		border-style: solid;
		background: #e8f5e9;
	}

	.file-input-placeholder {
		color: #555555;
		font-size: 15px;
	}

	.file-input-name {
		color: #000000;
		font-weight: 600;
		font-size: 15px;
	}

	.file-input-size {
		color: #333333;
		font-size: 14px;
	}

	.jobs-apply__actions {
		display: flex;
		justify-content: center;
	}

	.form-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 180px;
		height: 52px;
		border: 2px solid #8b5a2b;
		background: transparent;
		color: #8b5a2b;
		font-weight: 700;
		font-size: 17px;
		letter-spacing: 0.2px;
		cursor: pointer;
		transition: all 0.25s ease;
		font-family: inherit;
	}

	.form-button:hover {
		transform: translateY(-2px);
		background: #8b5a2b;
		color: #ffffff;
	}

	@media (max-width: 1200px) {
		.jobs-hero {
			height: 680px;
		}

		.jobs-hero__title {
			font-size: 56px;
		}

		.jobs-hero__subtitle {
			font-size: 18px;
		}

		.jobs-list {
			padding: 104px 0 130px;
		}
	}

	@media (max-width: 768px) {
		.jobs-hero {
			height: 560px;
		}

		.jobs-hero__title {
			font-size: 44px;
		}

		.jobs-hero__subtitle {
			font-size: 16px;
		}

		.jobs-list {
			padding: 90px 0 110px;
		}

		.job-card {
			flex-direction: column;
			align-items: flex-start;
			gap: 20px;
			padding: 24px;
		}

		.job-card__title {
			font-size: 26px;
		}

		.job-card__action {
			width: 100%;
		}

		.job-card__button {
			width: 100%;
		}

		.jobs-apply {
			padding: 60px 20px 100px;
		}

		.jobs-apply__inner {
			padding: 32px 24px;
		}

		.jobs-apply__title {
			font-size: 32px;
		}

		.jobs-apply__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
