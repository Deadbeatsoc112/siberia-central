---
// Import menu images
import image1 from '../../image1.png';
import image2 from '../../image2.png';
import image3 from '../../image3.png';
import image4 from '../../image4.png';
import image5 from '../../image5.png';
import image6 from '../../image6.png';
import image7 from '../../image7.png';
import image8 from '../../image8.png';

// Create array of images
const menuImages = [image1, image2, image3, image4, image5, image6, image7, image8];

interface BranchData {
	name: string;
	address: string;
	phones: string[];
}

interface Props {
	menuId: number;
	branchName: string;
	branchSlug: string;
	branch?: BranchData;
}

const { menuId, branchName, branchSlug, branch } = Astro.props as Props;
---

<div class="menu-modal" id={`menu-modal-${menuId}`} data-menu-id={menuId} data-branch-slug={branchSlug}>
	<div class="menu-modal__overlay" data-close-modal></div>
	<div class="menu-modal__container">
		<button class="menu-modal__close" data-close-modal aria-label="Cerrar">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6L6 18M6 6l12 12"/>
			</svg>
		</button>

		<div class="menu-modal__body" aria-label={`Menú ${branchName}`}>
			<div class="menu-images-container">
				{menuImages.map((image, index) => (
					<img 
						src={image.src} 
						alt={`Menú página ${index + 1}`}
						class="menu-image"
						loading={index < 2 ? "eager" : "lazy"}
					/>
				))}
			</div>
		</div>
	</div>
</div>

<style>
	.menu-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
	}

	.menu-modal.is-open {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.92);
		cursor: pointer;
		backdrop-filter: blur(4px);
	}

	.menu-modal__container {
		position: relative;
		width: min(1200px, 98vw);
		max-height: 95vh;
		background: #000000;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
		display: flex;
		flex-direction: column;
	}

	.menu-modal__close {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 52px;
		height: 52px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		background: rgba(0, 0, 0, 0.8);
		color: #fff;
		border-radius: 50%;
		cursor: pointer;
		z-index: 10;
		transition: all 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__close:hover {
		background: #e1454f;
		border-color: #e1454f;
		transform: rotate(90deg) scale(1.1);
	}

	.menu-modal__close svg {
		width: 28px;
		height: 28px;
	}

	.menu-modal__body {
		width: 100%;
		height: 100%;
		overflow-y: auto;
		overflow-x: hidden;
		background: #000000;
		scroll-behavior: smooth;
	}

	.menu-modal__body::-webkit-scrollbar {
		width: 10px;
	}

	.menu-modal__body::-webkit-scrollbar-track {
		background: rgba(0, 0, 0, 0.35);
	}

	.menu-modal__body::-webkit-scrollbar-thumb {
		background: rgba(225, 69, 79, 0.6);
		border-radius: 10px;
	}

	.menu-images-container {
		display: flex;
		flex-direction: column;
		gap: 0;
		width: 100%;
	}

	.menu-image {
		width: 100%;
		height: auto;
		display: block;
		object-fit: contain;
		background: #000000;
	}

	@media (max-width: 900px) {
		.menu-modal__container {
			width: 100vw;
			max-height: 100vh;
			border-radius: 0;
		}

		.menu-modal__close {
			top: 12px;
			right: 12px;
			width: 48px;
			height: 48px;
		}

		.menu-modal__close svg {
			width: 24px;
			height: 24px;
		}
	}

	@media (max-width: 600px) {
		.menu-modal__close {
			width: 44px;
			height: 44px;
		}

		.menu-modal__close svg {
			width: 20px;
			height: 20px;
		}
	}
</style>

<script>
	function initMenuModal() {
		document.querySelectorAll('.menu-modal').forEach((modal) => {
			modal.querySelectorAll('[data-close-modal]').forEach((btn) => {
				btn.addEventListener('click', () => {
					modal.classList.remove('is-open');
					document.body.style.overflow = '';
				});
			});
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				document.querySelectorAll('.menu-modal.is-open').forEach((modal) => {
					modal.classList.remove('is-open');
					document.body.style.overflow = '';
				});
			}
		});
	}

	(window as any).openMenuModal = function (menuId: number) {
		const modal = document.getElementById(`menu-modal-${menuId}`);
		if (!modal) return;

		modal.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMenuModal);
	} else {
		initMenuModal();
	}
</script>
