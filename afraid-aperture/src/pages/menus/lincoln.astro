      // Escala proporcional del canvas en pantallas pequeñas
      const CANVAS_W = 1080;

      function applyScale() {
        const frame = document.getElementById('frame');
        if (!frame) return;

        const sidePad = 32; // debe coincidir con --side-pad
        const available = Math.max(320, window.innerWidth - sidePad * 2);
        const scale = Math.min(1, available / CANVAS_W);

        frame.style.setProperty('--scale', String(scale));
      }

      window.addEventListener('resize', applyScale);
      applyScale();
    </script>

