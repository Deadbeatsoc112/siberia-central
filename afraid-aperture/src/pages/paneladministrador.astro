---
import Layout from '../layouts/Layout.astro';
import { getDB } from '../lib/db';
import { auth } from '../lib/auth';
import { postsRepo, jobsRepo } from '../lib/content';
import { branchesRepo } from '../lib/branches';
import { menusRepo } from '../lib/menus';
import { resumesRepo } from '../lib/resumes';
import { messagesRepo } from '../lib/contactMessages';
import BranchesTab from '../components/admin/BranchesTab.astro';
import PostsTab from '../components/admin/PostsTab.astro';
import JobsTab from '../components/admin/JobsTab.astro';
import MenusTab from '../components/admin/MenusTab.astro';
import MessagesTab from '../components/admin/MessagesTab.astro';
import ResumesTab from '../components/admin/ResumesTab.astro';
import AdminBadge from '../components/admin/AdminBadge.astro';
import AdminCard from '../components/admin/AdminCard.astro';
import AdminButton from '../components/admin/AdminButton.astro';
import AdminInput from '../components/admin/AdminInput.astro';

const db = getDB(Astro.locals);

const user = await auth.getUserFromCookies(db, Astro.cookies);
const tab = user ? Astro.url.searchParams.get('tab') ?? 'branches' : 'login';
const hasError = Astro.url.searchParams.get('error') === '1';

const posts = user && tab === 'posts' ? await postsRepo.listAll(db) : [];
const jobs = user && tab === 'jobs' ? await jobsRepo.listAll(db) : [];
const branches = user && tab === 'branches' ? await branchesRepo.listAll(db) : [];
const menus = user && tab === 'menus' ? await menusRepo.listAll(db) : [];
const resumes = user && tab === 'resumes' ? await resumesRepo.listAll(db) : [];
const messages = user && tab === 'messages' ? await messagesRepo.listAll(db) : [];

const branchesCount = user ? (await branchesRepo.listAll(db)).length : 0;
const resumesPending = user ? await resumesRepo.countByStatus(db, 'pending') : 0;
const messagesUnread = user ? await messagesRepo.countByStatus(db, 'unread') : 0;

const allBranches = user && (tab === 'menus' || tab === 'branches') ? await branchesRepo.listAll(db) : [];
---

<Layout title="Panel Administrador | La Siberia Central">
	<div class="modern-admin">
		{
			!user ? (
				<div class="modern-admin__login">
					<div class="login-card">
						<div class="login-card__header">
							<h1 class="login-card__title">Panel Administrador</h1>
							<p class="login-card__subtitle">La Siberia Central</p>
						</div>

						{hasError && (
							<div class="login-card__error">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<circle cx="12" cy="12" r="10" stroke-width="2" />
									<line x1="12" y1="8" x2="12" y2="12" stroke-width="2" stroke-linecap="round" />
									<line x1="12" y1="16" x2="12.01" y2="16" stroke-width="2" stroke-linecap="round" />
								</svg>
								<span>Usuario o contraseña incorrectos</span>
							</div>
						)}

						<form class="login-card__form" action="/api/admin/login" method="post">
							<div class="login-field">
								<label for="admin-username">Usuario</label>
								<input id="admin-username" name="username" type="text" required placeholder="admin" />
							</div>

							<div class="login-field">
								<label for="admin-password">Contraseña</label>
								<input id="admin-password" name="password" type="password" required placeholder="••••••••" />
							</div>

							<button class="login-card__submit" type="submit">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
									<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									<polyline points="10 17 15 12 10 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									<line x1="15" y1="12" x2="3" y2="12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								Iniciar Sesión
							</button>
						</form>

						<p class="login-card__hint">Credenciales por defecto: admin / admin</p>
					</div>
				</div>
			) : (
				<div class="modern-admin__container">
					<header class="modern-admin__header">
						<div class="admin-header__brand">
							<h1 class="admin-header__title">La Siberia Central</h1>
							<p class="admin-header__subtitle">Panel de Administración</p>
						</div>

						<div class="admin-header__user">
							<div class="admin-header__user-info">
								<span class="admin-header__user-name">{user.username}</span>
								<span class="admin-header__user-role">Administrador</span>
							</div>
							<form action="/api/admin/logout" method="post">
								<button class="admin-header__logout" type="submit">
									<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
										<path
											d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										/>
										<polyline points="16 17 21 12 16 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
										<line x1="21" y1="12" x2="9" y2="12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
									Cerrar Sesión
								</button>
							</form>
						</div>
					</header>

					<nav class="modern-admin__tabs">
						<a class={`tab-link ${tab === 'branches' ? 'tab-link--active' : ''}`} href="?tab=branches">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path
									d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
								<polyline points="9 22 9 12 15 12 15 22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						<span>Sucursales</span>
						<AdminBadge variant="info" size="small">{branchesCount}</AdminBadge>
					</a>						<a class={`tab-link ${tab === 'menus' ? 'tab-link--active' : ''}`} href="?tab=menus">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path d="M3 3h18v18H3V3z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								<path d="M3 9h18M9 21V9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span>Menús</span>
						</a>

						<a class={`tab-link ${tab === 'resumes' ? 'tab-link--active' : ''}`} href="?tab=resumes">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path
									d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
								<polyline points="14 2 14 8 20 8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								<line x1="16" y1="13" x2="8" y2="13" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								<line x1="16" y1="17" x2="8" y2="17" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span>Hojas de Vida</span>
							{resumesPending > 0 && (
								<AdminBadge variant="primary" size="small" pulse>
									{resumesPending}
								</AdminBadge>
							)}
						</a>

						<a class={`tab-link ${tab === 'messages' ? 'tab-link--active' : ''}`} href="?tab=messages">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path
									d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span>Mensajes</span>
							{messagesUnread > 0 && (
								<AdminBadge variant="warning" size="small" pulse>
									{messagesUnread}
								</AdminBadge>
							)}
						</a>

						<a class={`tab-link ${tab === 'jobs' ? 'tab-link--active' : ''}`} href="?tab=jobs">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<rect x="2" y="7" width="20" height="14" rx="2" ry="2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
								<path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
							<span>Vacantes</span>
						</a>

						<a class={`tab-link ${tab === 'posts' ? 'tab-link--active' : ''}`} href="?tab=posts">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
								<path
									d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
							<span>Blog</span>
						</a>

					</nav>

					<main class="modern-admin__content">
						{tab === 'branches' && <BranchesTab branches={branches} />}

						{tab === 'menus' && <MenusTab menus={menus} branches={allBranches} locals={Astro.locals} />}

						{tab === 'resumes' && <ResumesTab resumes={resumes} />}

						{tab === 'messages' && <MessagesTab messages={messages} />}

						{tab === 'jobs' && <JobsTab jobs={jobs} />}

						{tab === 'posts' && <PostsTab posts={posts} />}
					</main>
				</div>
			)
		}
	</div>
</Layout>

<style>
	/* Global Admin Styles */
	.modern-admin {
		min-height: 100vh;
		background: linear-gradient(135deg, #f6f4ef 0%, #faf9f6 100%);
		font-family: 'Inter', -apple-system, sans-serif;
	}

	/* Login Screen */
	.modern-admin__login {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 24px;
		background: linear-gradient(135deg, #d4534f 0%, #8b5a2b 100%);
		position: relative;
		overflow: hidden;
	}

	.modern-admin__login::before {
		content: '';
		position: absolute;
		top: -50%;
		right: -50%;
		width: 200%;
		height: 200%;
		background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
		background-size: 50px 50px;
		animation: driftBackground 20s linear infinite;
	}

	@keyframes driftBackground {
		0% {
			transform: translate(0, 0);
		}
		100% {
			transform: translate(50px, 50px);
		}
	}

	.login-card {
		position: relative;
		width: 100%;
		max-width: 440px;
		background: rgba(255, 255, 255, 0.98);
		backdrop-filter: blur(20px);
		border-radius: 24px;
		padding: 48px;
		box-shadow:
			0 20px 60px rgba(0, 0, 0, 0.3),
			0 0 0 1px rgba(255, 255, 255, 0.1) inset;
		animation: loginCardAppear 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@keyframes loginCardAppear {
		from {
			opacity: 0;
			transform: translateY(30px) scale(0.95);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.login-card__header {
		text-align: center;
		margin-bottom: 32px;
	}

	.login-card__title {
		margin: 0 0 8px;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 36px;
		font-weight: 900;
		color: #1a1a1a;
		letter-spacing: -1px;
	}

	.login-card__subtitle {
		margin: 0;
		font-size: 16px;
		color: #666;
		font-weight: 500;
	}

	.login-card__error {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 16px;
		background: linear-gradient(135deg, #fee2e2 0%, #fecaca 100%);
		border: 2px solid #ef4444;
		border-radius: 12px;
		color: #991b1b;
		font-weight: 600;
		margin-bottom: 24px;
		animation: shake 0.5s;
	}

	@keyframes shake {
		0%,
		100% {
			transform: translateX(0);
		}
		25% {
			transform: translateX(-10px);
		}
		75% {
			transform: translateX(10px);
		}
	}

	.login-card__form {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.login-field {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.login-field label {
		font-size: 14px;
		font-weight: 600;
		color: #2a2a2a;
	}

	.login-field input {
		padding: 14px 16px;
		border: 2px solid #e8e8e8;
		border-radius: 12px;
		font-size: 16px;
		transition: all 0.2s ease;
		font-family: inherit;
	}

	.login-field input:focus {
		outline: none;
		border-color: #d4534f;
		box-shadow: 0 0 0 4px rgba(212, 83, 79, 0.1);
	}

	.login-card__submit {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		padding: 16px;
		background: linear-gradient(135deg, #d4534f 0%, #b33832 100%);
		color: #ffffff;
		border: none;
		border-radius: 12px;
		font-size: 16px;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		margin-top: 8px;
		box-shadow: 0 4px 14px rgba(212, 83, 79, 0.4);
	}

	.login-card__submit:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 20px rgba(212, 83, 79, 0.5);
	}

	.login-card__submit:active {
		transform: translateY(0);
	}

	.login-card__hint {
		margin: 20px 0 0;
		text-align: center;
		font-size: 13px;
		color: #999;
	}

	/* Main Container */
	.modern-admin__container {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	/* Header */
	.modern-admin__header {
		background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
		border-bottom: 2px solid #f0f0f0;
		padding: 24px 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(10px);
	}

	.admin-header__brand {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.admin-header__title {
		margin: 0;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 28px;
		font-weight: 900;
		color: #1a1a1a;
		letter-spacing: -0.5px;
	}

	.admin-header__subtitle {
		margin: 0;
		font-size: 13px;
		color: #666;
		font-weight: 500;
	}

	.admin-header__user {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.admin-header__user-info {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 2px;
	}

	.admin-header__user-name {
		font-weight: 700;
		color: #1a1a1a;
		font-size: 15px;
	}

	.admin-header__user-role {
		font-size: 12px;
		color: #999;
	}

	.admin-header__logout {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 18px;
		background: transparent;
		border: 2px solid #e0e0e0;
		border-radius: 10px;
		color: #666;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
		font-family: inherit;
		font-size: 14px;
	}

	.admin-header__logout:hover {
		border-color: #d4534f;
		color: #d4534f;
		background: #fff5f5;
	}

	/* Tabs Navigation */
	.modern-admin__tabs {
		background: #ffffff;
		padding: 20px 40px;
		display: flex;
		gap: 8px;
		overflow-x: auto;
		border-bottom: 2px solid #f0f0f0;
		position: sticky;
		top: 76px;
		z-index: 90;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
	}

	.tab-link {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 20px;
		background: transparent;
		border: 2px solid transparent;
		border-radius: 12px;
		text-decoration: none;
		color: #666;
		font-weight: 600;
		font-size: 15px;
		transition: all 0.2s ease;
		white-space: nowrap;
	}

	.tab-link svg {
		flex-shrink: 0;
	}

	.tab-link:hover {
		background: #f8f8f8;
		color: #1a1a1a;
	}

	.tab-link--active {
		background: linear-gradient(135deg, #d4534f 0%, #b33832 100%);
		color: #ffffff;
		border-color: #d4534f;
		box-shadow: 0 4px 12px rgba(212, 83, 79, 0.3);
	}

	.tab-link--active:hover {
		background: linear-gradient(135deg, #d4534f 0%, #b33832 100%);
	}

	/* Main Content */
	.modern-admin__content {
		flex: 1;
		padding: 40px;
		animation: fadeInContent 0.5s ease-out;
	}

	@keyframes fadeInContent {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.tab-content {
		max-width: 1400px;
		margin: 0 auto;
	}

	/* Responsive */
	@media (max-width: 1024px) {
		.modern-admin__header {
			padding: 20px 24px;
		}

		.modern-admin__tabs {
			padding: 16px 24px;
		}

		.modern-admin__content {
			padding: 24px;
		}
	}

	@media (max-width: 768px) {
		.login-card {
			padding: 32px 24px;
		}

		.modern-admin__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 16px;
		}

		.admin-header__user {
			width: 100%;
			justify-content: space-between;
		}

		.modern-admin__tabs {
			gap: 6px;
		}

		.tab-link {
			padding: 10px 16px;
			font-size: 14px;
		}

		.tab-link span {
			display: none;
		}

		.modern-admin__content {
			padding: 20px 16px;
		}
	}
</style>
