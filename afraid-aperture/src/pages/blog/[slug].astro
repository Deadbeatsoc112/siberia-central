---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';
import { postsRepo } from '../../lib/content';

const db = getDB(Astro.locals);

const slug = Astro.params.slug ?? '';
const post = slug ? await postsRepo.getBySlug(db, slug) : undefined;

if (!post || post.published !== 1) {
	Astro.response.status = 404;
}
---

<Layout title={`${post ? post.title : 'Publicacion no encontrada'} | Blog`}>
	<section class="post">
		<div class="post__inner">
			{post && post.published === 1 ? (
				<article class="post-card">
					{post.image_url && (
						<img class="post-card__image" src={post.image_url} alt={post.title} loading="eager" />
					)}
					<header class="post-card__header">
						<h1 class="post-card__title">{post.title}</h1>
						<p class="post-card__excerpt">{post.excerpt}</p>
					</header>
					<div class="post-card__content">
						{post.content.split('\n').map((line) => (
							<p>{line}</p>
						))}
					</div>
				</article>
			) : (
				<div class="post-card post-card--empty">
					<h1 class="post-card__title">Publicacion no encontrada</h1>
					<p class="post-card__excerpt">La entrada que buscas no existe o no esta publicada.</p>
					<a class="post-card__back" href="/blog">Volver al blog</a>
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.post {
		background: #f6f4ef;
		padding: 110px 24px 140px;
		display: flex;
		justify-content: center;
	}

	.post__inner {
		width: min(1100px, 100%);
	}

	.post-card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 26px;
		padding: 40px 46px 52px;
	}

	.post-card--empty {
		align-items: flex-start;
	}

	.post-card__image {
		width: 100%;
		height: 320px;
		object-fit: cover;
		display: block;
		border-radius: 6px;
	}

	.post-card__header {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.post-card__title {
		margin: 0;
		font: normal normal bold 46px/1.05 Campton, 'Montserrat', 'Arial', sans-serif;
		color: #161615;
	}

	.post-card__excerpt {
		margin: 0;
		font-size: 19px;
		color: #5a5a5a;
	}

	.post-card__content {
		display: flex;
		flex-direction: column;
		gap: 14px;
		font-size: 18px;
		line-height: 30px;
		color: #2b2b2b;
	}

	.post-card__content p {
		margin: 0;
	}

	.post-card__back {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 18px;
		border: 2px solid #161615;
		text-decoration: none;
		font-weight: 700;
		color: #161615;
		margin-top: 8px;
	}

	@media (max-width: 900px) {
		.post {
			padding: 90px 16px 110px;
		}

		.post-card {
			padding: 34px 28px 44px;
		}

		.post-card__title {
			font-size: 38px;
		}
	}
</style>
