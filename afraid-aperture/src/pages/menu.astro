---
import Layout from '../layouts/Layout.astro';
import menuHeroUrl from '../assets/media/Enmascarar grupo 19.png?url';
import menuHero2xUrl from '../assets/media/Enmascarar grupo 19@2x.png?url';
import MenuModuleCard from '../components/MenuModuleCard.astro';

const menuModules = [
	{
		name: 'Menu Central',
		address: 'Av. Rodrigo Gomez 623, Col. Central, Monterrey Nuevo Leon CP 64190',
		href: '/menu?central',
	},
	{
		name: 'Menu San Pedro',
		address: 'Av. Vasconcelos 150, Del Valle, San Pedro Garza Garcia NL 66220',
		href: '/menu?san-pedro',
	},
	{
		name: 'Menu Cumbres',
		address: 'Paseo de los Leones 900, Cumbres 3er Sector, Monterrey NL 64619',
		href: '/menu?cumbres',
	},
	{
		name: 'Menu Apodaca',
		address: 'Av. Concordia 1200, Apodaca Centro, Apodaca NL 66600',
		href: '/menu?apodaca',
	},
	{
		name: 'Menu Guadalupe',
		address: 'Av. Miguel Aleman 2200, Linda Vista, Guadalupe NL 67130',
		href: '/menu?guadalupe',
	},
	{
		name: 'Menu Escobedo',
		address: 'Av. Raul Salinas 500, Hacienda del Topo, Escobedo NL 66055',
		href: '/menu?escobedo',
	},
	{
		name: 'Menu Santa Catarina',
		address: 'Blvd. Diaz Ordaz 2000, Santa Catarina Centro, Santa Catarina NL 66350',
		href: '/menu?santa-catarina',
	},
	{
		name: 'Menu San Nicolas',
		address: 'Av. Universidad 800, Anahuac, San Nicolas de los Garza NL 66450',
		href: '/menu?san-nicolas',
	},
	{
		name: 'Menu Contry',
		address: 'Av. Alfonso Reyes 3000, Contry, Monterrey NL 64860',
		href: '/menu?contry',
	},
	{
		name: 'Menu Tec',
		address: 'Av. Eugenio Garza Sada 2500, Tecnologico, Monterrey NL 64849',
		href: '/menu?tec',
	},
	{
		name: 'Menu Linda Vista',
		address: 'Av. Miguel Aleman 3500, Linda Vista, Guadalupe NL 67123',
		href: '/menu?linda-vista',
	},
	{
		name: 'Menu La Fe',
		address: 'Av. Romulo Garza 500, La Fe, San Nicolas de los Garza NL 66477',
		href: '/menu?la-fe',
	},
	{
		name: 'Menu Sendero',
		address: 'Av. Sendero 1000, Valle de las Palmas, Escobedo NL 66072',
		href: '/menu?sendero',
	},
	{
		name: 'Menu Juarez',
		address: 'Av. Eloy Cavazos 7600, Juarez Centro, Juarez NL 67250',
		href: '/menu?juarez',
	},
	{
		name: 'Menu Cadereyta',
		address: 'Carretera a Reynosa 120, Cadereyta Jimenez Centro, Cadereyta NL 67480',
		href: '/menu?cadereyta',
	},
	{
		name: 'Menu Garcia',
		address: 'Av. Heberto Castillo 400, Garcia Centro, Garcia NL 66000',
		href: '/menu?garcia',
	},
	{
		name: 'Menu Zuazua',
		address: 'Av. Hidalgo 210, Zuazua Centro, Zuazua NL 65750',
		href: '/menu?zuazua',
	},
	{
		name: 'Menu Santiago',
		address: 'Av. Juarez 150, Santiago Centro, Santiago NL 67300',
		href: '/menu?santiago',
	},
	{
		name: 'Menu Allende',
		address: 'Av. Benito Juarez 90, Allende Centro, Allende NL 67350',
		href: '/menu?allende',
	},
	{
		name: 'Menu Montemorelos',
		address: 'Av. Capitan Alonso de Leon 300, Montemorelos Centro, Montemorelos NL 67500',
		href: '/menu?montemorelos',
	},
];

const featuredMenus = menuModules.slice(0, 5);
const remainingMenus = menuModules.slice(5);
---

<Layout title="Menu | La Siberia Central">
	<section class="menu-hero" aria-labelledby="menu-title">
		<div
			class="menu-hero__bg"
			style={`background-image: image-set(url(${menuHeroUrl}) 1x, url(${menuHero2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
		<div class="menu-hero__overlay" aria-hidden="true"></div>
		<div class="menu-hero__content">
			<h1 id="menu-title" class="menu-hero__title">Menú</h1>
			<p class="menu-hero__subtitle">
				Recetas con historia, hechas para compartir con tu gente
			</p>
		</div>
	</section>
	<section class="menu-list" aria-labelledby="menu-list-title">
		<div class="menu-list__inner">
			<h2 id="menu-list-title" class="sr-only">Sucursales y modulos de menu</h2>
			<div class="menu-list__grid">
				{featuredMenus.map((item, index) => (
					<MenuModuleCard {...item} index={index} />
				))}
			</div>
			{remainingMenus.length > 0 && (
				<details class="menu-list__accordion">
					<summary class="menu-list__summary">Ver todas las sucursales</summary>
					<div class="menu-list__grid menu-list__grid--more">
						{remainingMenus.map((item, index) => (
							<MenuModuleCard {...item} index={index + featuredMenus.length} />
						))}
					</div>
				</details>
			)}
		</div>
	</section>
</Layout>

<style>
	.menu-hero {
		position: relative;
		width: 100%;
		height: 752px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #ffffff;
	}

	.menu-hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		filter: grayscale(1) contrast(1.05) brightness(0.72);
		transform: scale(1.02);
	}

	.menu-hero__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.45);
	}

	.menu-hero__content {
		position: relative;
		z-index: 2;
		max-width: 820px;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.menu-hero__title {
		margin: 0;
		font: normal normal bold 64px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
	}

	.menu-hero__subtitle {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 0.2px;
		text-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
		opacity: 0.98;
	}

	@media (max-width: 1200px) {
		.menu-hero {
			height: 680px;
		}

		.menu-hero__title {
			font-size: 56px;
		}

		.menu-hero__subtitle {
			font-size: 18px;
		}
	}

	@media (max-width: 768px) {
		.menu-hero {
			height: 560px;
		}

		.menu-hero__title {
			font-size: 44px;
		}

		.menu-hero__subtitle {
			font-size: 16px;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.menu-list {
		background: #ffffff;
		padding: 124px 0 160px;
		display: flex;
		justify-content: center;
	}

	.menu-list__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 48px;
		box-sizing: border-box;
	}

	.menu-list__grid {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 48px;
		align-items: center;
	}

	.menu-list__grid--more {
		margin-top: 24px;
	}

	.menu-list__accordion {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 34px;
	}

	.menu-list__accordion > .menu-list__summary {
		order: 1;
	}

	.menu-list__accordion > .menu-list__grid--more {
		order: 2;
	}

	.menu-list__accordion[open] {
		gap: 26px;
	}

	.menu-list__accordion[open] > .menu-list__grid--more {
		order: 1;
	}

	.menu-list__accordion[open] > .menu-list__summary {
		order: 2;
		margin-top: 6px;
	}

	.menu-list__summary {
		list-style: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 320px;
		padding: 16px 28px;
		border: 2px solid #161615;
		background: #ffffff;
		color: #161615;
		font-weight: 700;
		font-size: 18px;
		letter-spacing: 0.2px;
		cursor: pointer;
		user-select: none;
		transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
		text-align: center;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
		position: relative;
	}

	.menu-list__summary:hover,
	.menu-list__summary:focus-visible {
		transform: translateY(-1px);
	}

	.menu-list__summary::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -22px;
		width: 12px;
		height: 12px;
		border-left: 3px solid #e1454f;
		border-bottom: 3px solid #e1454f;
		transform: translateX(-50%) rotate(-45deg);
		animation: menu-arrow-down 1.1s ease-in-out infinite;
	}

	.menu-list__accordion[open] .menu-list__summary {
		background: #161615;
		color: #ffffff;
	}

	.menu-list__accordion[open] .menu-list__summary::after {
		animation-name: menu-arrow-up;
	}

	.menu-list__summary::-webkit-details-marker {
		display: none;
	}

	@keyframes menu-arrow-down {
		0% {
			transform: translate(-50%, -4px) rotate(-45deg);
		}
		50% {
			transform: translate(-50%, 4px) rotate(-45deg);
		}
		100% {
			transform: translate(-50%, -4px) rotate(-45deg);
		}
	}

	@keyframes menu-arrow-up {
		0% {
			transform: translate(-50%, 4px) rotate(135deg);
		}
		50% {
			transform: translate(-50%, -4px) rotate(135deg);
		}
		100% {
			transform: translate(-50%, 4px) rotate(135deg);
		}
	}

	@media (max-width: 1200px) {
		.menu-list {
			padding: 110px 0 136px;
		}

		.menu-list__grid {
			gap: 40px;
		}
	}

	@media (max-width: 768px) {
		.menu-list {
			padding: 92px 0 112px;
		}

		.menu-list__inner {
			gap: 34px;
		}

		.menu-list__grid {
			gap: 32px;
		}

		.menu-list__summary {
			width: 100%;
			min-width: 0;
			max-width: 380px;
		}
	}
</style>
