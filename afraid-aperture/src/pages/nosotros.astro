		}
	}

	@media (max-width: 375px) {
		.timeline__content {
			padding: 50px 0 16px;
			gap: 16px;
		}

		.timeline__title {
			padding-left: 12px;
			padding-right: 12px;
			font-size: 26px;
		}

		.timeline__rule {
			display: none;
		}

		.timeline__track {
			padding: 0 12px;
			gap: 14px;
		}

		.timeline__item {
			padding: 10px 10px 12px;
			border-radius: 10px;
		}

		.timeline__year {
			font-size: 20px;
		}

		.timeline__label {
			font-size: 13px;
		}

		.timeline__text {
			font-size: 12px;
			line-height: 18px;
		}
	}

	.branches {
		position: relative;
		width: 100%;
		height: 585px;
		overflow: hidden;
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.branches__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		transform: scale(1.02);
	}

	.branches__overlay {
		position: absolute;
		inset: 0;
		background: none;
	}

	.branches__decor {
		position: absolute;
		top: 40px;
		right: 36px;
		width: 90px;
		height: 300px;
		background-repeat: no-repeat;
		background-position: center;
		background-size: contain;
		transform: rotate(90deg);
		opacity: 0.7;
