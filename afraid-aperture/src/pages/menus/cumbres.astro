---
import fullMenuUrl from '../../assets/media/MENUSCOMPLETOS/CUMBRES.png?url';
import grupo139BgUrl from '../../assets/media/AMERICAS-menu/Grupo 139.svg?url';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Menu | Cumbres | La Siberia Central</title>
  </head>

  <body>
    <main class="menu-page">
      <div class="menu-wrap">
        <a id="menu-top" class="menu-top-anchor" aria-hidden="true"></a>
        <a class="back-link" href="/menu-sucursales" aria-label="Volver a menus">
          <span aria-hidden="true">&larr;</span>
          Menus
        </a>

        <div class="menu-image-frame">

          <img src={fullMenuUrl} alt="Menu completo Cumbres" class="menu-image" loading="eager" />

                    <nav class="menu-hotspots-top" aria-label="Secciones del menu">
            <a class="menu-hotspot menu-hotspot--tostadas" href="#menu-tostadas" aria-label="Ir a Tostadas"></a>
            <a class="menu-hotspot menu-hotspot--tacos" href="#menu-tacos" aria-label="Ir a Tacos"></a>
            <a class="menu-hotspot menu-hotspot--caldos" href="#menu-caldos" aria-label="Ir a Caldos"></a>
            <a class="menu-hotspot menu-hotspot--combos" href="#menu-combos" aria-label="Ir a Combos"></a>
            <a class="menu-hotspot menu-hotspot--bebidas" href="#menu-bebidas" aria-label="Ir a Bebidas"></a>
          </nav>

          <span id="menu-tostadas" class="menu-section-anchor" style="top: 17.6%;" aria-hidden="true"></span>

          <span id="menu-tacos" class="menu-section-anchor" style="top: 30.4%;" aria-hidden="true"></span>

          <span id="menu-caldos" class="menu-section-anchor" style="top: 41.8%;" aria-hidden="true"></span>

          <span id="menu-combos" class="menu-section-anchor" style="top: 63.8%;" aria-hidden="true"></span>

          <span id="menu-bebidas" class="menu-section-anchor" style="top: 82.4%;" aria-hidden="true"></span>

        </div>
      </div>

      <a class="menu-float-btn" href="#menu-top" aria-label="Volver al inicio del menu">
        <img src={grupo139BgUrl} alt="" aria-hidden="true" />
      </a>
    </main>
    <script is:inline>
      (() => {
        const frame = document.querySelector('.menu-image-frame');
        if (!(frame instanceof HTMLElement)) return;

        const sectionPercentByHash = {
          "#menu-tostadas": 17.6,
          "#menu-tacos": 30.4,
          "#menu-caldos": 41.8,
          "#menu-combos": 63.8,
          "#menu-bebidas": 82.4,
        };

        const scrollToHash = (hash) => {
          const percent = sectionPercentByHash[hash];
          if (typeof percent !== "number") return;

          const frameRect = frame.getBoundingClientRect();
          const targetTop = window.scrollY + frameRect.top + frameRect.height * (percent / 100) - 8;
          window.scrollTo({ top: Math.max(0, targetTop), behavior: "smooth" });
          history.replaceState(null, "", hash);
        };

        const links = Array.from(document.querySelectorAll('.menu-hotspot[href^="#"]'));
        links.forEach((link) => {
          link.addEventListener('click', (event) => {
            const hash = link.getAttribute('href');
            if (!hash) return;
            event.preventDefault();
            scrollToHash(hash);
          });
        });
      })();
    </script>
  </body>

  <style>
    :global(body) {
      margin: 0;
      background: #111111;
      color: #f5f5f5;
      font-family: 'Campton', 'Segoe UI', Arial, sans-serif;
    }

    .menu-page {
      min-height: 100vh;
      padding: 20px 12px 32px;
      box-sizing: border-box;
      display: flex;
      justify-content: center;
    }

    .menu-wrap {
      width: min(1080px, 100%);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .back-link {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #ffffff;
      font-size: 20px;
      font-weight: 700;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.12);
      transition: background-color 0.2s ease;
    }

    .back-link:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    .menu-image {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 14px;
      box-shadow: 0 16px 42px rgba(0, 0, 0, 0.35);
    }
    :global(html) {
      scroll-behavior: smooth;
    }

    .menu-image-frame {
      position: relative;
      width: 100%;
      line-height: 0;
    }
    .menu-hotspots-top {
      position: absolute;
      inset: 0;
      z-index: 12;
      pointer-events: none;
    }

    .menu-hotspot {
      position: absolute;
      display: block;
      text-decoration: none;
      border-radius: 999px;
      cursor: pointer;
      pointer-events: auto;
      background: transparent;
      transform-origin: center;
    }

    .menu-hotspot--bebidas {
      left: 10.5%;
      top: 2.0%;
      width: 14.5%;
      height: 1.3%;
      transform: rotate(52deg);
    }

    .menu-hotspot--tacos {
      left: 16.0%;
      top: 2.9%;
      width: 18.0%;
      height: 1.2%;
      transform: rotate(34deg);
    }

    .menu-hotspot--combos {
      left: 39.0%;
      top: 3.2%;
      width: 23.0%;
      height: 1.0%;
      transform: rotate(-6deg);
    }

    .menu-hotspot--tostadas {
      left: 63.0%;
      top: 2.9%;
      width: 23.0%;
      height: 1.35%;
      transform: rotate(-34deg);
    }

    .menu-hotspot--caldos {
      left: 72.5%;
      top: 2.0%;
      width: 19.0%;
      height: 1.2%;
      transform: rotate(-21deg);
    }

    @media (hover: hover) {
      .menu-hotspot:hover {
        outline: 1px dashed rgba(255, 255, 255, 0.25);
        outline-offset: 1px;
      }
    }

    .menu-hotspot:focus-visible {
      outline: 2px solid rgba(255, 255, 255, 0.9);
      outline-offset: 1px;
    }

    @media (max-width: 700px) {
      .menu-hotspot--bebidas { left: 9.8%; top: 1.8%; width: 16.2%; height: 1.55%; }
      .menu-hotspot--tacos { left: 15.0%; top: 2.7%; width: 20.5%; height: 1.55%; }
      .menu-hotspot--combos { left: 37.7%; top: 3.0%; width: 26.0%; height: 1.4%; }
      .menu-hotspot--tostadas { left: 61.5%; top: 2.7%; width: 25.8%; height: 1.7%; }
      .menu-hotspot--caldos { left: 71.2%; top: 1.8%; width: 21.4%; height: 1.55%; }
    }

    .menu-section-anchor {
      position: absolute;
      left: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
      scroll-margin-top: 12px;
    }

    .menu-top-anchor {
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .menu-float-btn {
      display: block;
      position: fixed;
      right: max(12px, calc((100vw - 1080px) / 2 + 10px));
      bottom: 18px;
      width: 60px;
      height: 60px;
      z-index: 220;
      cursor: pointer;
      border-radius: 50%;
      overflow: hidden;
      background: transparent;
      box-shadow: none;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.2s ease;
    }

    .menu-float-btn img {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 50%;
      filter: none;
      box-shadow: none;
    }

    .menu-float-btn:hover {
      transform: translateY(-1px);
    }

    .menu-float-btn:focus-visible {
      outline: 2px solid rgba(255, 255, 255, 0.85);
      outline-offset: 3px;
    }

    @media (max-width: 700px) {
      .menu-float-btn {
        right: 10px;
        bottom: 14px;
        width: 52px;
        height: 52px;
      }

      .menu-page {
        padding: 14px 8px 20px;
      }

      .back-link {
        font-size: 18px;
      }

      .menu-image {
        border-radius: 10px;
      }
    }
  </style>
</html>

