              <br />
              Nuevo León CP 67174
            </div>
            <div class="header-phones">
              <div>8125270225</div>
            </div>
          </div>

          <div class="abs section-title tostadas-title" id="tostadas">TOSTADAS</div>
          <img src={grupo151Url} alt="" class="abs divider-1" />
          <section class="section tostadas-section">
            <div class="menu-items">
              <div class="menu-item">
                <div class="menu-item__name">TOSTADA DE PECHUGA</div>
                <div class="menu-item__price">$ 93.00</div>
                <div class="menu-item__desc">HEN BREAST TOSTADA</div>
              </div>
              <div class="menu-item">
                <div class="menu-item__name">TOSTADA DE PECHUGA JUNIOR</div>
                <div class="menu-item__price">$ 64.00</div>
                <div class="menu-item__desc">JUNIOR HEN BREAST TOSTADA</div>
              </div>
              <div class="menu-item">
                <div class="menu-item__name">TOSTADA DE PIERNA</div>
                <div class="menu-item__price">$ 76.00</div>
                <div class="menu-item__desc">HEN LEG TOSTADA</div>
              </div>
              <div class="menu-item">
                <div class="menu-item__name">TOSTADA DE PIERNA JUNIOR</div>
                <div class="menu-item__price">$ 51.00</div>
                <div class="menu-item__desc">JUNIOR HEN LEG TOSTADA</div>
              </div>
