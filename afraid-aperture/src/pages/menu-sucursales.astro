const featuredMenus = menuModules.slice(0, 5);
const remainingMenus = menuModules.slice(5);
---

<Layout title="Menú | La S central">
	<section class="menu-hero" aria-labelledby="menu-title">
		<div
			class="menu-hero__bg menu-hero__bg--image"
			style={`background-image: image-set(url(${menuHero2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
		<div
			class="menu-hero__bg menu-hero__bg--svg"
			style={`background-image: url(${menuHeroOverlayUrl});`}
			aria-hidden="true"
		></div>
		<div class="menu-hero__overlay" aria-hidden="true"></div>
		<div class="menu-hero__content">
			<h1 id="menu-title" class="menu-hero__title">Menú</h1>
			<p class="menu-hero__subtitle">
				Recetas con historia, hechas para compartir con tu gente
			</p>
		</div>
	</section>
	<section class="menu-list" aria-labelledby="menu-list-title">
		<div class="menu-list__inner">
			<h2 id="menu-list-title" class="sr-only">Sucursales y módulos de menú</h2>
			<div class="menu-list__grid">
				{featuredMenus.map((item, index) => (
					<MenuModuleCard {...item} index={index} />
				))}
			</div>
			{remainingMenus.length > 0 && (
				<details class="menu-list__accordion">
					<summary class="menu-list__summary">Ver todas las sucursales</summary>
					<div class="menu-list__grid menu-list__grid--more">
						{remainingMenus.map((item, index) => (
							<MenuModuleCard {...item} index={index + featuredMenus.length} />
						))}
					</div>
				</details>
			)}
		</div>
	</section>
</Layout>

<style>
	.menu-hero {
		position: relative;
		width: 100%;
		height: 752px;
		overflow: hidden;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #ffffff;
	}

.menu-hero__bg{
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
}

/* overlay removido para mostrar foto a color */
.menu-hero__bg::before{
  content: none;
}

/* si esto es un elemento encima o una capa extra, asegúrate que quede debajo del overlay */
.menu-hero__bg--image{
  transform: scale(1.02);
  z-index: 0;
}

	.menu-hero__bg--svg {
		transform: none;
		transform-origin: none;
		background-size: 100% auto;
		background-repeat: no-repeat;
		background-position: center top;
		z-index: 2;
	}

	.menu-hero__overlay {
		position: absolute;
		inset: 0;
		background: none;
		z-index: 1;
	}

	.menu-hero__content {
		position: relative;
		z-index: 3;
		max-width: 820px;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.menu-hero__title {
		margin: 0;
		font: normal normal bold 64px/1 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
	}

	.menu-hero__subtitle {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 0.2px;
		text-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
		opacity: 0.98;
	}

	@media (max-width: 1200px) {
		.menu-hero {
			height: 680px;
		}

		.menu-hero__bg--svg {
			background-size: 130% auto;
			background-position: center top;
		}

		.menu-hero__title {
			font-size: 56px;
		}

		.menu-hero__subtitle {
			font-size: 18px;
		}
	}

	@media (max-width: 768px) {
		.menu-hero {
			height: 560px;
		}

		.menu-hero__bg--svg {
			background-size: 160% auto;
			background-position: center top;
		}

		.menu-hero__title {
			font-size: 44px;
		}

		.menu-hero__subtitle {
			font-size: 16px;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.menu-list {
		background: #ffffff;
		padding: 124px 0 160px;
		display: flex;
		justify-content: center;
	}

	.menu-list__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 48px;
		box-sizing: border-box;
	}

	.menu-list__grid {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 48px;
		align-items: stretch;
	}

	.menu-list__grid--more {
		margin-top: 24px;
	}

	.menu-list__accordion {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 34px;
	}

	.menu-list__summary {
		align-self: center;
	}

	.menu-list__accordion > .menu-list__summary {
		order: 1;
	}

	.menu-list__accordion > .menu-list__grid--more {
		order: 2;
	}

	.menu-list__accordion[open] {
		gap: 26px;
	}

	.menu-list__accordion[open] > .menu-list__grid--more {
		order: 1;
	}

	.menu-list__accordion[open] > .menu-list__summary {
		order: 2;
		margin-top: 6px;
	}

	.menu-list__summary {
		list-style: none;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 240px;
		padding: 12px 22px;
		border: 2px solid #161615;
		background: #ffffff;
		color: #161615;
		font-weight: 700;
		font-size: 16px;
		letter-spacing: 0.2px;
		cursor: pointer;
		user-select: none;
		transition: background-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
		text-align: center;
		box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
		position: relative;
	}

	.menu-list__summary:hover,
	.menu-list__summary:focus-visible {
		transform: translateY(-1px);
	}

	.menu-list__summary::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -22px;
		width: 12px;
		height: 12px;
		border-left: 3px solid #e1454f;
		border-bottom: 3px solid #e1454f;
		transform: translateX(-50%) rotate(-45deg);
		animation: menu-arrow-down 1.1s ease-in-out infinite;
	}

	.menu-list__accordion[open] .menu-list__summary {
		background: #161615;
		color: #ffffff;
	}

	.menu-list__accordion[open] .menu-list__summary::after {
		animation-name: menu-arrow-up;
	}

	.menu-list__summary::-webkit-details-marker {
		display: none;
	}

	@keyframes menu-arrow-down {
		0% {
			transform: translate(-50%, -4px) rotate(-45deg);
		}
		50% {
			transform: translate(-50%, 4px) rotate(-45deg);
		}
		100% {
			transform: translate(-50%, -4px) rotate(-45deg);
		}
	}

	@keyframes menu-arrow-up {
		0% {
			transform: translate(-50%, 4px) rotate(135deg);
		}
		50% {
			transform: translate(-50%, -4px) rotate(135deg);
		}
		100% {
			transform: translate(-50%, 4px) rotate(135deg);
		}
	}

	@media (max-width: 1200px) {
		.menu-list {
			padding: 110px 0 136px;
		}

		.menu-list__grid {
			gap: 40px;
		}
	}

	@media (max-width: 768px) {
		.menu-list {
			padding: 92px 0 112px;
		}

		.menu-list__inner {
			gap: 34px;
		}

		.menu-list__grid {
			gap: 32px;
		}

		.menu-list__summary {
			width: 100%;
			min-width: 0;
			max-width: 380px;
		}
	}
</style>

