---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';
import blogHeroUrl from '../../assets/media/Enmascarar grupo 18.png?url';
import blogHero2xUrl from '../../assets/media/Enmascarar grupo 18@2x.png?url';
import { postsRepo } from '../../lib/content';

const db = getDB(Astro.locals);

const posts = (await postsRepo.listAll(db)).filter((post) => post.published === 1);
---

<Layout title="Blog | La Siberia Central">
	<section class="blog-hero" aria-labelledby="blog-title">
		<div
			class="blog-hero__bg"
			style={`background-image: image-set(url("${blogHeroUrl}") 1x, url("${blogHero2xUrl}") 2x);`}
			aria-hidden="true"
		></div>
		<div class="blog-hero__overlay" aria-hidden="true"></div>
		<div class="blog-hero__content">
			<h1 id="blog-title" class="blog-hero__title">Blog</h1>
			<p class="blog-hero__subtitle">Historias, eventos y noticias de La Siberia Central</p>
		</div>
	</section>
	<section class="blog-list" aria-labelledby="blog-list-title">
		<div class="blog-list__inner">
			<h2 id="blog-list-title" class="sr-only">Publicaciones recientes</h2>
			{posts.length === 0 ? (
				<p class="blog-list__empty">Aun no hay publicaciones. Vuelve pronto.</p>
			) : (
				<div class="blog-list__grid">
					{posts.map((post) => (
						<article class="blog-card">
							<img
								class="blog-card__image"
								src={post.image_url ?? blogHeroUrl}
								alt={post.title}
								loading="lazy"
							/>
							<div class="blog-card__body">
								<h3 class="blog-card__title">{post.title}</h3>
								<p class="blog-card__excerpt">{post.excerpt}</p>
								<a class="blog-card__button" href={`/blog/${post.slug}`}>Saber mas</a>
							</div>
						</article>
					))}
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.blog-hero {
		position: relative;
		width: 100%;
		height: 752px;
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
		color: #ffffff;
	}

	.blog-hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center;
		filter: none;
		transform: scale(1.02);
	}

	.blog-hero__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.45);
	}

	.blog-hero__content {
		position: relative;
		z-index: 2;
		max-width: 820px;
		padding: 0 24px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
	}

	.blog-hero__title {
		margin: 0;
		font: normal normal bold 64px/1 Campton, 'Montserrat', 'Arial', sans-serif;
		text-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
	}

	.blog-hero__subtitle {
		margin: 0;
		font-size: 19px;
		font-weight: 600;
		letter-spacing: 0.2px;
		text-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
		opacity: 0.98;
	}

	@media (max-width: 1200px) {
		.blog-hero {
			height: 680px;
		}

		.blog-hero__title {
			font-size: 56px;
		}

		.blog-hero__subtitle {
			font-size: 18px;
		}
	}

	@media (max-width: 768px) {
		.blog-hero {
			height: 560px;
		}

		.blog-hero__title {
			font-size: 44px;
		}

		.blog-hero__subtitle {
			font-size: 16px;
		}
	}

	.blog-list {
		background: #ffffff;
		padding: 120px 0 150px;
		display: flex;
		justify-content: center;
	}

	.blog-list__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	.blog-list__empty {
		margin: 0;
		font-size: 18px;
		color: #6a6a6a;
	}

	.blog-list__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 42px 36px;
	}

	.blog-card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.blog-card__image {
		width: 100%;
		height: 240px;
		object-fit: cover;
		display: block;
	}

	.blog-card__body {
		padding: 20px 24px 26px;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.blog-card__title {
		margin: 0;
		font: normal normal bold 24px/1.2 Campton, 'Montserrat', 'Arial', sans-serif;
		color: #e1454f;
	}

	.blog-card__excerpt {
		margin: 0;
		font-size: 17px;
		line-height: 26px;
		color: #2b2b2b;
	}

	.blog-card__button {
		margin-top: 4px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		min-width: 200px;
		height: 48px;
		border: 2px solid #8b5a2b;
		color: #8b5a2b;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.2px;
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.blog-card__button:hover,
	.blog-card__button:focus-visible {
		transform: translateY(-2px);
		background: rgba(139, 90, 43, 0.08);
	}

	@media (max-width: 1200px) {
		.blog-list {
			padding: 104px 0 130px;
		}

		.blog-list__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 34px;
		}
	}

	@media (max-width: 768px) {
		.blog-list {
			padding: 90px 0 110px;
		}

		.blog-list__grid {
			grid-template-columns: 1fr;
			gap: 30px;
		}

		.blog-card__image {
			height: 220px;
		}
	}
</style>
