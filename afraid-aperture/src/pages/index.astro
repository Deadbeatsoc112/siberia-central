---
import Layout from '../layouts/Layout.astro';
import heroMainBgUrl from '../assets/fondos/Inicio.png?url';
const heroMainBg2xUrl = heroMainBgUrl;
import heroBackgroundUrl from '../assets/media/Grupo 198 sin-linea.png?url';
import heroLogoUrl from '../assets/media/logologito.png?url';
import heroLogo2xUrl from '../assets/media/logologito.png?url';
import storyImageUrl from '../assets/media/Grupo 27.png?url';
import storyImage2xUrl from '../assets/media/Grupo 27@2x.png?url';
import menuImageOneUrl from '../assets/Tosdata.jpg?url';
import menuImageOne2xUrl from '../assets/Tosdata.jpg?url';
import menuImageTwoUrl from '../assets/Taco.jpg?url';
import menuImageTwo2xUrl from '../assets/Taco.jpg?url';
import menuImageThreeUrl from '../assets/Tlalp.jpg?url';
import menuImageThree2xUrl from '../assets/Tlalp.jpg?url';
import menuBandUrl from '../assets/media/Enmascarar grupo 9.png?url';
import menuBand2xUrl from '../assets/media/Enmascarar grupo 9@2x.png?url';
import decorativeStarsUrl from '../assets/media/Grupo 24.svg?url';
---

<Layout title="Inicio | La S central">
	<section
		class="hero"
		style={`--hero-bg: image-set(url(${heroMainBgUrl}) 1x, url(${heroMainBg2xUrl}) 2x);`}
	>
		<div class="hero__bg hero__bg--image" aria-hidden="true"></div>
		<div class="hero__bg hero__bg--resources" aria-hidden="true"></div>
		<div class="hero__overlay" aria-hidden="true"></div>
		<div class="hero__content">
			<img
				class="hero__logo"
				src={heroLogoUrl}
				srcset={`${heroLogoUrl} 1x, ${heroLogo2xUrl} 2x`}
				alt="La S central"
				loading="eager"
			/>
			<h1 class="hero__title">La S central</h1>
		</div>
	</section>
	<section class="tradition-banner" aria-label="Lema">
		<p class="tradition-banner__text">¡Somos una tradición muy regia!</p>
	</section>
	<section
		class="hero-followup"
		style={`background-image: url(${heroBackgroundUrl});`}
		aria-labelledby="historia-title"
	>
		<div class="story">
			<div
				class="story__image"
				style={`background-image: url(${storyImageUrl});`}
				aria-hidden="true"
			></div>
			<div class="story__content">
				<h2 id="historia-title" class="story__title">Nuestra Historia</h2>
				<span class="story__rule" aria-hidden="true"></span>
				<p class="story__text">
La S central nació del deseo de una familia por ofrecer algo sencillo pero auténtico: una mesa donde la gente se sienta bienvenida y bien atendida.
Con el paso del tiempo, esa mesa se convirtió en un lugar de reunión para generaciones de regiomontanos, un espacio donde se comparten platillos, risas y momentos que se guardan en la memoria.
Hoy seguimos siendo ese mismo lugar: un restaurante familiar que honra su origen y se esfuerza por mantener la calidad y el cariño en cada visita.
Porque para nosotros, más que servir tostadas, se trata de seguir siendo parte de las historias que se cuentan alrededor de la mesa.
				</p>
				<a class="story__button" href="/nosotros">Más sobre nosotros</a>
			</div>
		</div>
	</section>
	<section class="menu" aria-labelledby="menu-title">
		<div class="menu__intro">
			<h2 id="menu-title" class="menu__title">Elige tu próximo plato favorito</h2>
			<p class="menu__subtitle">Recetas con historia, hechas para compartir con tu gente</p>
			<a class="menu__button" href="/menu-sucursales">Ver Menú</a>
		</div>
		<div
			class="menu__band"
			style={`background-image: image-set(url(${menuBandUrl}) 1x, url(${menuBand2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
		<div class="menu__gallery">
			<figure class="menu__card">
				<img
					src={menuImageOneUrl}
					srcset={`${menuImageOneUrl} 1x, ${menuImageOne2xUrl} 2x`}
					alt="Plato destacado de La S central"
					loading="lazy"
				/>
			</figure>
			<figure class="menu__card">
				<img
					src={menuImageTwoUrl}
					srcset={`${menuImageTwoUrl} 1x, ${menuImageTwo2xUrl} 2x`}
					alt="Especialidad de la casa"
					loading="lazy"
				/>
			</figure>
			<figure class="menu__card">
				<img
					src={menuImageThreeUrl}
					srcset={`${menuImageThreeUrl} 1x, ${menuImageThree2xUrl} 2x`}
					alt="Plato favorito de nuestros clientes"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>
		<section class="feedback-cta" aria-labelledby="feedback-title">
			<div class="feedback-cta__inner">
				<img class="feedback-cta__decor" src={decorativeStarsUrl} alt="" aria-hidden="true" />
				<h2 id="feedback-title" class="feedback-cta__title">Queremos leerte</h2>
				<p class="feedback-cta__subtitle">
					Si tienes comentarios o sugerencias, usa el formulario de contacto independiente.
				</p>
				<a class="feedback-cta__button" href="/contacto#form-title">Ir a contacto</a>
			</div>
		</section>
	</Layout>

<script>
	const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

	const storyImage = document.querySelector('.story__image');
	const storySection = document.querySelector('.hero-followup');

		if (storyImage instanceof HTMLElement && storySection instanceof HTMLElement) {
		let storySectionVisible = false;
		let storySpinLocked = false;
		let storySpinUnlockTimer;
		const storySpinDurationMs = 1000;

		const triggerStorySpin = () => {
			if (reducedMotionMedia.matches) return;
			if (storySpinLocked) return;

			storySpinLocked = true;
			storyImage.classList.remove('is-spin-turn');
			// Force reflow so the animation can restart on each trigger.
			void storyImage.offsetWidth;
			storyImage.classList.add('is-spin-turn');
			window.clearTimeout(storySpinUnlockTimer);
			storySpinUnlockTimer = window.setTimeout(() => {
				storySpinLocked = false;
			}, storySpinDurationMs + 120);
		};

		const storyObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.target !== storySection) return;
					if (entry.isIntersecting && !storySectionVisible) {
						storySectionVisible = true;
						triggerStorySpin();
					}
					if (!entry.isIntersecting) {
						storySectionVisible = false;
					}
				});
			},
			{
				threshold: 0.45,
			}
		);

		if (!reducedMotionMedia.matches) {
			storyObserver.observe(storySection);
		}

		reducedMotionMedia.addEventListener?.('change', () => {
			if (reducedMotionMedia.matches) {
				storyObserver.disconnect();
				storyImage.classList.remove('is-spin-turn');
				return;
			}
			if (!reducedMotionMedia.matches) {
				storyObserver.observe(storySection);
			}
		});

		const fallbackOnScroll = () => {
			if (reducedMotionMedia.matches) return;
			const rect = storySection.getBoundingClientRect();
			const viewportHeight = window.innerHeight || 1;
			const sectionInViewport = rect.top < viewportHeight * 0.65 && rect.bottom > viewportHeight * 0.35;
			if (sectionInViewport && !storySectionVisible) {
				storySectionVisible = true;
				triggerStorySpin();
			}
			if (!sectionInViewport) {
				storySectionVisible = false;
			}
		};

		storyImage.addEventListener('animationend', () => {
			storyImage.classList.remove('is-spin-turn');
		});

			window.addEventListener('scroll', fallbackOnScroll, { passive: true });
			window.addEventListener('resize', fallbackOnScroll);
		}

	</script>

<style>
	.hero {
		position: relative;
		top: 0px;
		left: 0px;
		width: 100%;
		height: 100vh;
		min-height: 680px;
		opacity: 1;
		overflow: hidden;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center ;
		background-repeat: no-repeat;
	}

	.hero__bg--image {
		background-image: var(--hero-bg);
		z-index: 0;
	}

	.hero__bg--resources {
		background-image: var(--hero-resources-bg);
		z-index: 2;
		pointer-events: none;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0);
		z-index: 1;
	}

	.hero__content {
		position: relative;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding: 0 24px;
	}

	.hero__logo {
		width: 140px;
		height: 140px;
		opacity: 1;
	}

	.hero__title {
		margin: 0;
		font: normal normal bold 48px/1.2 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 0px;
		color: #ffffff;
		text-shadow: 0px 3px 6px #000000;
		opacity: 1;
	}

	.tradition-banner {
		background: #e1454f;
		padding: 36px 24px;
		text-align: center;
	}

	.tradition-banner__text {
		margin: 0;
		color: #ffffff;
		font-size: clamp(28px, 4vw, 48px);
		font-weight: 900;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.25);
	}

	.hero-followup {
		position: relative;
		top: 0px;
		left: 0px;
		width: 100%;
		height: clamp(640px, 55vw, 820px);
		--story-content-top: 30px;
		background-color: #e1454f;
		background-position: 0% 0%;
		background-size: cover;
		background-repeat: no-repeat;
		opacity: 1;
	}

	.story {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.story__image {
		position: absolute;
		top: 163px;
		right: clamp(24px, 6vw, 120px);
		left: auto;
		width: min(32vw, 498px);
		height: min(32vw, 498px);
		max-width: 498px;
		max-height: 498px;
		box-sizing: border-box;
		--story-image-base-transform: matrix(0.98, -0.17, 0.17, 0.98, 0, 0);
		transform: var(--story-image-base-transform);
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
		border: 10px solid #ffffff;
		box-shadow: 0px 12px 30px rgba(0, 0, 0, 0.35);
		opacity: 1;
		will-change: transform;
	}

	.story__image.is-spin-turn {
		animation: storyImageSpinTurn 1s cubic-bezier(0.22, 0.8, 0.2, 1) both;
	}

	@keyframes storyImageSpinTurn {
		0% {
			transform: var(--story-image-base-transform);
		}
		100% {
			transform: var(--story-image-base-transform) rotate(360deg);
		}
	}

	.story__content {
		position: absolute;
		top: var(--story-content-top);
		left: 25%;
		right: auto;
		transform: translateX(-50%);
		width: min(520px, 42vw);
		max-width: 520px;
		height: auto;
		padding: 0 24px;
		box-sizing: border-box;
		opacity: 1;
		color: #ffffff;
		text-align: left;
	}

	.story__title {
		margin: 0 0 18px;
		width: 487px;
		text-align: left;
		font: normal normal bold 60px/1.1 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 0px;
		color: #ffffff;
		opacity: 1;
		white-space: nowrap;
	}

	@media (max-width: 1366px) and (min-width: 1024px) {
		.hero-followup {
			--story-content-top: -30px;
		}

		.story__image {
			top: 150px;
			right: clamp(24px, 4vw, 80px);
			width: min(34vw, 460px);
			height: min(34vw, 460px);
		}

		.story__content {
			max-width: 600px;
		}
	}

	.story__rule {
		display: block;
		width: 260px;
		height: 2px;
		background: #ffffff;
		margin-bottom: 22px;
	}

	.story__text {
		margin: 0 0 32px;
		font-size: 18px;
		line-height: 28px;
		max-width: 626px;
		opacity: 0.95;
	}

	.story__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 306px;
		height: 58px;
		border: 2px solid #ffffff;
		color: #ffffff;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0px;
		opacity: 1;
	}

	@media (max-width: 1200px) {
		.hero {
			min-height: 560px;
		}

		.hero__logo {
			width: 110px;
			height: 110px;
		}

		.hero__title {
			font-size: 36px;
			line-height: 1.25;
		}

		.hero-followup {
			height: auto;
			--story-content-top: 0px;
		}

		.story__image {
			display: none;
		}

		.story {
			padding: 88px 24px 72px;
		}

		.story__content {
			position: relative;
			top: auto;
			left: auto;
			right: auto;
			width: min(760px, 100%);
			max-width: 760px;
			margin: 0 auto;
			padding: 0;
			transform: none;
			color: #111111;
		}

		.story__title {
			width: auto;
			height: auto;
			font-size: 36px;
			line-height: 44px;
			color: #111111;
			white-space: normal;
		}

		.story__rule {
			width: 180px;
			background: #111111;
		}

		.story__text {
			font-size: 16px;
			line-height: 24px;
			color: #111111;
			opacity: 1;
		}

		.story__button {
			width: 240px;
			height: 52px;
			border-color: #111111;
			color: #111111;
		}
	}

	.menu {
		position: relative;
		background: #ffffff;
		color: #7a4b1f;
		padding: 110px 0 140px;
		min-height: 900px;
		overflow: hidden;
	}

	.menu__intro {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 14px;
		text-align: center;
		padding: 0 24px;
	}

	.menu__title {
		margin: 0;
		font: normal normal bold 40px/1.2 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		color: #8b5a2b;
	}

	.menu__subtitle {
		margin: 0;
		font-size: 18px;
		color: #8b5a2b;
		opacity: 0.8;
	}

	.menu__button {
		margin-top: 12px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 210px;
		height: 48px;
		border: 2px solid #8b5a2b;
		color: #8b5a2b;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0px;
	}

	.menu__band {
		position: absolute;
		top: 386px;
		left: 0;
		width: 100%;
		height: 358px;
		background-size: 100% 100%;
		background-position: center;
		background-repeat: no-repeat;
		opacity: 1;
		z-index: 1;
	}

	.menu__gallery {
		position: absolute;
		top: 350px;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		margin-top: 0;
		width: min(1600px, calc(100% - 160px));
		display: flex;
		justify-content: center;
		gap: 90px;
		padding: 0;
		flex-wrap: wrap;
	}

	.menu__card {
		margin: 0;
		background: #ffffff;
		padding: 12px;
		border: 1px solid #f0f0f0;
		box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
	}

	.menu__card img {
		display: block;
		width: 430px;
		height: 430px;
		object-fit: cover;
	}

	@media (max-width: 1200px) {
		.menu {
			padding: 90px 0 120px;
			min-height: 820px;
		}

		.menu__band {
			top: 350px;
			height: 280px;
		}

		.menu__gallery {
			top: 330px;
			left: 50%;
			transform: translateX(-50%);
			width: min(1200px, calc(100% - 120px));
			gap: 60px;
		}

		.menu__card {
			padding: 10px;
		}

		.menu__card img {
			width: 300px;
			height: 300px;
		}
	}

	@media (max-width: 768px) {
		.hero {
			min-height: 520px;
		}

		.hero__logo {
			width: 96px;
			height: 96px;
		}
		.menu__title {
			font-size: 30px;
		}

		.menu__subtitle {
			font-size: 16px;
		}

		.menu__band {
			display: none;
		}

		.menu__gallery {
			position: relative;
			top: auto;
			margin-top: 50px;
			gap: 24px;
		}

		.menu__card img {
			width: 100%;
			max-width: 320px;
			height: 220px;
		}
	}

	.feedback-cta {
		position: relative;
		width: 100%;
		background: #e1454f;
		color: #ffffff;
		display: flex;
		justify-content: center;
		padding: 74px 24px;
		box-sizing: border-box;
		overflow: hidden;
	}

	.feedback-cta__inner {
		width: min(1100px, 100%);
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.feedback-cta__decor {
		position: absolute;
		top: -4px;
		right: 0;
		width: 128px;
		height: auto;
		opacity: 0.85;
	}

	.feedback-cta__title {
		margin: 0;
		font: normal normal bold 42px/1.2 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 0px;
	}

	.feedback-cta__subtitle {
		margin: 0;
		max-width: 720px;
		font-size: 16px;
		opacity: 0.95;
	}

	.feedback-cta__button {
		margin-top: 6px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 230px;
		height: 44px;
		border: 2px solid #ffffff;
		color: #ffffff;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0px;
	}

	@media (max-width: 1200px) {
		.feedback-cta__title {
			font-size: 36px;
		}

		.feedback-cta__decor {
			width: 112px;
		}
	}

		@media (max-width: 768px) {
		.feedback-cta {
			padding: 64px 20px;
		}

		.feedback-cta__decor {
			position: static;
			width: 96px;
			margin-bottom: 6px;
		}

		.feedback-cta__title {
			font-size: 30px;
		}

		.feedback-cta__button {
			width: 100%;
		}
	}

</style>
