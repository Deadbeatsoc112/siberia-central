---
import Layout from "../layouts/Layout.astro";
import { getDB } from "../lib/db";
import heroBgUrl from "../assets/fondos/Contacto.png?url";
import contactHeroResourcesUrl from "../assets/fondos/RecrusosContactos.svg?url";
import zigzagDecorUrl from '../assets/media/Grupo 36.svg?url';
import { branchesRepo } from "../lib/branches";

const db = getDB(Astro.locals);

const branchesRaw = await branchesRepo.listActive(db);
const branches = branchesRaw.map((b) => ({
  id: b.id,
  slug: b.slug,
  name: b.name,
  address: b.display_address || b.address,
  phones: JSON.parse(b.phones),
  lat: b.latitude || 25.6866,
  lng: b.longitude || -100.3161,
}));

const defaultCenter = { lat: 25.6866, lng: -100.3161 }; // Monterrey
const defaultZoom = 12;

const success = Astro.url.searchParams.get('success') === '1';
const error = Astro.url.searchParams.get('error');
---

<Layout title="Contacto | La S central">
  <!-- HERO -->
  <section class="contact-hero" aria-labelledby="contact-title">
    <div
      class="contact-hero__bg contact-hero__bg--image"
      style={`background: transparent url("${heroBgUrl}") 0% 0% no-repeat padding-box;`}
      aria-hidden="true"
    >
    </div>
    <div
      class="contact-hero__bg contact-hero__bg--resources"
      style={`background-image: url("${contactHeroResourcesUrl}");`}
      aria-hidden="true"
    ></div>
    <div class="contact-hero__overlay" aria-hidden="true"></div>

    <div class="contact-hero__content">
      <h1 id="contact-title" class="contact-hero__title">Contáctanos</h1>
      <p class="contact-hero__subtitle">Encuentra tu sucursal más cercana</p>
    </div>
  </section>

  <!-- MAPA + LISTA -->
  <section class="contact-map" id="sucursales" aria-labelledby="map-title">
    <div class="contact-map__header-wrapper">
      <div class="contact-map__header">
        <h2 id="map-title" class="contact-map__title">
          Conoce nuestras sucursales
        </h2>
        <div class="contact-map__count-wrapper">
          <span class="contact-map__tenemos">Tenemos</span>
          <span class="contact-map__count-number">{branches.length}</span>
        </div>
      </div>
    </div>

    <div class="contact-map__grid-wrapper">
      <img class="contact-map__decor" src={zigzagDecorUrl} alt="" aria-hidden="true" />
      <div class="contact-map__grid">
        <!-- Panel lateral -->
        <aside class="branches" aria-label="Lista de sucursales">
          <div class="branches__scroll" id="branchList">
            <div class="branches__content">
              {
                branches.map((b, idx) => (
                  <button
                    class="branch"
                    type="button"
                    data-id={b.slug}
                    data-lat={b.lat}
                    data-lng={b.lng}
                    data-name={b.name}
                    data-address={b.address}
                  >
                    <div class="branch__num">{idx + 1}</div>
                    <div class="branch__body">
                      <div class="branch__name">{b.name}</div>
                      <div class="branch__addr">{b.address}</div>

                      {b.phones?.length ? (
                        <div class="branch__phones">
                          {b.phones.map((p) => (
                            <div class="branch__phone">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                fill="currentColor"
                              >
                                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z" />
                              </svg>
                              {p}
                            </div>
                          ))}
                        </div>
                      ) : null}
                    </div>
                  </button>
                ))
              }
            </div>
          </div>
        </aside>

        <!-- Mapa (OSM estático) -->
        {/*
        <div class="mapWrap">
          <div id="map" class="map" aria-label="Mapa de sucursales"></div>
        </div>
        */}
      </div>
    </div>
  </section>

  <!-- CONTACT FORM -->
  <section class="contact-form" aria-labelledby="form-title">
    <div class="contact-form__inner">
      <div class="contact-form__header">
        <h2 id="form-title" class="contact-form__title">Queremos leerte</h2>
        <div class="contact-form__divider"></div>
        <p class="contact-form__subtitle">
          Déjanos tu mensaje, prometemos responder con el mismo amor nuestro
          sazón.
        </p>
      </div>

      {success && (
        <div class="contact-form__success">
          ¡Mensaje enviado con éxito! Nos pondremos en contacto contigo pronto.
        </div>
      )}
      {error && (
        <div class="contact-form__error">
          {error === 'campos-requeridos' && 'Por favor completa todos los campos requeridos.'}
          {error === 'limite-excedido' && 'Has excedido el límite de mensajes. Intenta más tarde.'}
          {error === 'servidor' && 'Error del servidor. Intenta más tarde.'}
        </div>
      )}

      <form class="contact-form__form" action="/api/contact/submit" method="post" enctype="multipart/form-data">
        <div class="form-field contact-form__branch-field">
          <label for="sucursal" class="form-label">Sucursal</label>
          <select id="sucursal" name="branch_id" class="form-input">
            <option value="">-- Selecciona una sucursal --</option>
            {branches.map((b) => (
              <option value={b.id}>{b.name}</option>
            ))}
          </select>
        </div>

        <div class="contact-form__grid">
          <!-- Left Column -->
          <div class="form-column">
            <div class="form-field">
              <label for="nombre" class="form-label">Nombre Completo*</label>
              <input
                type="text"
                id="nombre"
                name="full_name"
                class="form-input"
                required
              />
            </div>

            <div class="form-field">
              <label for="mensaje" class="form-label">Mensaje*</label>
              <textarea
                id="mensaje"
                name="message"
                class="form-textarea"
                rows="5"
                required></textarea>
            </div>
          </div>

          <!-- Right Column -->
          <div class="form-column">
            <div class="form-field">
              <label for="email" class="form-label">Correo Electrónico*</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                required
              />
            </div>

            <div class="form-field">
              <label for="telefono" class="form-label">Teléfono</label>
              <input
                type="tel"
                id="telefono"
                name="phone"
                class="form-input"
              />
            </div>

            <div class="form-field">
              <label for="imagen" class="form-label">Imagen (opcional)</label>
              <input
                type="file"
                id="imagen"
                name="image"
                class="form-input form-input--file"
                accept="image/jpeg,image/png,image/webp"
              />
              <span class="form-hint">JPG, PNG o WebP · Máx. 2 MB</span>
            </div>

            <div class="contact-form__actions">
              <button type="submit" class="form-button">Enviar</button>
            </div>
          </div>
        </div>
      </form>
    </div>
  </section>

  {/*
  <!-- JS para el mapa interactivo -->
