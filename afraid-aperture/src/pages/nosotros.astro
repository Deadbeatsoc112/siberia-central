		}

		.timeline__item::after {
			content: none;
			display: none;
		}

		.timeline__dot {
			display: none !important;
		}

		.timeline__year {
			margin-top: 0;
			font-size: 28px;
		}

		.timeline__label {
			font-size: 15px;
			margin-top: 4px;
		}

		.timeline__text {
			max-width: none;
			margin-top: 8px;
		}

		.timeline__nav {
			display: none;
		}

	}

	@media (max-width: 480px) {
		.timeline__content {
			padding: 60px 0 20px;
			gap: 20px;
		}

		.timeline__title {
			padding-left: 16px;
			padding-right: 16px;
			font-size: 32px;
			line-height: 1.1;
		}

		.timeline__rule {
			display: none;
		}

		.timeline__track {
			padding: 0 16px;
			gap: 16px;
		}

		.timeline__item {
			padding: 12px 12px 14px;
			border-radius: 12px;
		}

		.timeline__year {
