		font-weight: 600;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonSemiBoldItalic.otf")
			format("opentype");
		font-weight: 600;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBold.otf") format("opentype");
		font-weight: 700;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBoldItalic.otf")
			format("opentype");
		font-weight: 700;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonExtraBold.otf") format("opentype");
		font-weight: 800;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonExtraBoldItalic.otf")
			format("opentype");
		font-weight: 800;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBlack.otf") format("opentype");
		font-weight: 900;
		font-style: normal;
		font-display: swap;
	}

	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonBlackItalic.otf")
			format("opentype");
		font-weight: 900;
		font-style: italic;
		font-display: swap;
	}

	@font-face {
		font-family: "River Young";
		src:
			url("../assets/fonts/river-young/RiverYoung-Regular.otf")
				format("opentype"),
			url("../assets/fonts/river-young/RiverYoung-Regular.ttf")
				format("truetype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	:global(:root) {
		--nav-height: 38px;
		--nav-width: 1106px;
		--nav-top: 55px;
		--nav-text: #c8b07a;
		--page-bg: #050505;
		--page-text: #ffffff;
	}

	:global(html, body) {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background: var(--page-bg);
		color: var(--page-text);
		overflow-x: hidden;
		box-sizing: border-box;
		font-family: 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-weight: 700;
	}

	:global(*, *::before, *::after) {
		font-family: 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-weight: 700;
		box-sizing: inherit;
	}

	.site-header {
		position: absolute;
		top: var(--nav-top);
		left: 0;
		width: 100%;
		height: var(--nav-height);
		opacity: 1;
		z-index: 10;
		display: flex;
		justify-content: center;
	}

	.site-nav {
		height: 100%;
		width: min(90%, var(--nav-width));
		position: relative;
	}

	.site-nav__toggle {
		display: none;
	}

	.site-nav__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		gap: 62px;
	}

	.site-nav__link {
		color: var(--nav-text);
		text-decoration: none;
		font-size: 18px;
		font-weight: 500;
		line-height: var(--nav-height);
		letter-spacing: 0.4px;
		text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.55);
		transition: opacity 0.2s ease;
	}

	.site-nav__link-mark {
		display: none;
	}

	.site-nav__link:hover,
	.site-nav__link:focus-visible {
		opacity: 0.8;
	}

	.site-nav__link.is-active {
		opacity: 1;
		border-bottom: 2px solid rgba(200, 176, 122, 0.7);
		padding-bottom: 6px;
	}

	.site-nav__hamburger {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		width: 24px;
		height: 16px;
	}

	.site-nav__hamburger-line {
		width: 100%;
		height: 2.5px;
		border-radius: 999px;
		background: var(--nav-text);
		box-shadow: 0px 1px 2px rgba(0, 0, 0, 0.45);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.site-nav.is-open .site-nav__hamburger-line:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}

	.site-nav.is-open .site-nav__hamburger-line:nth-child(2) {
		opacity: 0;
	}

	.site-nav.is-open .site-nav__hamburger-line:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}

	@media (min-width: 769px) {
		.site-nav--light .site-nav__link {
			color: #8b5a2b;
			text-shadow: none;
		}

		.site-nav--light .site-nav__link:hover,
		.site-nav--light .site-nav__link:focus-visible {
			opacity: 0.72;
		}

		.site-nav--light .site-nav__link.is-active {
			border-bottom-color: rgba(139, 90, 43, 0.7);
		}
	}

	.page {
		min-height: 100vh;
	}

	.page-hero {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		text-align: center;
		padding: 140px 24px 80px;
	}

	.page-hero h1 {
		margin: 0;
		font-size: 48px;
		letter-spacing: 0px;
		font-weight: 700;
	}

	.page-hero p {
		margin: 0;
		max-width: 640px;
		opacity: 0.75;
	}

	@media (max-width: 1200px) {
		.site-nav__list {
			justify-content: center;
			gap: 28px;
			flex-wrap: wrap;
		}
	}

	@media (max-width: 768px) {
		:global(:root) {
			--hamburger-base: #0D0D0D;
			--hamburger-card: #1C1C1C;
			--hamburger-active: #C0392B;
			--hamburger-accent: #E74C3C;
			--hamburger-text: #FFFFFF;
		}

		:global(:root) {
			--nav-top: 20px;
		}

		.site-header {
			padding: 0 16px;
		}

		.site-nav {
			width: 100%;
			display: flex;
			justify-content: flex-end;
			align-items: center;
		}

		.site-nav__toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 52px;
			height: 52px;
			border: 1px solid rgba(255, 255, 255, 0.24);
			border-radius: 14px;
			background: var(--hamburger-base);
			backdrop-filter: blur(8px);
			cursor: pointer;
			transition: transform 0.2s ease, background 0.2s ease;
		}

		.site-nav__toggle:hover,
		.site-nav__toggle:focus-visible {
			background: var(--hamburger-card);
			transform: translateY(-1px);
		}

		.site-nav__hamburger-line {
			background: var(--hamburger-accent);
		}

		.site-nav__list {
			position: absolute;
			top: calc(100% + 12px);
			right: 0;
			width: min(92vw, 380px);
			height: auto;
			max-height: calc(100vh - 110px);
			overflow-y: auto;
			display: grid;
			grid-template-columns: 1fr;
			align-items: stretch;
			gap: 8px;
			padding: 14px;
			border-radius: 16px;
			border: 1px solid rgba(255, 255, 255, 0.18);
			background: var(--hamburger-base);
			backdrop-filter: blur(6px);
			box-shadow: 0px 18px 40px rgba(0, 0, 0, 0.48);
			opacity: 0;
			pointer-events: none;
			transform: translateY(-8px);
			transition: opacity 0.18s ease, transform 0.18s ease;
		}

		.site-nav.is-open .site-nav__list {
			opacity: 1;
			pointer-events: auto;
			transform: translateY(0px);
		}

		.site-nav__item {
			width: 100%;
			display: block;
		}

		.site-nav__link {
			display: flex;
			align-items: center;
			gap: 12px;
			font-size: 17px;
			line-height: 1.3;
			font-weight: 700;
			padding: 14px 14px;
			border-radius: 12px;
			background: var(--hamburger-card);
			text-align: left;
			width: 100%;
			border: 1px solid rgba(255, 255, 255, 0.16);
			color: var(--hamburger-text);
			text-shadow: none;
		}

		.site-nav__link-label {
			display: block;
		}

		.site-nav__link.is-active {
			border: 1px solid rgba(255, 255, 255, 0.26);
			background: var(--hamburger-active);
			padding-bottom: 14px;
		}

		.site-nav__link-mark {
			display: inline-block;
			width: 18px;
			height: 18px;
			background-image: var(--site-nav-mark-image);
			background-size: contain;
			background-repeat: no-repeat;
			background-position: center;
			flex: 0 0 auto;
		}
	}

	@media (max-width: 480px) {
		:global(:root) {
			--nav-top: 16px;
		}

		.site-header {
			padding: 0 12px;
		}

		.site-nav__list {
			width: min(96vw, 360px);
			padding: 14px;
		}

		.site-nav__link {
			font-size: 16px;
			letter-spacing: 0.2px;
		}
	}

	@media (max-width: 375px) {
		:global(:root) {
			--nav-top: 12px;
		}

		.site-header {
			padding: 0 8px;
		}

		.site-nav__link {
			font-size: 13px;
			letter-spacing: 0.1px;
		}
	}
</style>
