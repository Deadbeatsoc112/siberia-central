	}

	@font-face {
		font-family: "River Young";
		src:
			url("../assets/fonts/river-young/RiverYoung-Regular.otf")
				format("opentype"),
			url("../assets/fonts/river-young/RiverYoung-Regular.ttf")
				format("truetype");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}

	:global(:root) {
		--nav-height: 38px;
		--nav-width: 1106px;
		--nav-top: 55px;
		--nav-text: #c8b07a;
		--page-bg: #050505;
		--page-text: #ffffff;
	}

	:global(html, body) {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		background: var(--page-bg);
		color: var(--page-text);
		overflow-x: hidden;
		box-sizing: border-box;
		font-family: 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-weight: 700;
	}

	:global(*, *::before, *::after) {
		font-family: 'Campton', 'Montserrat', 'Arial', sans-serif;
		font-weight: 700;
		box-sizing: inherit;
	}

	.site-header {
		position: absolute;
		top: var(--nav-top);
		left: 0;
		width: 100%;
		height: var(--nav-height);
		opacity: 1;
		z-index: 10;
		display: flex;
		justify-content: center;
	}

	.site-nav {
		height: 100%;
		width: min(90%, var(--nav-width));
	}

	.site-nav__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		gap: 62px;
	}

	.site-nav__link {
		color: var(--nav-text);
		text-decoration: none;
		font-size: 18px;
		font-weight: 500;
		line-height: var(--nav-height);
		letter-spacing: 0.4px;
		text-shadow: 0px 2px 6px rgba(0, 0, 0, 0.55);
		transition: opacity 0.2s ease;
	}

	.site-nav__link:hover,
	.site-nav__link:focus-visible {
		opacity: 0.8;
	}

	.site-nav__link.is-active {
		opacity: 1;
		border-bottom: 2px solid rgba(200, 176, 122, 0.7);
		padding-bottom: 6px;
	}

	.page {
		min-height: 100vh;
	}

	.page-hero {
		min-height: 60vh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
		text-align: center;
		padding: 140px 24px 80px;
	}

	.page-hero h1 {
		margin: 0;
		font-size: 48px;
		letter-spacing: 0px;
		font-weight: 700;
	}

	.page-hero p {
		margin: 0;
		max-width: 640px;
		opacity: 0.75;
	}

	@media (max-width: 1200px) {
		.site-nav__list {
			justify-content: center;
			gap: 28px;
			flex-wrap: wrap;
		}
	}
</style>
