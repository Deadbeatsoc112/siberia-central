---
interface Props {
	latitudeInputName?: string;
	longitudeInputName?: string;
	addressInputName?: string;
	initialLat?: number;
	initialLng?: number;
}

const {
	latitudeInputName = 'latitude',
	longitudeInputName = 'longitude',
	addressInputName = 'address',
	initialLat = 25.6866,
	initialLng = -100.3161,
} = Astro.props;
---

<div class="address-search">
	<div class="address-search__header">
		<label class="address-search__label">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor">
				<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<circle cx="12" cy="10" r="3" stroke-width="2"/>
			</svg>
			Buscar ubicación en el mapa
		</label>
		<p class="address-search__hint">Busca una dirección o arrastra el marcador en el mapa</p>
	</div>

	<div class="address-search__input-group">
		<input
			type="text"
			class="address-search__input admin-input"
			id="address-search-input"
			placeholder="Ej: Rodrigo Gómez 623, Centro, Monterrey..."
			autocomplete="off"
		/>
		<ul class="address-search__results" id="address-search-results"></ul>
	</div>

	<div class="address-search__selected" id="address-search-selected">
		<div class="address-search__selected-icon">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor">
				<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<polyline points="22 4 12 14.01 9 11.01" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</div>
		<div class="address-search__selected-content">
			<span class="address-search__selected-label">Dirección seleccionada:</span>
			<span class="address-search__selected-address" id="address-search-selected-text">Sin dirección seleccionada</span>
		</div>
	</div>

	<div class="address-search__map" id="address-search-map"></div>

	<input type="hidden" name={addressInputName} id="address-search-address" value="" />
	<input type="hidden" name={latitudeInputName} id="address-search-lat" value={initialLat} />
	<input type="hidden" name={longitudeInputName} id="address-search-lng" value={initialLng} />

	<div class="address-search__footer">
		<div class="address-search__coords">
			<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
				<circle cx="12" cy="12" r="10" stroke-width="2"/>
				<line x1="2" y1="12" x2="22" y2="12" stroke-width="2"/>
				<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke-width="2"/>
			</svg>
			<span>Lat: <strong id="address-search-lat-display">{initialLat}</strong></span>
			<span>Lng: <strong id="address-search-lng-display">{initialLng}</strong></span>
		</div>
		<div class="address-search__tip">
			💡 Puedes arrastrar el marcador rojo para ajustar la ubicación
		</div>
	</div>
</div>

<style>
	.address-search {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding: 20px;
		background: linear-gradient(135deg, #fafafa 0%, #f5f5f5 100%);
		border-radius: 12px;
		border: 2px solid #e8e8e8;
	}

	.address-search__header {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.address-search__label {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 15px;
		font-weight: 700;
		color: #1a1a1a;
	}

	.address-search__label svg {
		color: #d4534f;
	}

	.address-search__hint {
		margin: 0;
		font-size: 13px;
		color: #666;
		padding-left: 28px;
	}

	.address-search__input-group {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.address-search__input {
		flex: 1;
		margin: 0 !important;
		padding: 12px 16px;
		font-size: 16px;
		height: 50px;
		border-radius: 8px;
		border: 1px solid #e0e0e0;
		transition: all 0.2s ease;
	}

	.address-search__input:hover {
		border-color: #d4534f;
	}

	.address-search__input:focus {
		border-color: #d4534f;
		box-shadow: 0 0 0 4px rgba(212, 83, 79, 0.1);
		outline: none;
	}

	:global(.address-search__results) {
		display: none;
		position: absolute;
		top: calc(100% + 8px);
		left: 0;
		right: 0;
		z-index: 10000;
		background: #ffffff;
		border-radius: 12px;
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
		border: 1px solid rgba(0,0,0,0.05);
		list-style: none;
		padding: 0;
		margin: 0;
		max-height: 300px;
		overflow-y: auto;
	}

	:global(.address-search__results.has-results) {
		display: block;
		animation: slideDown 0.2s ease-out;
	}

	@keyframes slideDown {
		from { opacity: 0; transform: translateY(-10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	:global(.address-search__result-item) {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 16px;
		cursor: pointer !important;
		border-bottom: 1px solid #f3f4f6;
		transition: all 0.15s ease;
		font-size: 14px;
		color: #4b5563;
	}

	:global(.address-search__result-item:last-child) {
		border-bottom: none;
	}

	:global(.address-search__result-item:hover),
	:global(.address-search__result-item:focus) {
		background-color: #ffe4e6;
		color: #991b1b;
		padding-left: 20px;
		outline: none;
	}

	:global(.address-search__result-item .icon-marker) {
		font-size: 1.2em;
		opacity: 0.6;
	}

	:global(.address-search__result-item:hover .icon-marker) {
		opacity: 1;
		transform: scale(1.1);
	}


	.address-search__selected {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 16px;
		background: linear-gradient(135deg, #d4f8e8 0%, #c8f3e0 100%);
		border: 2px solid #10b981;
		border-radius: 10px;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.address-search__selected.visible {
		opacity: 1;
	}

	.address-search__selected-icon {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: #10b981;
		color: #ffffff;
		border-radius: 50%;
	}

	.address-search__selected-content {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.address-search__selected-label {
		font-size: 12px;
		font-weight: 600;
		color: #059669;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.address-search__selected-address {
		font-size: 14px;
		font-weight: 600;
		color: #1a1a1a;
		line-height: 1.4;
	}

	.address-search__map {
		width: 100%;
		height: 450px;
		border-radius: 12px;
		overflow: hidden;
		border: 3px solid #d4534f;
		box-shadow: 0 4px 16px rgba(212, 83, 79, 0.2);
	}

	.address-search__footer {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.address-search__coords {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 16px;
		background: #ffffff;
		border-radius: 8px;
		font-size: 13px;
		color: #666;
		border: 1px solid #e0e0e0;
	}

	.address-search__coords svg {
		color: #d4534f;
		flex-shrink: 0;
	}

	.address-search__coords strong {
		color: #1a1a1a;
		font-weight: 700;
	}

	.address-search__tip {
		padding: 10px 14px;
		const searchInput = document.getElementById('address-search-input') as HTMLInputElement;
		const resultsList = document.getElementById('address-search-results') as HTMLUListElement;
		const latInput = document.getElementById('address-search-lat') as HTMLInputElement;
		font-size: 13px;
		color: #666;
		text-align: center;
	}

	@media (max-width: 768px) {
		.address-search {
			padding: 16px;
		}

		.address-search__input-group {
			flex-direction: column;
		}

		.address-search__map {
			height: 350px;
		}

		.address-search__coords {
			flex-wrap: wrap;
		}
	}
</style>

<script>
	import L from 'leaflet';
	import 'leaflet/dist/leaflet.css';

	function initAddressSearch() {
		const mapElement = document.getElementById('address-search-map');
		const searchInput = document.getElementById('address-search-input') as HTMLInputElement;
		const resultsList = document.getElementById('address-search-results') as HTMLUListElement;
		const latInput = document.getElementById('address-search-lat') as HTMLInputElement;
		const lngInput = document.getElementById('address-search-lng') as HTMLInputElement;
		const addressInput = document.getElementById('address-search-address') as HTMLInputElement;
		const latDisplay = document.getElementById('address-search-lat-display');
		const lngDisplay = document.getElementById('address-search-lng-display');
		const selectedContainer = document.getElementById('address-search-selected');
		const selectedText = document.getElementById('address-search-selected-text');

		if (!mapElement) return;

		const initialLat = parseFloat(latInput.value) || 25.6866;
		const initialLng = parseFloat(lngInput.value) || -100.3161;

		const map = L.map(mapElement).setView([initialLat, initialLng], 13);

		L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
			attribution: '© OpenStreetMap contributors',
			maxZoom: 19,
		}).addTo(map);

		const redIcon = L.icon({
			iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
			shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
			iconSize: [25, 41],
			iconAnchor: [12, 41],
			popupAnchor: [1, -34],
			shadowSize: [41, 41]
		});

		let marker = L.marker([initialLat, initialLng], {
			draggable: true,
			icon: redIcon
		}).addTo(map);

		marker.bindPopup('Arrastra para ajustar la ubicación').openPopup();

		function updateCoordinates(lat: number, lng: number) {
			latInput.value = lat.toFixed(6);
			lngInput.value = lng.toFixed(6);
			if (latDisplay) latDisplay.textContent = lat.toFixed(6);
			if (lngDisplay) lngDisplay.textContent = lng.toFixed(6);
		}

		function updateAddress(address: string) {
			if (addressInput) addressInput.value = address;
			if (selectedText) selectedText.textContent = address;
			if (selectedContainer) selectedContainer.classList.add('visible');
		}

		async function reverseGeocode(lat: number, lng: number) {
			try {
				const response = await fetch(
					`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&zoom=18&addressdetails=1`
				);
				const result = await response.json();

				if (result && result.display_name) {
					updateAddress(result.display_name);
				}
			} catch (error) {
				console.error('Error en reverse geocoding:', error);
			}
		}

		marker.on('dragend', async () => {
			const pos = marker.getLatLng();
			updateCoordinates(pos.lat, pos.lng);
			await reverseGeocode(pos.lat, pos.lng);
		});

		let searchTimeout: number | null = null;
		let activeController: AbortController | null = null;

		function clearResults() {
			if (!resultsList) return;
			resultsList.innerHTML = '';
			resultsList.classList.remove('has-results');
		}

		async function searchAddress(query: string) {
			if (activeController) {
				activeController.abort();
			}
			activeController = new AbortController();

			try {
				const response = await fetch(
					`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(query)}&limit=6&addressdetails=1`,
					{ signal: activeController.signal },
				);
				const results = await response.json();

				if (!resultsList) return;
				resultsList.innerHTML = '';
				
				if (!results.length) {
					clearResults();
					return;
				}

				resultsList.classList.add('has-results');
				
				results.forEach((result: any) => {
					const li = document.createElement('li');
					li.className = 'address-search__result-item';
					li.innerHTML = `
						<span class="icon-marker">📍</span>
						<span>${result.display_name}</span>
					`;
					
					li.addEventListener('click', () => {
						const lat = parseFloat(result.lat);
						const lng = parseFloat(result.lon);
						
						map.setView([lat, lng], 17);
						marker.setLatLng([lat, lng]);
						updateCoordinates(lat, lng);
						updateAddress(result.display_name);
						
						clearResults();
						searchInput.value = result.display_name;
						marker.bindPopup('📍 ' + result.display_name).openPopup();
					});
					
					resultsList.appendChild(li);
				});
			} catch (error) {
				if ((error as any)?.name !== 'AbortError') {
					console.error('Error searching address:', error);
				}
			}
		}

		searchInput?.addEventListener('input', () => {
			const query = searchInput.value.trim();
			if (searchTimeout) {
				window.clearTimeout(searchTimeout);
			}
			if (query.length < 3) {
				clearResults();
				return;
			}
			searchTimeout = window.setTimeout(() => {
				searchAddress(query);
			}, 300);
		});

		document.addEventListener('click', (e) => {
			if (searchInput && resultsList && !searchInput.contains(e.target as Node) && !resultsList.contains(e.target as Node)) {
				clearResults();
			}
		});

		if (initialLat !== 25.6866 || initialLng !== -100.3161) {
			reverseGeocode(initialLat, initialLng);
		}

		setTimeout(() => {
			map.invalidateSize();
		}, 100);
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initAddressSearch);
	} else {
		initAddressSearch();
	}
</script>
