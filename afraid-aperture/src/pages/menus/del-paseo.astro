          </a>
          <a
            class="txt nav nav-link"
            href="#caldos"
            style="--x: 760px; --y: 330px; --w: 237px; --h: 151px; --delay: 0.6s; z-index: 3;"
          >
            <img src={caldosSvgUrl} alt="CALDOS" style="width: 100%; height: 100%;" />
