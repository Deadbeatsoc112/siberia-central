{
	"main": "dist/_worker.js/index.js",
	"name": "siberia-central",
	"compatibility_date": "2026-01-28",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"bucket_name": "siberia-uploads",
			"binding": "siberia_uploads",
			"preview_bucket_name": "siberia-uploads"
		}
	],
	"d1_databases": [
		{
			"binding": "siberia_prod",
			"database_name": "siberia_prod",
			"database_id": "4f750fa2-c01a-4dc1-8a39-b12f149c1493",
			"remote": true
		}
	]
}
