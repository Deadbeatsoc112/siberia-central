---
import Footer from '../components/Footer.astro';
import navItemMarkUrl from '../assets/media/Enmascarar grupo 4@2x.png?url';

const { title = 'La Siberia Central', navTheme = 'overlay' } = Astro.props;
const isLightNav = navTheme === 'light';
const navItems = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Menú', href: '/menu-sucursales' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contacto', href: '/contacto' },
  { label: 'Bolsa de trabajo', href: '/bolsa-de-trabajo' },
];
const currentPath = Astro.url?.pathname ?? '/';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
		<body>
			<header class={`site-header ${isLightNav ? 'site-header--light' : ''}`}>
				<nav
					class={`site-nav ${isLightNav ? 'site-nav--light' : ''}`}
					aria-label="Principal"
					style={`--site-nav-mark-image: url(${navItemMarkUrl});`}
				>
				<button
					class="site-nav__toggle"
					type="button"
					aria-expanded="false"
					aria-controls="site-nav-list"
					aria-label="Abrir menú principal"
					data-nav-toggle
				>
					<span class="site-nav__hamburger" aria-hidden="true">
						<span class="site-nav__hamburger-line"></span>
						<span class="site-nav__hamburger-line"></span>
						<span class="site-nav__hamburger-line"></span>
					</span>
				</button>
				<ul id="site-nav-list" class="site-nav__list" data-nav-list>
					{navItems.map((item) => {
						const isMenuRoute = item.href === '/menu-sucursales' && currentPath.startsWith('/carta');
						const isActive =
							item.href === '/'
								? currentPath === '/'
								: currentPath.startsWith(item.href) || isMenuRoute;
						return (
							<li class="site-nav__item">
								<a class={`site-nav__link ${isActive ? 'is-active' : ''}`} href={item.href}>
									<span class="site-nav__link-mark" aria-hidden="true"></span>
									<span class="site-nav__link-label">{item.label}</span>
								</a>
							</li>
						);
					})}
				</ul>
			</nav>
		</header>
		<main class="page">
			<slot />
		</main>
		<Footer />
		<script>
			const nav = document.querySelector('.site-nav');
			const toggle = nav?.querySelector('[data-nav-toggle]');
			const list = nav?.querySelector('[data-nav-list]');
			const desktopMedia = window.matchMedia('(min-width: 769px)');

			if (
				nav instanceof HTMLElement &&
				toggle instanceof HTMLButtonElement &&
				list instanceof HTMLElement
			) {
				const setOpen = (isOpen) => {
					nav.classList.toggle('is-open', isOpen);
					toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
					toggle.setAttribute(
						'aria-label',
						isOpen ? 'Cerrar menú principal' : 'Abrir menú principal'
					);
				};

				toggle.addEventListener('click', () => {
					const isOpen = !nav.classList.contains('is-open');
					setOpen(isOpen);
				});

				list.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', () => setOpen(false));
				});

				document.addEventListener('keydown', (event) => {
					if (event.key === 'Escape') {
						setOpen(false);
					}
				});

				document.addEventListener('click', (event) => {
					if (!(event.target instanceof Node)) return;
					if (!nav.contains(event.target)) {
						setOpen(false);
					}
				});

				desktopMedia.addEventListener?.('change', (event) => {
					if (event.matches) {
						setOpen(false);
					}
				});
			}
		</script>
	</body>
</html>

<style>
	@font-face {
		font-family: "Campton";
		src: url("../assets/fonts/campton/CamptonThin.otf") format("opentype");
