---
import AdminCard from './AdminCard.astro';
import AdminInput from './AdminInput.astro';
import AdminButton from './AdminButton.astro';
import AddressSearch from './AddressSearch.astro';
import AdminBadge from './AdminBadge.astro';

interface Props {
	branches: any[];
}

const { branches } = Astro.props;
---

<div class="branches-tab">
	<div class="branches-tab__grid">
		<!-- Create Branch Card -->
		<AdminCard title="Nueva Sucursal" subtitle="Agrega una sucursal con ubicación en el mapa" variant="elevated">
			<form action="/api/admin/branches/create" method="post" class="branch-form">
				<div class="branch-form__fields">
					<AdminInput label="Nombre de la Sucursal" name="name" type="text" required />

					<AdminInput
						label="Dirección Completa"
						name="address"
						type="textarea"
						rows={2}
						required
						helper="Ej: Av. Rodrigo Gómez 623, Centro, Monterrey, NL"
					/>

					<AdminInput
						label="Teléfonos"
						name="phones"
						type="text"
						placeholder="8112573064, 8183780000"
						helper="Separa múltiples teléfonos con comas"
					/>

					<AdminInput label="Email de Contacto" name="contact_email" type="email" />

					<div class="branch-form__field-full">
						<label class="branch-form__label">Ubicación en el Mapa</label>
						<AddressSearch />
					</div>

					<div class="branch-form__inline">
						<AdminInput label="Orden de Visualización" name="display_order" type="number" value={0} />
						<label class="branch-form__checkbox">
							<input type="checkbox" name="is_active" checked />
							<span>Sucursal Activa</span>
						</label>
					</div>
				</div>

				<div class="branch-form__actions">
					<AdminButton type="submit" variant="primary" size="large" fullWidth>
						Crear Sucursal
					</AdminButton>
				</div>
			</form>
		</AdminCard>

		<!-- Branches List -->
		<AdminCard
			title="Sucursales Existentes"
			subtitle={`${branches.length} sucursal${branches.length !== 1 ? 'es' : ''} registradas`}
			variant="glass"
			fullHeight
		>
			{
				branches.length === 0 ? (
					<div class="branches-empty">
						<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path
								d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
							<polyline points="9 22 9 12 15 12 15 22" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
						<p>Aún no hay sucursales registradas</p>
					</div>
				) : (
					<div class="branches-list">
						{branches.map((branch, index) => (
							<div class="branch-item" data-branch-id={branch.id}>
								<div class="branch-item__header">
									<div class="branch-item__info">
										<div class="branch-item__title">
											<h4>{branch.name}</h4>
											<AdminBadge variant={branch.is_active ? 'success' : 'danger'} size="small">
												{branch.is_active ? 'Activa' : 'Inactiva'}
											</AdminBadge>
										</div>
										<p class="branch-item__slug">/{branch.slug}</p>
									</div>
									<span class="branch-item__order">#{index + 1}</span>
								</div>

								<div class="branch-item__details">
									<div class="branch-item__detail">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
											<path
												d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
											<circle cx="12" cy="10" r="3" stroke-width="2" />
										</svg>
										<span>{branch.address}</span>
									</div>
									{JSON.parse(branch.phones).length > 0 && (
										<div class="branch-item__detail">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
												<path
													d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
											<span>{JSON.parse(branch.phones).join(', ')}</span>
										</div>
									)}
									{branch.latitude && branch.longitude && (
										<div class="branch-item__detail">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
												<circle cx="12" cy="12" r="10" stroke-width="2" />
												<line x1="2" y1="12" x2="22" y2="12" stroke-width="2" />
												<path
													d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
													stroke-width="2"
												/>
											</svg>
											<span>
												{branch.latitude.toFixed(4)}, {branch.longitude.toFixed(4)}
											</span>
										</div>
									)}
								</div>

								<div class="branch-item__actions">
									<button type="button" class="branch-item__btn branch-item__btn--edit" onclick={`editBranch(${branch.id})`}>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
											<path
												d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
											<path
												d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
												stroke-width="2"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										Editar
									</button>
									<form action="/api/admin/branches/delete" method="post" style="display: inline;">
										<input type="hidden" name="id" value={branch.id} />
										<button type="submit" class="branch-item__btn branch-item__btn--delete" onclick="return confirm('¿Eliminar esta sucursal?')">
											<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor">
												<polyline points="3 6 5 6 21 6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
												<path
													d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
												/>
											</svg>
											Eliminar
										</button>
									</form>
								</div>
							</div>
						))}
					</div>
				)
			}
		</AdminCard>
	</div>
</div>

<style>
	.branches-tab {
		animation: fadeIn 0.5s ease-out;
	}

	.branches-tab__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 32px;
		align-items: start;
	}

	/* Branch Form */
	.branch-form__fields {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.branch-form__field-full {
		grid-column: 1 / -1;
	}

	.branch-form__label {
		display: block;
		font-family: 'Inter', -apple-system, sans-serif;
		font-size: 14px;
		font-weight: 600;
		color: #2a2a2a;
		margin-bottom: 12px;
	}

	.branch-form__inline {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 20px;
		align-items: end;
	}

	.branch-form__checkbox {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		background: #f8f8f8;
		border-radius: 10px;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.branch-form__checkbox:hover {
		background: #f0f0f0;
	}

	.branch-form__checkbox input[type='checkbox'] {
		width: 20px;
		height: 20px;
		cursor: pointer;
		accent-color: #d4534f;
	}

	.branch-form__actions {
		margin-top: 28px;
	}

	/* Branches List */
	.branches-empty {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 60px 20px;
		color: #999;
		text-align: center;
	}

	.branches-empty svg {
		margin-bottom: 16px;
		opacity: 0.5;
	}

	.branches-empty p {
		margin: 0;
		font-size: 16px;
	}

	.branches-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.branch-item {
		background: linear-gradient(135deg, #ffffff 0%, #fafafa 100%);
		border: 2px solid #f0f0f0;
		border-radius: 12px;
		padding: 20px;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.branch-item:hover {
		border-color: #d4534f;
		box-shadow: 0 8px 24px rgba(212, 83, 79, 0.15);
		transform: translateY(-2px);
	}

	.branch-item__header {
		display: flex;
		justify-content: space-between;
		align-items: start;
		margin-bottom: 16px;
		padding-bottom: 16px;
		border-bottom: 1px solid #f0f0f0;
	}

	.branch-item__info {
		flex: 1;
	}

	.branch-item__title {
		display: flex;
		align-items: center;
		gap: 12px;
		margin-bottom: 6px;
	}

	.branch-item__title h4 {
		margin: 0;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 22px;
		font-weight: 700;
		color: #1a1a1a;
	}

	.branch-item__slug {
		margin: 0;
		font-family: 'Inter', monospace;
		font-size: 13px;
		color: #999;
	}

	.branch-item__order {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: #f5f5f5;
		border-radius: 8px;
		font-weight: 700;
		color: #666;
		font-size: 14px;
	}

	.branch-item__details {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 16px;
	}

	.branch-item__detail {
		display: flex;
		align-items: start;
		gap: 10px;
		font-size: 14px;
		color: #666;
		line-height: 1.5;
	}

	.branch-item__detail svg {
		flex-shrink: 0;
		margin-top: 2px;
		color: #d4534f;
	}

	.branch-item__actions {
		display: flex;
		gap: 10px;
	}

	.branch-item__btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 16px;
		border: 2px solid;
		border-radius: 8px;
		font-family: 'Inter', -apple-system, sans-serif;
		font-size: 14px;
		font-weight: 600;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.branch-item__btn--edit {
		background: transparent;
		border-color: #8b5a2b;
		color: #8b5a2b;
	}

	.branch-item__btn--edit:hover {
		background: #8b5a2b;
		color: #ffffff;
	}

	.branch-item__btn--delete {
		background: transparent;
		border-color: #ef4444;
		color: #ef4444;
	}

	.branch-item__btn--delete:hover {
		background: #ef4444;
		color: #ffffff;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 1200px) {
		.branches-tab__grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	(window as any).editBranch = (id: number) => {
		alert(`Funcionalidad de edición para sucursal ${id} - Por implementar en modal`);
	};
</script>
