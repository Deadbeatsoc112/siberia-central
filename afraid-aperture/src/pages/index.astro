---
import Layout from '../layouts/Layout.astro';
import heroMainBgUrl from '../assets/fondos/Inicio.png?url';
import heroMainBg2xUrl from '../assets/media/Grupo 206@2x.png?url';
import heroBackgroundUrl from '../assets/media/Grupo 198.png?url';
import heroLogoUrl from '../assets/media/logologito.png?url';
import heroLogo2xUrl from '../assets/media/logologito.png?url';
import storyImageUrl from '../assets/media/Grupo 27.png?url';
import storyImage2xUrl from '../assets/media/Grupo 27@2x.png?url';
import menuImageOneUrl from '../assets/Tosdata.jpg?url';
import menuImageOne2xUrl from '../assets/Tosdata.jpg?url';
import menuImageTwoUrl from '../assets/Taco.jpg?url';
import menuImageTwo2xUrl from '../assets/Taco.jpg?url';
import menuImageThreeUrl from '../assets/Tlalp.jpg?url';
import menuImageThree2xUrl from '../assets/Tlalp.jpg?url';
import menuBandUrl from '../assets/media/Enmascarar grupo 9.png?url';
import menuBand2xUrl from '../assets/media/Enmascarar grupo 9@2x.png?url';
import billingBgUrl from '../assets/fondos/inicio_2.jpg?url';
const billingBg2xUrl = billingBgUrl;
import billingDecorUrl from '../assets/media/Grupo 36.svg?url';
import decorativeStarsUrl from '../assets/media/Grupo 24.svg?url';
---

<Layout title="Inicio | La Siberia Central">
	<section
		class="hero"
		style={`--hero-bg: image-set(url(${heroMainBgUrl}) 1x, url(${heroMainBg2xUrl}) 2x););`}
	>
		<div class="hero__bg hero__bg--image" aria-hidden="true"></div>
		<div class="hero__bg hero__bg--resources" aria-hidden="true"></div>
		<div class="hero__overlay" aria-hidden="true"></div>
		<div class="hero__content">
			<img
				class="hero__logo"
				src={heroLogoUrl}
				srcset={`${heroLogoUrl} 1x, ${heroLogo2xUrl} 2x`}
				alt="La Siberia Central"
				loading="eager"
			/>
			<h1 class="hero__title">La Siberia Central</h1>
		</div>
	</section>
	<section
		class="hero-followup"
		style={`background-image: url(${heroBackgroundUrl});`}
		aria-labelledby="historia-title"
	>
		<div class="story">
			<div
				class="story__image"
				style={`background-image: url(${storyImageUrl});`}
				aria-hidden="true"
			></div>
			<div class="story__content">
				<h2 id="historia-title" class="story__title">Nuestra Historia</h2>
				<span class="story__rule" aria-hidden="true"></span>
				<p class="story__text">
La Siberia Central nació del deseo de una familia por ofrecer algo sencillo pero auténtico: una mesa donde la gente se sienta bienvenida y bien atendida.
Con el paso del tiempo, esa mesa se convirtió en un lugar de reunión para generaciones de regiomontanos, un espacio donde se comparten platillos, risas y momentos que se guardan en la memoria.
Hoy seguimos siendo ese mismo lugar: un restaurante familiar que honra su origen y se esfuerza por mantener la calidad y el cariño en cada visita.
Porque para nosotros, más que servir tostadas, se trata de seguir siendo parte de las historias que se cuentan alrededor de la mesa.
<br/>	SOMOS UNA TRADICIÓN MUY REGIA.
				</p>
				<a class="story__button" href="/nosotros">Más sobre nosotros</a>
			</div>
		</div>
	</section>
	<section class="menu" aria-labelledby="menu-title">
		<div class="menu__intro">
			<h2 id="menu-title" class="menu__title">Elige tu próximo plato favorito</h2>
			<p class="menu__subtitle">Recetas con historia, hechas para compartir con tu gente</p>
			<a class="menu__button" href="/menu-sucursales">Ver Menú</a>
		</div>
		<div
			class="menu__band"
			style={`background-image: image-set(url(${menuBandUrl}) 1x, url(${menuBand2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
		<div class="menu__gallery">
			<figure class="menu__card">
				<img
					src={menuImageOneUrl}
					srcset={`${menuImageOneUrl} 1x, ${menuImageOne2xUrl} 2x`}
					alt="Plato destacado de La Siberia Central"
					loading="lazy"
				/>
			</figure>
			<figure class="menu__card">
				<img
					src={menuImageTwoUrl}
					srcset={`${menuImageTwoUrl} 1x, ${menuImageTwo2xUrl} 2x`}
					alt="Especialidad de la casa"
					loading="lazy"
				/>
			</figure>
			<figure class="menu__card">
				<img
					src={menuImageThreeUrl}
					srcset={`${menuImageThreeUrl} 1x, ${menuImageThree2xUrl} 2x`}
					alt="Plato favorito de nuestros clientes"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>
	<section class="billing" aria-labelledby="billing-title">
		<div
			class="billing__bg"
			style={`background-image: image-set(url(${billingBgUrl}) 1x, url(${billingBg2xUrl}) 2x);`}
			aria-hidden="true"
		></div>
			<div class="billing__overlay" aria-hidden="true"></div>
			<div class="billing__content">
				<h2 id="billing-title" class="billing__title">¿Factura? Súper fácil</h2>
				<a class="billing__button" href="#facturacion-form">Factura Aquí</a>
			</div>
			<img class="billing__decor" src={billingDecorUrl} alt="" aria-hidden="true" />
		</section>
		<section id="facturacion-form" class="billing-form" aria-labelledby="billing-form-title">
			<div class="billing-form__inner">
				<h2 id="billing-form-title" class="billing-form__title">Formulario de facturación</h2>
				<span class="billing-form__rule" aria-hidden="true"></span>
				<p class="billing-form__subtitle">
					Comparte tus datos para gestionar tu factura de manera correcta.
				</p>
				<form class="billing-form__form" action="#" method="post" enctype="multipart/form-data" onsubmit="return false">
						<div class="billing-form__column">
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-name">Nombre completo*</label>
								<input class="billing-form__input" id="billing-name" name="full_name" type="text" required />
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-rfc">RFC*</label>
								<div class="billing-form__rfc-group">
									<select class="billing-form__input billing-form__select" id="billing-rfc-type" name="rfc_person_type" required>
										<option value="fisica" selected>Persona Fisica</option>
										<option value="moral">Persona Moral</option>
									</select>
									<input
										class="billing-form__input"
										id="billing-rfc"
										name="rfc"
										type="text"
										required
										minlength="13"
										maxlength="13"
										pattern="^[A-Z&]{4}[0-9]{6}[A-Z0-9]{3}$"
										title="RFC de Persona Fisica: 13 caracteres."
									/>
								</div>
								<span class="billing-form__hint" id="billing-rfc-hint">Persona Fisica: captura 13 caracteres para RFC.</span>
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-business-name">Razon social*</label>
								<input
									class="billing-form__input"
									id="billing-business-name"
									name="business_name"
									type="text"
									required
								/>
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-tax-regime">Regimen fiscal*</label>
								<select class="billing-form__input billing-form__select" id="billing-tax-regime" name="tax_regime" required>
									<option value="" selected disabled>Selecciona un regimen</option>
									<option value="601">General de Ley Personas Morales</option>
									<option value="603">Personas Morales con Fines no Lucrativos</option>
									<option value="605">Sueldos y Salarios e Ingresos Asimilados a Salarios</option>
									<option value="606">Arrendamiento</option>
									<option value="607">Regimen de Enajenacion o Adquisicion de Bienes</option>
									<option value="608">Demas ingresos</option>
									<option value="609">Consolidacion</option>
									<option value="610">Residentes en el Extranjero sin Establecimiento Permanente en Mexico</option>
									<option value="611">Ingresos por Dividendos (socios y accionistas)</option>
									<option value="612">Personas Fisicas con Actividades Empresariales y Profesionales</option>
									<option value="614">Ingresos por Intereses</option>
									<option value="615">Regimen de los Ingresos por Obtencion de Premios</option>
									<option value="616">Sin obligaciones fiscales</option>
									<option value="620">Sociedades Cooperativas de Produccion que optan por diferir sus ingresos</option>
									<option value="621">Incorporacion Fiscal</option>
									<option value="622">Actividades Agricolas, Ganaderas, Silvicolas y Pesqueras</option>
									<option value="623">Opcional para Grupos de Sociedades</option>
									<option value="624">Coordinados</option>
									<option value="625">Actividades Empresariales con ingresos a traves de Plataformas Tecnologicas</option>
									<option value="626">Regimen Simplificado de Confianza (RESICO - Personas Fisicas)</option>
									<option value="628">Hidrocarburos</option>
									<option value="629">Regimenes Fiscales Preferentes y de las Empresas Multinacionales</option>
									<option value="630">Enajenacion de acciones en bolsa de valores</option>
								</select>
							</div>
						</div>
						<div class="billing-form__column">
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-cfdi-use">Uso de CFDI*</label>
								<select class="billing-form__input billing-form__select" id="billing-cfdi-use" name="cfdi_use" required>
									<option value="" selected disabled>Selecciona el uso</option>
									<option value="D04">Donativos</option>
									<option value="G01">Adquisicion de mercancias</option>
									<option value="G02">Devoluciones, descuentos o bonificaciones</option>
									<option value="G03">Gastos en general</option>
									<option value="S01">Sin efectos fiscales</option>
								</select>
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-fiscal-address">Direccion fiscal*</label>
								<input class="billing-form__input" id="billing-fiscal-address" name="fiscal_address" type="text" required />
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-postal-code">Codigo postal*</label>
								<input class="billing-form__input" id="billing-postal-code" name="postal_code" type="text" required />
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-payment-method">Forma de pago*</label>
								<select class="billing-form__input billing-form__select" id="billing-payment-method" name="payment_method" required>
									<option value="" selected disabled>Selecciona una forma de pago</option>
									<option value="01">Efectivo</option>
									<option value="04">Tarjeta de credito</option>
									<option value="28">Tarjeta de debito</option>
								</select>
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-email">Correo electronico</label>
								<input class="billing-form__input" id="billing-email" name="email" type="email" />
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-phone">Telefono*</label>
								<input class="billing-form__input" id="billing-phone" name="phone" type="tel" required />
							</div>
							<div class="billing-form__field">
								<label class="billing-form__label" for="billing-ticket-file">Ticket o imagen (opcional)</label>
								<input
									class="billing-form__input"
									id="billing-ticket-file"
									name="ticket_file"
									type="file"
									accept=".jpg,.jpeg,.png,.webp,.pdf"
								/>
								<span class="billing-form__hint">Puedes subir foto o PDF del ticket.</span>
							</div>
						</div>
						<div class="billing-form__field billing-form__field--full">
							<label class="billing-form__label" for="billing-notes">Comentarios (opcional)</label>
							<textarea
								class="billing-form__textarea"
								id="billing-notes"
								name="notes"
								placeholder="Comparte aqui informacion adicional para tu factura."
							></textarea>
						</div>
						<div class="billing-form__actions">
							<button class="billing-form__button" type="submit">Enviar datos de facturacion</button>
						</div>
					</form>
			</div>
		</section>
		<section class="feedback-cta" aria-labelledby="feedback-title">
			<div class="feedback-cta__inner">
				<img class="feedback-cta__decor" src={decorativeStarsUrl} alt="" aria-hidden="true" />
				<h2 id="feedback-title" class="feedback-cta__title">Queremos leerte</h2>
				<p class="feedback-cta__subtitle">
					Si tienes comentarios o sugerencias, usa el formulario de contacto independiente.
				</p>
				<a class="feedback-cta__button" href="/contacto#form-title">Ir a contacto</a>
			</div>
		</section>
	</Layout>

<script>
	const reducedMotionMedia = window.matchMedia('(prefers-reduced-motion: reduce)');

	const storyImage = document.querySelector('.story__image');
	const storySection = document.querySelector('.hero-followup');

		if (storyImage instanceof HTMLElement && storySection instanceof HTMLElement) {
		let storySectionVisible = false;
		let storySpinLocked = false;
		let storySpinUnlockTimer;
		const storySpinDurationMs = 1000;

		const triggerStorySpin = () => {
			if (reducedMotionMedia.matches) return;
			if (storySpinLocked) return;

			storySpinLocked = true;
			storyImage.classList.remove('is-spin-turn');
			// Force reflow so the animation can restart on each trigger.
			void storyImage.offsetWidth;
			storyImage.classList.add('is-spin-turn');
			window.clearTimeout(storySpinUnlockTimer);
			storySpinUnlockTimer = window.setTimeout(() => {
				storySpinLocked = false;
			}, storySpinDurationMs + 120);
		};

		const storyObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.target !== storySection) return;
					if (entry.isIntersecting && !storySectionVisible) {
						storySectionVisible = true;
						triggerStorySpin();
					}
					if (!entry.isIntersecting) {
						storySectionVisible = false;
					}
				});
			},
			{
				threshold: 0.45,
			}
		);

		if (!reducedMotionMedia.matches) {
			storyObserver.observe(storySection);
		}

		reducedMotionMedia.addEventListener?.('change', () => {
			if (reducedMotionMedia.matches) {
				storyObserver.disconnect();
				storyImage.classList.remove('is-spin-turn');
				return;
			}
			if (!reducedMotionMedia.matches) {
				storyObserver.observe(storySection);
			}
		});

		const fallbackOnScroll = () => {
			if (reducedMotionMedia.matches) return;
			const rect = storySection.getBoundingClientRect();
			const viewportHeight = window.innerHeight || 1;
			const sectionInViewport = rect.top < viewportHeight * 0.65 && rect.bottom > viewportHeight * 0.35;
			if (sectionInViewport && !storySectionVisible) {
				storySectionVisible = true;
				triggerStorySpin();
			}
			if (!sectionInViewport) {
				storySectionVisible = false;
			}
		};

		storyImage.addEventListener('animationend', () => {
			storyImage.classList.remove('is-spin-turn');
		});

			window.addEventListener('scroll', fallbackOnScroll, { passive: true });
			window.addEventListener('resize', fallbackOnScroll);
		}

		const rfcTypeSelect = document.getElementById('billing-rfc-type');
		const rfcInput = document.getElementById('billing-rfc');
		const rfcHint = document.getElementById('billing-rfc-hint');

		if (rfcTypeSelect instanceof HTMLSelectElement && rfcInput instanceof HTMLInputElement) {
			const applyRfcValidation = () => {
				const isFisica = rfcTypeSelect.value === 'fisica';
				const requiredLength = isFisica ? 13 : 12;

				rfcInput.minLength = requiredLength;
				rfcInput.maxLength = requiredLength;
				rfcInput.pattern = isFisica
					? '^[A-Z&]{4}[0-9]{6}[A-Z0-9]{3}$'
					: '^[A-Z&]{3}[0-9]{6}[A-Z0-9]{3}$';
				rfcInput.title = isFisica
					? 'RFC de Persona Fisica: 13 caracteres.'
					: 'RFC de Persona Moral: 12 caracteres.';

				if (rfcHint instanceof HTMLElement) {
					rfcHint.textContent = isFisica
						? 'Persona Fisica: captura 13 caracteres para RFC.'
						: 'Persona Moral: captura 12 caracteres para RFC.';
				}

				if (rfcInput.value.length > requiredLength) {
					rfcInput.value = rfcInput.value.slice(0, requiredLength);
				}
			};

			rfcTypeSelect.addEventListener('change', applyRfcValidation);
			rfcInput.addEventListener('input', () => {
				rfcInput.value = rfcInput.value.toUpperCase().replace(/\s+/g, '');
			});
			applyRfcValidation();
		}
	</script>

<style>
	.hero {
		position: relative;
		top: 0px;
		left: 0px;
		width: 100%;
		height: 100vh;
		min-height: 680px;
		opacity: 1;
		overflow: hidden;
		isolation: isolate;
		display: flex;
		align-items: center;
		justify-content: center;
		text-align: center;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center ;
		background-repeat: no-repeat;
	}

	.hero__bg--image {
		background-image: var(--hero-bg);
		z-index: 0;
	}

	.hero__bg--resources {
		background-image: var(--hero-resources-bg);
		z-index: 2;
		pointer-events: none;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0);
		z-index: 1;
	}

	.hero__content {
		position: relative;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 16px;
		padding: 0 24px;
	}

	.hero__logo {
		width: 140px;
		height: 140px;
		opacity: 1;
	}

	.hero__title {
		margin: 0;
		font: normal normal bold 48px/1.2 Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 0px;
		color: #ffffff;
		text-shadow: 0px 3px 6px #000000;
		opacity: 1;
	}

	.hero-followup {
		position: relative;
		top: 0px;
		left: 0px;
		width: 100%;
		height: 1300px;
		--story-content-top: 30px;
		background-color: transparent;
		background-position: 0% 0%;
		background-repeat: no-repeat;
		opacity: 1;
	}

	.story {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.story__image {
		position: absolute;
		top: 163px;
		right: clamp(24px, 6vw, 120px);
		left: auto;
		width: min(32vw, 498px);
		height: min(32vw, 498px);
		max-width: 498px;
		max-height: 498px;
		box-sizing: border-box;
		--story-image-base-transform: matrix(0.98, -0.17, 0.17, 0.98, 0, 0);
		transform: var(--story-image-base-transform);
		background-repeat: no-repeat;
		background-position: center;
		background-size: cover;
		border: 10px solid #ffffff;
		box-shadow: 0px 12px 30px rgba(0, 0, 0, 0.35);
		opacity: 1;
		will-change: transform;
	}

	.story__image.is-spin-turn {
		animation: storyImageSpinTurn 1s cubic-bezier(0.22, 0.8, 0.2, 1) both;
	}

	@keyframes storyImageSpinTurn {
		0% {
			transform: var(--story-image-base-transform);
		}
		100% {
			transform: var(--story-image-base-transform) rotate(360deg);
		}
	}

	.story__content {
		position: absolute;
		top: var(--story-content-top);
		left: 25%;
		right: auto;
		transform: translateX(-50%);
		width: min(520px, 42vw);
		max-width: 520px;
		height: auto;
		padding: 0 24px;
		box-sizing: border-box;
		opacity: 1;
		color: #ffffff;
		text-align: left;
	}

	.story__title {
		margin: 0 0 18px;
		width: 487px;
		text-align: left;
		font: normal normal bold 60px/1.1 Campton, 'Montserrat', 'Arial', sans-serif;
		letter-spacing: 0px;
		color: #ffffff;
		opacity: 1;
		white-space: nowrap;
	}

	@media (max-width: 1366px) and (min-width: 1024px) {
		.hero-followup {
			--story-content-top: -30px;
		}

		.story__image {
			top: 150px;
			right: clamp(24px, 4vw, 80px);
			width: min(34vw, 460px);
			height: min(34vw, 460px);
		}

		.story__content {
			max-width: 600px;
		}
	}

	.story__rule {
		display: block;
		width: 260px;
		height: 2px;
		background: #ffffff;
		margin-bottom: 22px;
	}

	.story__text {
		margin: 0 0 32px;
		font-size: 18px;
		line-height: 28px;
		max-width: 626px;
		opacity: 0.95;
	}

	.story__button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 306px;
		height: 58px;
		border: 2px solid #ffffff;
		color: #ffffff;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0px;
		opacity: 1;
	}

	@media (max-width: 1200px) {
		.hero {
			min-height: 560px;
		}

		.hero__logo {
			width: 110px;
			height: 110px;
		}

		.hero__title {
			font-size: 36px;
			line-height: 1.25;
		}

		.hero-followup {
			height: 760px;
			--story-content-top: 130px;
			background-position: center top;
			background-size: cover;
		}

		.story__image {
			top: 60px;
			left: 50%;
			--story-image-base-transform: translateX(-50%) rotate(-8deg);
			transform: var(--story-image-base-transform);
			width: 320px;
			height: 320px;
			border-width: 8px;
		}

		.story__content {
			left: 10%;
			width: 80%;
			height: auto;
			transform: none;
		}

		.story__title {
			width: auto;
