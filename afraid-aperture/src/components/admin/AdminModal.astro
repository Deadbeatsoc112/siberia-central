---
interface Props {
	id: string;
	title?: string;
	size?: 'small' | 'medium' | 'large' | 'fullscreen';
}

const { id, title, size = 'medium' } = Astro.props;
---

<div class={`admin-modal admin-modal--${size}`} id={id} data-modal>
	<div class="admin-modal__overlay" data-modal-close></div>
	<div class="admin-modal__container">
		<div class="admin-modal__content">
			{title && (
				<div class="admin-modal__header">
					<h3 class="admin-modal__title">{title}</h3>
					<button class="admin-modal__close" data-modal-close type="button" aria-label="Cerrar">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
							<path
								d="M18 6L6 18M6 6l12 12"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						</svg>
					</button>
				</div>
			)}
			<div class="admin-modal__body">
				<slot />
			</div>
		</div>
	</div>
</div>

<style>
	.admin-modal {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 9999;
		display: none;
		align-items: center;
		justify-content: center;
		padding: 20px;
	}

	.admin-modal.is-open {
		display: flex;
	}

	.admin-modal__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: rgba(0, 0, 0, 0.6);
		backdrop-filter: blur(4px);
		animation: fadeIn 0.3s ease-out;
		cursor: pointer;
	}

	.admin-modal__container {
		position: relative;
		width: 100%;
		max-height: 90vh;
		z-index: 1;
		animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.admin-modal--small .admin-modal__container {
		max-width: 480px;
	}

	.admin-modal--medium .admin-modal__container {
		max-width: 720px;
	}

	.admin-modal--large .admin-modal__container {
		max-width: 1000px;
	}

	.admin-modal--fullscreen .admin-modal__container {
		max-width: 95vw;
		max-height: 95vh;
	}

	.admin-modal__content {
		background: #ffffff;
		border-radius: 20px;
		box-shadow:
			0 25px 50px rgba(0, 0, 0, 0.15),
			0 10px 20px rgba(0, 0, 0, 0.1);
		max-height: 90vh;
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.admin-modal__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 28px 32px;
		border-bottom: 2px solid #f0f0f0;
	}

	.admin-modal__title {
		margin: 0;
		font-family: 'Playfair Display', Georgia, serif;
		font-size: 28px;
		font-weight: 700;
		color: #1a1a1a;
		letter-spacing: -0.5px;
	}

	.admin-modal__close {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border: none;
		background: #f5f5f5;
		border-radius: 10px;
		color: #666;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.admin-modal__close:hover {
		background: #e8e8e8;
		color: #d4534f;
		transform: rotate(90deg);
	}

	.admin-modal__body {
		padding: 32px;
		overflow-y: auto;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(30px) scale(0.95);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@media (max-width: 768px) {
		.admin-modal__container {
			max-width: 100%;
		}

		.admin-modal__header {
			padding: 20px 24px;
		}

		.admin-modal__title {
			font-size: 22px;
		}

		.admin-modal__body {
			padding: 24px;
		}
	}
</style>

<script>
	function initModals() {
		document.querySelectorAll('[data-modal]').forEach((modal) => {
			const modalElement = modal as HTMLElement;
			const closeButtons = modalElement.querySelectorAll('[data-modal-close]');

			closeButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					modalElement.classList.remove('is-open');
					document.body.style.overflow = '';
				});
			});
		});

		// Global open modal function
		(window as any).openModal = (modalId: string) => {
			const modal = document.getElementById(modalId);
			if (modal) {
				modal.classList.add('is-open');
				document.body.style.overflow = 'hidden';
			}
		};

		// Global close modal function
		(window as any).closeModal = (modalId: string) => {
			const modal = document.getElementById(modalId);
			if (modal) {
				modal.classList.remove('is-open');
				document.body.style.overflow = '';
			}
		};
	}

	// Initialize on load and after navigation
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initModals);
	} else {
		initModals();
	}
</script>
