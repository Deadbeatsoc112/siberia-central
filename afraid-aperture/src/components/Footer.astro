---
import logoUrl from '../assets/media/Enmascarar grupo 4.png?url';
import logo2xUrl from '../assets/media/Enmascarar grupo 4@2x.png?url';

const enlaces = [
	{ label: "Inicio", href: "/" },
	{ label: "Nosotros", href: "/nosotros" },
	{ label: "Menú", href: "/menu" },
	{ label: "Blog", href: "/blog" },
	{ label: "Contacto", href: "/contacto" },
];
---

<footer class="footer">
	<div class="wrap">
		<!-- Col 1: Logo -->
		<div class="col logoCol">
			<a class="logoLink" href="/" aria-label="Ir al inicio">
				<img
					class="logo"
					src={logoUrl}
					srcset={`${logoUrl} 1x, ${logo2xUrl} 2x`}
					alt="La Siberia Central"
					width="209"
					height="208"
					loading="lazy"
				/>
			</a>
		</div>

		<!-- Col 2: Enlaces -->
		<div class="col">
			<h3 class="title">Enlaces</h3>
			<nav aria-label="Enlaces del sitio">
				<ul class="list">
					{enlaces.map((i) => (
						<li><a class="link" href={i.href}>{i.label}</a></li>
					))}
				</ul>
			</nav>
		</div>

		<!-- Col 3: Sucursales -->
		<div class="col col--branches">
			<h3 class="title">Sucursales</h3>
			<a class="btnOutline" href="/sucursales">Ver todas las sucursales</a>
		</div>

		<!-- Col 4: Horario + redes -->
		<div class="col">
			<h3 class="title">Horario</h3>
			<p class="text">Lunes a viernes</p>
			<p class="text">00:00 am- 00:00pm</p>

			<div class="social" aria-label="Redes sociales">
				<a class="iconBtn" href="https://facebook.com" target="_blank" rel="noreferrer" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
					</svg>
				</a>

				<a class="iconBtn" href="https://instagram.com" target="_blank" rel="noreferrer" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
					</svg>
				</a>

				<a class="iconBtn" href="https://tiktok.com" target="_blank" rel="noreferrer" aria-label="TikTok">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
					</svg>
				</a>

				<a class="iconBtn" href="https://wa.me/0000000000" target="_blank" rel="noreferrer" aria-label="WhatsApp">
					<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
					</svg>
				</a>
			</div>
		</div>
	</div>

</footer>

<style>
	.footer {
		background: #161615;
		color: #fff;
		min-height: 519px;
		padding: 70px 0;
		position: relative;
		display: flex;
		align-items: center;
		opacity: 1;
	}

	.wrap {
		max-width: 1500px;
		width: 100%;
		margin: 0 auto;
		padding: 0 60px;
		display: grid;
		grid-template-columns: 280px max-content max-content minmax(200px, 1fr);
		column-gap: 100px;
		row-gap: 60px;
		align-items: start;
		box-sizing: border-box;
	}

	.col {
		min-width: 0;
		align-self: start;
	}

	.col--branches {
		text-align: center;
	}

	.col--branches .btnOutline {
		display: inline-flex;
		margin: 0 auto;
	}

	.logoCol {
		display: flex;
		justify-content: center;
	}

	.logo {
		display: block;
		width: 180px;
		height: 180px;
		obacity: 1;
	}

	.title {
		font-size: 24px;
		font-weight: 700;
		margin: 0 0 14px;
		letter-spacing: 0.2px;
	}

	.list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 10px;
	}

	.link {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-size: 19px;
		line-height: 1.2;
		transition: opacity 0.15s ease;
	}

	.link:hover {
		opacity: 0.75;
	}

	.btnOutline {
		display: block;
		width: fit-content;
		padding: 10px 18px;
		border: 1px solid rgba(255, 255, 255, 0.55);
		color: #fff;
		text-decoration: none;
		font-size: 17px;
		border-radius: 2px;
		background: transparent;
		white-space: nowrap;
	}

	.btnOutline:hover {
		border-color: rgba(255, 255, 255, 0.8);
	}

	.text {
		margin: 0 0 8px;
		font-size: 19px;
		color: rgba(255, 255, 255, 0.85);
	}

	.social {
		display: flex;
		gap: 12px;
		margin-top: 14px;
	}

	.iconBtn {
		width: 40px;
		height: 40px;
		border-radius: 999px;
		background: transparent;
		border: 1.5px solid rgba(255, 255, 255, 0.85);
		color: #fff;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.iconBtn:hover,
	.iconBtn:focus-visible {
		transform: translateY(-3px);
		background: rgba(255, 255, 255, 0.08);
	}

	.iconBtn svg {
		width: 20px;
		height: 20px;
		fill: #fff;
	}



	@media (max-width: 1400px) {
		.wrap {
			padding: 0 60px;
			gap: 50px;
			grid-template-columns: 200px max-content max-content minmax(180px, 1fr);
		}

		.logo {
			width: 150px;
			height: 150px;
		}
	}

	@media (max-width: 1024px) {
		.footer {
			min-height: auto;
			padding: 50px 0;
		}

		.wrap {
			padding: 0 40px;
			grid-template-columns: 140px max-content max-content minmax(160px, 1fr);
			gap: 40px;
		}

		.logo {
			width: 120px;
			height: 120px;
		}
	}

	@media (max-width: 768px) {
		.wrap {
			padding: 0 30px;
			grid-template-columns: 1fr;
			gap: 36px;
		}

		.logoCol {
			justify-content: center;
		}

		.logo {
			width: 110px;
			height: 110px;
		}
	}
</style>


