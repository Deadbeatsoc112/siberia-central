    <script>
      // Escala proporcional del canvas en pantallas pequeñas
      const CANVAS_W = 1080;

      function applyScale() {
        const frame = document.getElementById('frame');
        if (!frame) return;

        const sidePad = 32; // debe coincidir con --side-pad
        const available = Math.max(320, window.innerWidth - sidePad * 2);
        const scale = Math.min(1, available / CANVAS_W);

        frame.style.setProperty('--scale', String(scale));
      }

      window.addEventListener('resize', applyScale);
      applyScale();
    </script>

    <style define:vars={{ camptonUrl }}>
      :root {
        --canvas-w: 1080px;
        --canvas-h: 13949px;
        --side-pad: 32px;
        --scale: 1;
        --text-scale: 1.21;
        --item-name-size: calc(30px * var(--text-scale));
        --item-price-size: calc(28px * var(--text-scale));
        --item-desc-size: calc(22px * var(--text-scale));
      }

      @font-face {
        font-family: 'Londrina Solid';
        src: url('/fonts/londrina/LondrinaSolid-Thin.ttf') format('truetype');
        font-weight: 200;
        font-style: normal;
