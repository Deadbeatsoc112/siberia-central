---
interface Props {
	menuId: number;
	branchName: string;
	branchSlug: string;
}

const { menuId, branchName, branchSlug } = Astro.props;
---

<div class="menu-modal" id={`menu-modal-${menuId}`} data-menu-id={menuId} data-branch-slug={branchSlug}>
	<div class="menu-modal__overlay" data-close-modal></div>
	<div class="menu-modal__container">
		<button class="menu-modal__close" data-close-modal aria-label="Cerrar">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6L6 18M6 6l12 12"/>
			</svg>
		</button>

		<iframe
			class="menu-modal__iframe"
			id={`menu-iframe-${menuId}`}
			title={`Menú ${branchName}`}
		></iframe>
	</div>
</div>

<style>
	.menu-modal {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
	}

	.menu-modal.is-open {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__overlay {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.92);
		cursor: pointer;
		backdrop-filter: blur(4px);
	}

	.menu-modal__container {
		position: relative;
		width: min(1489px, 98vw);
		max-height: 95vh;
		background: #111111;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
		display: flex;
		flex-direction: column;
	}

	.menu-modal__close {
		position: absolute;
		top: 16px;
		right: 16px;
		width: 52px;
		height: 52px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		background: rgba(0, 0, 0, 0.6);
		color: #fff;
		border-radius: 50%;
		cursor: pointer;
		z-index: 10;
		transition: all 0.3s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.menu-modal__close:hover {
		background: #e1454f;
		border-color: #e1454f;
		transform: rotate(90deg) scale(1.1);
	}

	.menu-modal__close svg {
		width: 28px;
		height: 28px;
	}

	.menu-modal__iframe {
		width: 100%;
		height: 100%;
		border: none;
		background: #111111;
	}

	@media (max-width: 900px) {
		.menu-modal__container {
			width: 100vw;
			max-height: 100vh;
			border-radius: 0;
		}
	}

	@media (max-width: 600px) {
		.menu-modal__close {
			width: 44px;
			height: 44px;
			top: 12px;
			right: 12px;
		}

		.menu-modal__close svg {
			width: 24px;
			height: 24px;
		}
	}
</style>

<script>
	function initMenuModal() {
		document.querySelectorAll('.menu-modal').forEach((modal) => {
			modal.querySelectorAll('[data-close-modal]').forEach((btn) => {
				btn.addEventListener('click', () => {
					modal.classList.remove('is-open');
					document.body.style.overflow = '';
				});
			});
		});

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				document.querySelectorAll('.menu-modal.is-open').forEach((modal) => {
					modal.classList.remove('is-open');
					document.body.style.overflow = '';
				});
			}
		});
	}

	(window as any).openMenuModal = function (menuId: number) {
		const modal = document.getElementById(`menu-modal-${menuId}`);
		if (!modal) return;

		const iframe = document.getElementById(`menu-iframe-${menuId}`) as HTMLIFrameElement;
		const branchSlug = modal.getAttribute('data-branch-slug') || 'central';

		// Load iframe only once
		if (!iframe.src) {
			iframe.src = `/carta/${branchSlug}`;
		}

		modal.classList.add('is-open');
		document.body.style.overflow = 'hidden';
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initMenuModal);
	} else {
		initMenuModal();
	}
</script>
