    <script>
      // Escala proporcional del canvas en pantallas pequeñas
      const CANVAS_W = 1080;

      function applyScale() {
        const frame = document.getElementById('frame');
        if (!frame) return;

        const sidePad = 32; // debe coincidir con --side-pad
        const available = Math.max(320, window.innerWidth - sidePad * 2);
        const scale = Math.min(1, available / CANVAS_W);

        frame.style.setProperty('--scale', String(scale));
      }

      window.addEventListener('resize', applyScale);
      applyScale();
    </script>

    <style>
      :root {
        --canvas-w: 1080px;
        --canvas-h: 13949px;
        --side-pad: 32px;
        --scale: 1;
      }

      @font-face {
        font-family: 'Londrina Solid';
        src: url('/fonts/londrina/LondrinaSolid-Thin.ttf') format('truetype');
        font-weight: 200;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Londrina Solid';
        src: url('/fonts/londrina/LondrinaSolid-Light.ttf') format('truetype');
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Londrina Solid';
        src: url('/fonts/londrina/LondrinaSolid-Regular.ttf') format('truetype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Londrina Solid';
        src: url('/fonts/londrina/LondrinaSolid-Black.ttf') format('truetype');
        font-weight: 900;
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: 'Campton';
        src: url('../assets/fonts/campton/CamptonBold.otf') format('opentype');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        overflow-x: hidden;
      }

      body {
        background: #0b0b0b;
        color: #ffffff;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      }

      .page {
        min-height: 100vh;
        padding: 24px var(--side-pad);
        display: flex;
        justify-content: center;
        overflow-x: hidden;
      }

      /* Frame aplica el escalado al canvas */
      .frame {
        transform: scale(var(--scale));
        transform-origin: top center;
        will-change: transform;
      }

      /* Canvas fijo pixel-perfect */
      .canvas {
        position: relative;
        width: var(--canvas-w);
        height: var(--canvas-h);
        overflow: hidden;
        background-image: var(--menu-bg, none);
        background-repeat: no-repeat;
        background-position: top center;
        background-size: 100% 100%;
      }

      /* Helper base para elementos absolutos */
      .abs {
        position: absolute;
        top: var(--y, auto);
        left: var(--x, auto);
        width: var(--w, auto);
        height: var(--h, auto);
      }

      /* Helper para “sprites” con background */
      .img {
        background-repeat: no-repeat;
        background-position: center;
        background-size: contain;
        background-image: var(--img, none);
        pointer-events: none;
      }

      /* Helper para textos */
      .txt {
        position: absolute;
        top: var(--y, auto);
        left: var(--x, auto);
        width: var(--w, auto);
        color: var(--c, #ffffff);
        font-size: var(--fs, 24px);
        font-weight: var(--fw, 700);
        line-height: var(--lh, 1.1);
        letter-spacing: var(--ls, 0.4px);
        text-transform: var(--tt, uppercase);
        text-align: var(--ta, left);
        transform: var(--tf, none);
        text-shadow: var(--shadow, 0 4px 10px rgba(0, 0, 0, 0.35));
        white-space: pre-line;
        pointer-events: none;
      }

      /* =========================
         HEADER (0 - 1390)
         ========================= */
      .header {
        position: relative;
        width: 100%;
        height: 1390px;
        background: url('/img/Enmascarar grupo 4.png') no-repeat center / cover;
