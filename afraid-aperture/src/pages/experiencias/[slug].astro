---
import Layout from '../../layouts/Layout.astro';
import { getDB } from '../../lib/db';
import { postsRepo } from '../../lib/content';
import postFallbackUrl from '../../assets/media/Grupo 66.png?url';
import postFallback2xUrl from '../../assets/media/Grupo 66@2x.png?url';

const db = getDB(Astro.locals);

const slug = Astro.params.slug ?? '';
const allPosts = await postsRepo.listAll(db);
const publishedPosts = allPosts.filter((entry) => entry.published === 1);
const post = slug ? publishedPosts.find((entry) => entry.slug === slug) : undefined;

const paragraphs = post?.content
	? post.content
			.split('\n')
			.map((line) => line.trim())
			.filter(Boolean)
	: [];
const heroParagraphs = paragraphs.slice(0, 2);
const bodyParagraphs = paragraphs.slice(2);
const relatedPosts = post
	? publishedPosts
			.filter((entry) => entry.slug !== post.slug)
			.sort(() => Math.random() - 0.5)
			.slice(0, 3)
	: [];

if (!post) {
	Astro.response.status = 404;
}
---

<Layout title={`${post ? post.title : 'Publicación no encontrada'} | Experiencias`} navTheme="light">
	<section class="post">
		<div class="post__inner">
			{post && post.published === 1 ? (
				<>
					<nav class="post__breadcrumb" aria-label="Ruta">
						<a href="/experiencias">Experiencias</a>
						<span aria-hidden="true"> / </span>
						<span>{post.title}</span>
					</nav>
					<article class="post__hero">
						<div class="post__copy">
							<header class="post__header">
								<h1 class="post__title">{post.title}</h1>
								<p class="post__subtitle">{post.excerpt}</p>
							</header>
							{heroParagraphs.length > 0 && (
								<div class="post__lead">
									{heroParagraphs.map((line) => (
										<p>{line}</p>
									))}
								</div>
							)}
						</div>
						<div class="post__media">
							<img
								class="post__image"
								src={post.image_url ?? postFallbackUrl}
								srcset={
									post.image_url ? undefined : `${postFallbackUrl} 1x, ${postFallback2xUrl} 2x`
								}
								alt={post.title}
								loading="eager"
							/>
						</div>
					</article>
					{bodyParagraphs.length > 0 && (
						<div class="post__content">
							{bodyParagraphs.map((line) => (
								<p>{line}</p>
							))}
						</div>
					)}
					{relatedPosts.length > 0 && (
						<section class="post-related" aria-labelledby="related-title">
							<h2 id="related-title" class="post-related__heading">Relacionado</h2>
							<div class="post-related__grid">
								{relatedPosts.map((related) => (
									<article class="post-related__card">
										<img
											class="post-related__image"
											src={related.image_url ?? postFallbackUrl}
											alt={related.title}
											loading="lazy"
										/>
										<div class="post-related__body">
											<h3 class="post-related__title">{related.title}</h3>
											<p class="post-related__excerpt">{related.excerpt}</p>
											<a class="post-related__link" href={`/experiencias/${related.slug}`}>Saber más</a>
										</div>
									</article>
								))}
							</div>
						</section>
					)}
				</>
			) : (
				<div class="post-empty">
					<h1 class="post-empty__title">Publicacion no encontrada</h1>
					<p class="post-empty__subtitle">La entrada que buscas no existe o no esta publicada.</p>
					<a class="post-empty__back" href="/experiencias">Volver a experiencias</a>
				</div>
			)}
		</div>
	</section>
</Layout>

<style>
	.post {
		background: #ffffff;
		padding: 110px 0 140px;
		display: flex;
		justify-content: center;
	}

	.post__inner {
		width: min(1440px, 100%);
		padding: 0 24px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		gap: 48px;
	}

	.post__breadcrumb {
		font-size: 16px;
		color: #8b8b8b;
		letter-spacing: 0.2px;
	}

	.post__breadcrumb a {
		color: inherit;
		text-decoration: none;
	}

	.post__hero {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
		gap: 64px;
		align-items: start;
	}

	.post__copy {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 620px;
	}

	.post__header {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.post__title {
		margin: 0;
		font: normal normal bold 46px/1.05 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		color: #e1454f;
	}

	.post__subtitle {
		margin: 0;
		font-size: 18px;
		font-weight: 600;
		color: #e1454f;
	}

	.post__lead {
		display: flex;
		flex-direction: column;
		gap: 12px;
		font-size: 17px;
		line-height: 28px;
		color: #5a5a5a;
	}

	.post__lead p {
		margin: 0;
	}

	.post__media {
		width: min(536px, 100%);
		justify-self: end;
	}

	.post__image {
		width: 100%;
		height: 386px;
		object-fit: cover;
		display: block;
	}

	.post__content {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 980px;
		font-size: 17px;
		line-height: 28px;
		color: #5a5a5a;
	}

	.post__content p {
		margin: 0;
	}

	.post-related {
		display: flex;
		flex-direction: column;
		gap: 26px;
	}

	.post-related__heading {
		margin: 0;
		font: normal normal bold 28px/1.2 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		color: #161615;
	}

	.post-related__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 30px;
	}

	.post-related__card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 16px 30px rgba(0, 0, 0, 0.12);
		display: flex;
		flex-direction: column;
		overflow: hidden;
	}

	.post-related__image {
		width: 100%;
		height: 190px;
		object-fit: cover;
		display: block;
	}

	.post-related__body {
		padding: 18px 22px 24px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.post-related__title {
		margin: 0;
		font: normal normal bold 20px/1.2 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		color: #e1454f;
	}

	.post-related__excerpt {
		margin: 0;
		font-size: 15px;
		line-height: 23px;
		color: #2b2b2b;
	}

	.post-related__link {
		margin-top: 4px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		align-self: flex-start;
		min-width: 160px;
		height: 42px;
		border: 2px solid #8b5a2b;
		text-decoration: none;
		font-weight: 700;
		letter-spacing: 0.2px;
		color: #8b5a2b;
		transition: transform 0.25s ease, background-color 0.25s ease;
	}

	.post-related__link:hover,
	.post-related__link:focus-visible {
		transform: translateY(-2px);
		background: rgba(139, 90, 43, 0.08);
	}

	.post-empty {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		box-shadow: 0 18px 40px rgba(0, 0, 0, 0.12);
		padding: 40px 46px 52px;
		display: flex;
		flex-direction: column;
		gap: 16px;
		align-items: flex-start;
	}

	.post-empty__title {
		margin: 0;
		font: normal normal bold 40px/1.1 'Graduate', Campton, 'Montserrat', 'Arial', sans-serif;
		color: #161615;
	}

	.post-empty__subtitle {
		margin: 0;
		font-size: 18px;
		color: #5a5a5a;
	}

	.post-empty__back {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 12px 18px;
		border: 2px solid #161615;
		text-decoration: none;
		font-weight: 700;
		color: #161615;
		margin-top: 8px;
	}

	@media (max-width: 1200px) {
		.post {
			padding: 96px 0 120px;
		}

		.post__hero {
			gap: 40px;
		}

		.post__title {
			font-size: 40px;
		}

		.post__image {
			height: 330px;
		}

		.post-related__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 900px) {
		.post {
			padding: 84px 0 110px;
		}

		.post__hero {
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.post__copy {
			max-width: 100%;
		}

		.post__media {
			width: 100%;
			justify-self: start;
		}

		.post__image {
			height: 280px;
		}
	}

	@media (max-width: 768px) {
		.post__inner {
			gap: 40px;
		}

		.post__title {
			font-size: 34px;
		}

		.post__subtitle {
			font-size: 17px;
		}

		.post__content {
			font-size: 16px;
		}

		.post-related__grid {
			grid-template-columns: 1fr;
		}

		.post-related__image {
			height: 210px;
		}
	}
</style>
